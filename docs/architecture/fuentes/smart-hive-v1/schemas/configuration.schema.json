{
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sample_seconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 86400
    },
    "cloud_enabled": {
      "type": "boolean"
    },
    "product": {
      "type": "string",
      "maxLength": 160
    },
    "host_poweroff": {
      "type": "boolean"
    },
    "audio_enabled": {
      "type": "boolean"
    },
    "battery_gain": {
      "type": "number",
      "minimum": 1.8,
      "maximum": 2.2
    },
    "adc_reference_mv": {
      "type": "integer",
      "minimum": 3100,
      "maximum": 3500
    },
    "battery_warn_mv": {
      "type": "integer",
      "minimum": 3300,
      "maximum": 4100
    },
    "battery_stop_mv": {
      "type": "integer",
      "minimum": 3100,
      "maximum": 3600
    },
    "max_queue_per_wake": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "hardware": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "firmware": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "calibration": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "offset": {
              "type": "number"
            },
            "counts_per_kg": {
              "type": "number"
            },
            "residual_kg": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "offset",
            "counts_per_kg"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "epoch"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "config.py additionally validates threshold ordering, nonzero scale and required ProductUID in cloud mode."
}
