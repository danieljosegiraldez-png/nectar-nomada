  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nectar-nomada:hive:observation:1",
  "title": "Smart Hive Node observation v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "time_quality": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "ts": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "ts": {
            "type": "integer"
          }
        }
      }
    }
  ]
