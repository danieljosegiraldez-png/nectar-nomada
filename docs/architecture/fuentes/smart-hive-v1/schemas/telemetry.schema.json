{
  "type": "object",
  "properties": {
    "schema": {
      "const": "nn.hive.observation/1"
    },
    "device_id": {
      "type": "string",
      "pattern": "^rp2040-[0-9a-f]{16}$"
    },
    "epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
