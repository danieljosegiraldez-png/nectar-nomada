# Copy to .env and fill in. See SETUP.md for the full local dev workflow.

# Neon by default (DECISIONS.md ADR-022) — paste the pooled connection
# string from your Neon project. Real Postgres, so no shadow-database or
# extension limitations (unlike the local sandbox below).
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Optional fallback for offline/disposable local work: `npx prisma dev` in
# another terminal, paste the URL it prints into DATABASE_URL above instead,
# and also set this — its own shadow-database auto-provisioning doesn't work
# against its local PGlite instance (DECISIONS.md ADR-021). Not needed with
# Neon, which provisions its own shadow database correctly.
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Auth.js (next-auth, DECISIONS.md ADR-006) — generate with
# `openssl rand -base64 32`. Do NOT run `npx auth secret`: that command
# resolves to an unrelated npm package (Better Auth's CLI) and prints
# BETTER_AUTH_SECRET, which this codebase never reads.
AUTH_SECRET="replace-with-a-real-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional). Leave blank to run with the credentials provider only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set to "true" only for local seeding — never in a shared/production environment.
SEED_DEMO_ADMIN="false"

# Stripe (test mode) — DECISIONS.md ADR-025. Get these from
# dashboard.stripe.com/test/apikeys (secret key) and, for local webhook
# delivery, `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (that command prints a `whsec_...` signing secret for WEBHOOK_SECRET).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudflare R2 (object storage, DECISIONS.md ADR-003/ADR-029) — Slice 5
# (Partner Workspace) media uploads. Create a bucket + API token at
# dash.cloudflare.com → R2. R2_ACCOUNT_ID is your Cloudflare account ID
# (shown on the R2 overview page); the access key ID/secret come from a new
# R2 API token scoped to that bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Slice 7 (AI) — connection string for the restricted `ai_service` Postgres
# role created by prisma/migrations/*_slice7_ai (INSERT+SELECT on
# ai.recommendation only, nothing else — AI_GOVERNANCE.md §3). Unlike the
# credentials above, this isn't a third-party account: after running
# migrations, set the role's password yourself and build the URL — see
# SETUP.md's "Slice 7 (AI)" section for the exact command.
AI_SERVICE_DATABASE_URL="postgresql://ai_service:<password>@<host>/<db>?sslmode=require"
