# Copy to .env and fill in. See SETUP.md for the full local dev workflow.

# Neon by default (DECISIONS.md ADR-022) — paste the pooled connection
# string from your Neon project. Real Postgres, so no shadow-database or
# extension limitations (unlike the local sandbox below).
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Optional fallback for offline/disposable local work: `npx prisma dev` in
# another terminal, paste the URL it prints into DATABASE_URL above instead,
# and also set this — its own shadow-database auto-provisioning doesn't work
# against its local PGlite instance (DECISIONS.md ADR-021). Not needed with
# Neon, which provisions its own shadow database correctly.
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Auth.js (next-auth, DECISIONS.md ADR-006) — generate with
# `openssl rand -base64 32`. Do NOT run `npx auth secret`: that command
# resolves to an unrelated npm package (Better Auth's CLI) and prints
# BETTER_AUTH_SECRET, which this codebase never reads.
AUTH_SECRET="replace-with-a-real-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional). Leave blank to run with the credentials provider only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set to "true" only for local seeding — never in a shared/production environment.
SEED_DEMO_ADMIN="false"
