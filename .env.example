# Copy to .env and fill in. See SETUP.md for the full local dev workflow.

# Local dev: run `npx prisma dev` (bundled Prisma Postgres) and paste the TCP
# URL it prints. Production: a Neon connection string (DECISIONS.md ADR-007).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-real-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional). Leave blank to run with the credentials provider only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set to "true" only for local seeding — never in a shared/production environment.
SEED_DEMO_ADMIN="false"
