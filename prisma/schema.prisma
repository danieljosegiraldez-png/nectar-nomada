// Néctar Nómada — Prisma schema, Slice 1 (Identity)
// Implements docs/architecture/DOMAIN_MODEL.md §1-2 and docs/architecture/RBAC.md §2.
// One module-owned Postgres schema per vertical slice, added as each is built — see
// the `schemas` array below for what's actually live, and
// docs/architecture/DATA_ARCHITECTURE.md §1 for the convention (the
// environmental schema is still correctly absent; that module isn't built yet.
// RO1, docs/implementation/34_RO1_RESEARCH_OS.md, adds "research").

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  schemas    = ["core", "commerce", "experiences", "partner", "sensory", "ai", "competitions", "traceability", "apiary", "research"]
  // DECISIONS.md ADR-021/ADR-022 — deferred against the local PGlite sandbox
  // (no extension support), enabled now that Neon is the primary database.
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Identity: Person vs. UserAccount — see DOMAIN_MODEL.md §1.
// No role field exists on either. Roles are always the result of an Assignment.
// ---------------------------------------------------------------------------

enum PersonStatus {
  active
  archived

  @@schema("core")
}

/// A way an account proves who it is, held by an external provider — ADR-075.
///
/// Authority hangs off UserAccount: Assignments, and therefore every
/// permission, belong to the account. So a Person keeps exactly one account
/// (person_id is unique), otherwise someone's roles would differ depending on
/// how they signed in. What was missing was anywhere to record a *second* way
/// of proving identity for that one account — Google sign-in tried to solve it
/// by creating a second UserAccount and hit that unique constraint.
///
/// Credentials are deliberately not modelled here: a password is a property of
/// the account (`passwordHash`), not a link to another system.
model ExternalIdentity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId String   @map("user_account_id") @db.Uuid
  /// 'google' today. One row per provider per account.
  provider      String
  /// The provider's own stable id for this person. Never an email — an email
  /// can change hands, a subject cannot.
  subject       String
  createdAt     DateTime @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  /// The lookup sign-in performs, and the guarantee that one external identity
  /// cannot be claimed by two accounts.
  @@unique([provider, subject])
  /// One Google account per UserAccount — linking a second would make "which
  /// Google account signs me in" ambiguous.
  @@unique([userAccountId, provider])
  @@map("external_identity")
  @@schema("core")
}

model Person {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  givenName             String       @map("given_name")
  familyName            String       @map("family_name")
  displayName           String       @map("display_name")
  // Unique, because `authorize()` resolves an account by
  // `person: { email }` with findFirst — two People sharing an address would
  // make *which* of them signs in arbitrary (ADR-072). The application already
  // checked for a duplicate before insert, but that is a race-prone
  // application-level check, not a guarantee. NULL is still allowed and
  // Postgres treats NULLs as distinct, so the many People without an address
  // are unaffected. Both signUpSchema and loginSchema `.toLowerCase()`, so
  // case-variant duplicates cannot arise through the app.
  email                 String?      @unique
  phone                 String?
  locale                String       @default("es")
  bio                   String?
  status                PersonStatus @default(active)
  // BEVERAGE_SENSORY_PROTOCOLS.md §7.3 — array of {certifying_body,
  // certification_name, level_or_rank, date_earned, expiry_date?,
  // certificate_reference}. Extends CLAUDE.md §9's Expertise/Certifications
  // fields with real structure; empty/absent unless explicitly supplied —
  // never inferred (CLAUDE.md §54).
  sensoryCertifications Json?        @map("sensory_certifications")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  createdBy             String?      @map("created_by") @db.Uuid
  creator               UserAccount? @relation("PersonCreatedBy", fields: [createdBy], references: [id])

  userAccount                        UserAccount?
  projectsAsClient                   Project[]
  storiesAuthored                    Story[]
  assetsCaptured                     Asset[]                       @relation("AssetCreatorPerson")
  competitionEntries                 Entry[]
  selfCreatedStandardsCreated        SelfCreatedStandardDetail[]
  calibrationSessionsConducted       CalibrationSession[]
  calibrationResults                 CalibrationResult[]
  sensitivityProfiles                EvaluatorSensitivityProfile[]
  lotTransformationsOperated         LotTransformation[]
  measurementsOperated               Measurement[]
  harvestEventsOperated              HarvestEvent[]                @relation("HarvestEventOperator")
  receivingEventsOperated            ReceivingEvent[]              @relation("ReceivingEventOperator")
  fermentationRunsOperated           FermentationRun[]             @relation("FermentationRunOperator")
  dryingTurnEventsOperated           DryingTurnEvent[]             @relation("DryingTurnEventOperator")
  roastSessionsRoasted               RoastSession[]                @relation("RoastSessionRoaster")
  labourEntriesOperated              LabourEntry[]                 @relation("LabourEntryOperator")
  materialConsumptionEntriesOperated MaterialConsumptionEntry[]    @relation("MaterialConsumptionEntryOperator")
  inspectionsOperated                Inspection[]                  @relation("InspectionOperator")
  colonyEventsOperated               ColonyEvent[]                 @relation("ColonyEventOperator")
  apiaryHarvestEventsOperated        ApiaryHarvestEvent[]          @relation("ApiaryHarvestEventOperator")
  organizationMemberships            OrganizationMembership[]
  plantingEventsOperated             PlantingEvent[]               @relation("PlantingEventOperator")
  specimenObservationsObserved       SpecimenObservation[]         @relation("SpecimenObservationObserver")
  treatmentBatchesOperated           TreatmentBatch[]              @relation("TreatmentBatchOperator")
  processSensoryObservationsObserved ProcessSensoryObservation[]   @relation("ProcessSensoryObservationObserver")
  fieldSessionsOperated              FieldSession[]                @relation("FieldSessionOperator")
  fieldEventsOperated                FieldEvent[]                  @relation("FieldEventOperator")

  @@map("person")
  @@schema("core")
}

enum UserAccountStatus {
  active
  invited
  suspended
  deactivated

  @@schema("core")
}

model UserAccount {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId        String            @unique @map("person_id") @db.Uuid
  person          Person            @relation(fields: [personId], references: [id])
  // How this account was originally created — 'credentials' today for every
  // account. External providers are recorded in ExternalIdentity instead
  // (ADR-075), because one account may prove identity in several ways.
  authProvider    String            @map("auth_provider")
  // Argon2id hash (SECURITY.md §1). Null for OAuth-only accounts.
  passwordHash    String?           @map("password_hash")
  emailVerifiedAt DateTime?         @map("email_verified_at")
  lastLoginAt     DateTime?         @map("last_login_at")
  status          UserAccountStatus @default(invited)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  createdBy       String?           @map("created_by") @db.Uuid
  creator         UserAccount?      @relation("UserAccountCreatedBy", fields: [createdBy], references: [id])

  externalIdentities                ExternalIdentity[]
  createdAccounts                   UserAccount[]                @relation("UserAccountCreatedBy")
  personsCreated                    Person[]                     @relation("PersonCreatedBy")
  roleProfilesCreated               RoleProfile[]                @relation("RoleProfileCreatedBy")
  scopesCreated                     Scope[]                      @relation("ScopeCreatedBy")
  assignments                       Assignment[]                 @relation("AssignmentToUserAccount")
  assignmentsGranted                Assignment[]                 @relation("AssignmentGrantedBy")
  auditEvents                       AuditEvent[]
  locationsCreated                  Location[]                   @relation("LocationCreatedBy")
  organizationsCreated              Organization[]               @relation("OrganizationCreatedBy")
  programsCreated                   Program[]                    @relation("ProgramCreatedBy")
  projectsCreated                   Project[]                    @relation("ProjectCreatedBy")
  samplesCreated                    Sample[]                     @relation("SampleCreatedBy")
  storiesCreated                    Story[]                      @relation("StoryCreatedBy")
  productsCreated                   Product[]                    @relation("ProductCreatedBy")
  experiencesCreated                Experience[]                 @relation("ExperienceCreatedBy")
  productVariantsCreated            ProductVariant[]             @relation("ProductVariantCreatedBy")
  carts                             Cart[]
  bookings                          Booking[]
  orders                            Order[]
  experienceSessionsCreated         ExperienceSession[]          @relation("ExperienceSessionCreatedBy")
  assetsCreated                     Asset[]                      @relation("AssetCreatedBy")
  tasksCreated                      Task[]                       @relation("TaskCreatedBy")
  tasksAssigned                     Task[]                       @relation("TaskAssignedTo")
  fieldSubmissions                  FieldSubmission[]            @relation("FieldSubmissionSubmittedBy")
  sensorySessionsCreated            SensorySession[]             @relation("SensorySessionCreatedBy")
  assessments                       Assessment[]                 @relation("AssessmentByEvaluator")
  recommendationsReviewed           Recommendation[]             @relation("RecommendationReviewedBy")
  competitionJudgeAssignments       CompetitionJudgeAssignment[]
  competitionResultsFinalized       CompetitionResult[]          @relation("CompetitionResultFinalizedBy")
  lotsCreated                       Lot[]                        @relation("LotCreatedBy")
  lotTransformationsCreated         LotTransformation[]          @relation("LotTransformationCreatedBy")
  quantityEventsCreated             QuantityEvent[]              @relation("QuantityEventCreatedBy")
  measurementsCreated               Measurement[]                @relation("MeasurementCreatedBy")
  harvestEventsCreated              HarvestEvent[]               @relation("HarvestEventCreatedBy")
  receivingEventsCreated            ReceivingEvent[]             @relation("ReceivingEventCreatedBy")
  fermentationRunsCreated           FermentationRun[]            @relation("FermentationRunCreatedBy")
  fermentationInterventionsCreated  FermentationIntervention[]   @relation("FermentationInterventionCreatedBy")
  dryingRunsCreated                 DryingRun[]                  @relation("DryingRunCreatedBy")
  roastSessionsCreated              RoastSession[]               @relation("RoastSessionCreatedBy")
  // P2 (ADR-098)
  processRecipesCreated             ProcessRecipe[]              @relation("ProcessRecipeCreatedBy")
  processRecipeVersionsCreated      ProcessRecipeVersion[]       @relation("ProcessRecipeVersionCreatedBy")
  dryingTurnEventsCreated           DryingTurnEvent[]            @relation("DryingTurnEventCreatedBy")
  storageAssignmentsCreated         StorageAssignment[]          @relation("StorageAssignmentCreatedBy")
  labourEntriesCreated              LabourEntry[]                @relation("LabourEntryCreatedBy")
  materialConsumptionEntriesCreated MaterialConsumptionEntry[]   @relation("MaterialConsumptionEntryCreatedBy")
  hivesCreated                      Hive[]                       @relation("HiveCreatedBy")
  coloniesCreated                   Colony[]                     @relation("ColonyCreatedBy")
  inspectionsCreated                Inspection[]                 @relation("InspectionCreatedBy")
  apiaryHarvestEventsCreated        ApiaryHarvestEvent[]         @relation("ApiaryHarvestEventCreatedBy")
  colonyEventsCreated               ColonyEvent[]                @relation("ColonyEventCreatedBy")
  organizationMembershipsCreated    OrganizationMembership[]     @relation("OrganizationMembershipCreatedBy")
  plantingEventsCreated             PlantingEvent[]              @relation("PlantingEventCreatedBy")
  plantingCohortsCreated            PlantingCohort[]             @relation("PlantingCohortCreatedBy")
  biocharBatchesCreated             BiocharBatch[]               @relation("BiocharBatchCreatedBy")
  soilProfilesCreated               SoilProfile[]                @relation("SoilProfileCreatedBy")
  soilSamplesCreated                SoilSample[]                 @relation("SoilSampleCreatedBy")
  foliarSamplesCreated              FoliarSample[]               @relation("FoliarSampleCreatedBy")
  fieldSessionsCreated              FieldSession[]               @relation("FieldSessionCreatedBy")
  fieldEventsCreated                FieldEvent[]                 @relation("FieldEventCreatedBy")
  harvestEventSourcesCreated        HarvestEventSource[]         @relation("HarvestEventSourceCreatedBy")
  specimensCreated                  Specimen[]                   @relation("SpecimenCreatedBy")
  specimenObservationsCreated       SpecimenObservation[]        @relation("SpecimenObservationCreatedBy")
  externalCoffeeOriginsCreated      ExternalCoffeeOrigin[]       @relation("ExternalCoffeeOriginCreatedBy")

  // RO1 (docs/implementation/34_RO1_RESEARCH_OS.md) — one CreatedBy back-
  // relation per new Research OS entity, same convention as every block
  // above.
  researchProgramsCreated            ResearchProgram[]            @relation("ResearchProgramCreatedBy")
  researchQuestionsCreated           ResearchQuestion[]           @relation("ResearchQuestionCreatedBy")
  hypothesesCreated                  Hypothesis[]                 @relation("HypothesisCreatedBy")
  experimentsCreated                 Experiment[]                 @relation("ExperimentCreatedBy")
  protocolsCreated                   Protocol[]                   @relation("ProtocolCreatedBy")
  protocolVersionsCreated            ProtocolVersion[]            @relation("ProtocolVersionCreatedBy")
  treatmentBatchesCreated            TreatmentBatch[]             @relation("TreatmentBatchCreatedBy")
  processingStagesCreated            ProcessingStage[]            @relation("ProcessingStageCreatedBy")
  processingStageObservationsCreated ProcessingStageObservation[] @relation("ProcessingStageObservationCreatedBy")
  processSensoryObservationsCreated  ProcessSensoryObservation[]  @relation("ProcessSensoryObservationCreatedBy")
  evidenceCreated                    Evidence[]                   @relation("EvidenceCreatedBy")
  evidenceClaimsCreated              EvidenceClaim[]              @relation("EvidenceClaimCreatedBy")
  interpretationsCreated             Interpretation[]             @relation("InterpretationCreatedBy")
  conclusionsCreated                 Conclusion[]                 @relation("ConclusionCreatedBy")
  researchRecommendationsCreated     ResearchRecommendation[]     @relation("ResearchRecommendationCreatedBy")
  analysisPlansCreated               AnalysisPlan[]               @relation("AnalysisPlanCreatedBy")
  analysisRunsCreated                AnalysisRun[]                @relation("AnalysisRunCreatedBy")
  analysisResultsCreated             AnalysisResult[]             @relation("AnalysisResultCreatedBy")
  publicationsCreated                Publication[]                @relation("PublicationCreatedBy")
  deviationsCreated                  Deviation[]                  @relation("DeviationCreatedBy")
  correctiveActionsCreated           CorrectiveAction[]           @relation("CorrectiveActionCreatedBy")
  approvalsDecided                   Approval[]                   @relation("ApprovalApprover")
  researchActivitiesProposed         ResearchActivity[]           @relation("ResearchActivityProposedBy")
  researchActivitiesReviewed         ResearchActivity[]           @relation("ResearchActivityReviewedBy")
  researchActivitiesCreated          ResearchActivity[]           @relation("ResearchActivityCreatedBy")

  @@map("user_account")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// RBAC chain — see RBAC.md §2-4.
// User → Assignment → Scope → Role Profile → Permission.
// Scope containment (platform/program/project vs. leaf scopes) is resolved in
// application code (lib/rbac/resolve.ts), not enforced by the database schema.
// ---------------------------------------------------------------------------

enum ScopeType {
  platform
  program
  project
  location
  competition
  session
  experience

  @@schema("core")
}

model Scope {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scopeType  ScopeType    @map("scope_type")
  // Null when scopeType = platform. FK to program/project/location/... is not
  // enforced at the DB level yet because those tables don't exist until later
  // slices — validated at the application layer per RBAC.md §2.
  scopeRefId String?      @map("scope_ref_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  createdBy  String?      @map("created_by") @db.Uuid
  creator    UserAccount? @relation("ScopeCreatedBy", fields: [createdBy], references: [id])

  assignments Assignment[]

  @@unique([scopeType, scopeRefId])
  @@map("scope")
  @@schema("core")
}

enum RoleProfileStatus {
  active
  archived

  @@schema("core")
}

model RoleProfile {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @unique
  description String?
  status      RoleProfileStatus @default(active)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  createdBy   String?           @map("created_by") @db.Uuid
  creator     UserAccount?      @relation("RoleProfileCreatedBy", fields: [createdBy], references: [id])

  permissions RoleProfilePermission[]
  assignments Assignment[]

  @@map("role_profile")
  @@schema("core")
}

// Permission is a seed-managed catalog (migrated via prisma/seed.ts,
// RBAC.md §5), not user-editable data — no lifecycle columns needed.
model Permission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceType String   @map("resource_type")
  action       String
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  roleProfiles RoleProfilePermission[]

  @@unique([resourceType, action])
  @@map("permission")
  @@schema("core")
}

model RoleProfilePermission {
  roleProfileId String   @map("role_profile_id") @db.Uuid
  permissionId  String   @map("permission_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  roleProfile RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)
  permission  Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleProfileId, permissionId])
  @@map("role_profile_permission")
  @@schema("core")
}

enum AssignmentStatus {
  active
  revoked
  expired

  @@schema("core")
}

model Assignment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId String           @map("user_account_id") @db.Uuid
  userAccount   UserAccount      @relation("AssignmentToUserAccount", fields: [userAccountId], references: [id])
  roleProfileId String           @map("role_profile_id") @db.Uuid
  roleProfile   RoleProfile      @relation(fields: [roleProfileId], references: [id])
  scopeId       String           @map("scope_id") @db.Uuid
  scope         Scope            @relation(fields: [scopeId], references: [id])
  grantedBy     String?          @map("granted_by") @db.Uuid
  granter       UserAccount?     @relation("AssignmentGrantedBy", fields: [grantedBy], references: [id])
  grantedAt     DateTime         @default(now()) @map("granted_at")
  validFrom     DateTime         @default(now()) @map("valid_from")
  validTo       DateTime?        @map("valid_to")
  status        AssignmentStatus @default(active)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([userAccountId, status])
  @@map("assignment")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// Audit — SECURITY.md §6. Append-only: no application role gets UPDATE/DELETE
// on this table (enforced at the database-role level when provisioning
// production credentials, not by Prisma). No status/updatedAt columns because
// rows are never modified after insert.
// ---------------------------------------------------------------------------

model AuditEvent {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserAccountId String?      @map("actor_user_account_id") @db.Uuid
  actor              UserAccount? @relation(fields: [actorUserAccountId], references: [id])
  occurredAt         DateTime     @default(now()) @map("occurred_at")
  operation          String
  entityType         String       @map("entity_type")
  entityId           String       @map("entity_id") @db.Uuid
  before             Json?
  after              Json?
  reason             String?
  sourceInterface    String       @map("source_interface")

  @@index([entityType, entityId])
  @@index([actorUserAccountId])
  @@map("audit_event")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// Foundational canonical entities — DOMAIN_MODEL.md §3, DECISIONS.md
// ADR-017/018/019/020 (all four point at this as the shared prerequisite).
// ---------------------------------------------------------------------------

// DATA_ARCHITECTURE.md §7 — generic record lifecycle, shared by every
// canonical/content entity below. Identity/RBAC tables (Person, UserAccount,
// RoleProfile, Assignment) keep their own bespoke status enums, unchanged,
// since their lifecycle genuinely differs from a content record's.
enum RecordStatus {
  draft
  incomplete
  pending_review
  verified
  approved
  archived
  rejected

  @@schema("core")
}

// RBAC.md §6 — sensitive-record classification, an axis independent of and
// checked alongside RBAC permission resolution (lib/rbac/resolve.ts's
// `can()` already accepts this as a parameter — see RBAC.md §4 step 4).
// This is the first slice where any table actually carries the column.
// Defaults to `internal`, not `public` — a record must be explicitly
// reclassified to appear on a public surface, never public by omission.
enum ClassificationLevel {
  public
  registered
  partner
  internal
  confidential
  trade_secret

  @@schema("core")
}

enum LocationType {
  country
  province
  district
  locality
  site
  // Farm/block granularity (execution plan §7) — a Plot is a Location with
  // locationType = plot and parentLocationId pointing at the farm's own
  // site-typed row, not a new entity family.
  plot
  // A1 (22_APIARY_V1_SCOPING_REPORT.md §2) — an Apiary is not a new table,
  // it's a place holding hives, the same relationship a farm has to its
  // plots. parentLocationId points at the property/farm site-typed row,
  // same shape as `plot`. Distinct from OrganizationType.apiary (an
  // organization that operates an apiary business) — different tables,
  // different enums, deliberately not conflated (§2's own naming flag).
  apiary_site

  @@schema("core")
}

// F1 (30_F1_OPERACION_FINCA_ESQUEMA.md §1) — fixed values given directly by
// the product owner; free text lives alongside these in Location.description
// and Location.slopeDescription/soilType, never instead of them.
enum SunExposure {
  full_sun
  morning
  afternoon
  both

  @@schema("core")
}

enum ShadePercentageBracket {
  pct_20
  pct_30
  pct_50
  pct_70
  pct_90

  @@schema("core")
}

// S1 (45_S1_SUELO_AMBIENTE_TAZA.md §2) — la orientación de la ladera, que el
// marco de investigación pide junto a pendiente y sombra para elegir bloques
// que abarquen la variación real del terreno (Paso 3, §14.1).
//
// Enumerado, a diferencia de `slopeDescription`/`soilType`, que son texto
// libre justamente porque nadie dio una lista de valores. Aquí la lista no se
// inventa: es la rosa de los vientos. Y el uso es **comparativo** — «cuatro
// bloques que abarquen orientaciones distintas» sólo se puede responder si el
// valor agrupa, cosa que «hacia el este» y «E» y «este-noreste» no hacen.
// `flat` y `variable` existen para que el terreno que no tiene una orientación
// única no se vea forzado a declarar una: un lote plano y un lote que mira a
// tres lados son hechos distintos, y ninguno es `north`.
enum Aspect {
  north
  northeast
  east
  southeast
  south
  southwest
  west
  northwest
  // Sin pendiente apreciable: no tiene orientación, y decir que la tiene sería
  // inventarla.
  flat
  // Varias orientaciones dentro del mismo bloque. Es la señal de que el bloque
  // quizá deba subdividirse (F1 §2), no un valor que haya que limpiar.
  variable

  @@schema("core")
}

// F1 §2 — the reason a microlot was subdivided, recorded on the *child*
// Location (the microlot itself), not the parent. Only meaningful when
// parentLocationId is set; nullable everywhere else, same as every other
// F1 attribute. `other` always pairs with subdivisionReasonNote — the
// "typed value + free note" rule (§1) applies here too.
enum SubdivisionReason {
  altitude
  shade
  slope
  other

  @@schema("core")
}

model Location {
  id               String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationType     LocationType                           @map("location_type")
  parentLocationId String?                                @map("parent_location_id") @db.Uuid
  parentLocation   Location?                              @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations   Location[]                             @relation("LocationHierarchy")
  organizationId   String?                                @map("organization_id") @db.Uuid
  organization     Organization?                          @relation(fields: [organizationId], references: [id])
  name             String
  // Public URL slug (Slice 2, Discover module) — nullable because most
  // Locations (country/province/district rows in the hierarchy) never get
  // their own public page; only ones a Discover page links to need one.
  slug             String?                                @unique
  latitude         Float?
  longitude        Float?
  // PostGIS point, kept in sync with latitude/longitude at the application
  // layer. Not exposed through Prisma's typed query API — spatial queries
  // (ST_DWithin/ST_Intersects, EXTERNAL_DATA_ARCHITECTURE.md §9) use
  // $queryRaw until a real spatial-query need justifies more than that.
  geoPoint         Unsupported("geography(Point, 4326)")? @map("geo_point")
  timezone         String?
  status           RecordStatus                           @default(draft)
  classification   ClassificationLevel                    @default(internal)

  // F1 (30_F1_OPERACION_FINCA_ESQUEMA.md §1) — stable terroir attributes,
  // all nullable (existing Locations don't have them). `altitudeMinM`/
  // `altitudeMaxM` replace the old single-value `altitudeMeters` (removed;
  // confirmed unpopulated on every live row before dropping it) — A7 hit
  // this directly: Finca Las Nubes Jaramillo is 1300-1500m, and the range
  // *within* one Location is precisely what later justifies subdividing it
  // into a microlot (§2). Rainfall deliberately does NOT live here — it's
  // a daily measurement (`EnvironmentalObservation`, specified §6, not
  // built), not a stable attribute; freezing it here would misrepresent
  // something that varies as something that doesn't.
  sunExposure        SunExposure?            @map("sun_exposure")
  shadePercentage    ShadePercentageBracket? @map("shade_percentage")
  altitudeMinM       Int?                    @map("altitude_min_m")
  altitudeMaxM       Int?                    @map("altitude_max_m")
  // No fixed value list was given for slope or soil type (unlike sun
  // exposure/shade, both enumerated directly by the product owner) — free
  // text rather than inventing a controlled vocabulary nobody asked for.
  slopeDescription   String?                 @map("slope_description")
  // S1 §2 — orientación de la ladera. Va aquí, pegada a la pendiente, porque
  // es la otra mitad del mismo hecho: una pendiente sin orientación no dice
  // cuánto sol ni cuánta lluvia recibe la ladera. Hasta ahora se colaba dentro
  // de `slopeDescription` como prosa ("moderate, east-facing"), donde ninguna
  // consulta la podía agrupar.
  aspect             Aspect?                 @map("aspect")
  soilType           String?                 @map("soil_type")
  plantSpacingMeters Decimal?                @map("plant_spacing_meters") @db.Decimal(5, 2)
  // P1 §3 — F1 added sun, shade, altitude range, slope, soil and spacing but
  // no area, so planted area, yield per hectare and cultivar distribution by
  // area could not be computed at all. Deliberately NOT derived from a
  // boundary polygon: none exists (geoPoint is referenced by zero lines of
  // application code), and a producer knows their block's hectares long
  // before anyone walks its perimeter with GPS. When polygons arrive this
  // becomes the declared value to reconcile the computed one against.
  areaHectares       Decimal?                @map("area_hectares") @db.Decimal(10, 4)
  // General free-text catch-all (§1's "regla que no debe romperse": a
  // typed value list always needs a place for what doesn't fit it) — A7's
  // Catuaí age and the apiary-to-well/fence distance had nowhere to live
  // but a loading script's comments before this field existed.
  description        String?

  // F1 §2 — only meaningful when parentLocationId is set (this Location
  // *is* a microlot). Nullable everywhere else, same as every attribute
  // above.
  subdivisionReason     SubdivisionReason? @map("subdivision_reason")
  subdivisionReasonNote String?            @map("subdivision_reason_note")

  // RO1 (34_RO1_RESEARCH_OS.md §3a) — same F1 attribute pattern as sun
  // exposure above, only meaningful for a drying-room Location. "El nivel
  // por sí solo no dice cuánta luz recibe — depende de en qué cuarto está.
  // El cuarto solar tiene 3 niveles con luz; el cuarto oscuro tiene 6
  // niveles y ninguna luz." A ProcessingStage's "nivel de cama"
  // ProtocolVariable value is only interpretable paired with these two
  // fields on the room it ran in (via ProcessingStage.locationId).
  dryingRoomLightExposure DryingRoomLightExposure? @map("drying_room_light_exposure")
  dryingRoomBedLevelCount Int?                     @map("drying_room_bed_level_count")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("LocationCreatedBy", fields: [createdBy], references: [id])

  projectsWithPrimaryLocation Project[]                  @relation("ProjectPrimaryLocation")
  samples                     Sample[]
  stories                     Story[]
  products                    Product[]
  experiences                 Experience[]
  assets                      Asset[]
  lots                        Lot[]
  harvestEvents               HarvestEvent[]
  receivingEvents             ReceivingEvent[]
  dryingRuns                  DryingRun[]
  storageAssignments          StorageAssignment[]
  hives                       Hive[]
  specimens                   Specimen[]
  plantingEvents              PlantingEvent[]
  plantingCohorts             PlantingCohort[]
  fieldSessions               FieldSession[]
  harvestEventSources         HarvestEventSource[]
  // S1 — lotes de biochar producidos AQUÍ, que no es donde se aplican.
  biocharBatchesProduced      BiocharBatch[]               @relation("BiocharBatchProducedAt")
  soilProfiles                SoilProfile[]
  soilSamples                 SoilSample[]
  foliarSamples               FoliarSample[]
  labourEntries               LabourEntry[]
  materialConsumptionEntries  MaterialConsumptionEntry[]
  processingStages            ProcessingStage[]

  @@index([parentLocationId])
  @@index([organizationId])
  @@map("location")
  @@schema("core")
}

enum DryingRoomLightExposure {
  with_light
  without_light

  @@schema("core")
}

// DOMAIN_MODEL.md §3 — one table, typed via organizationType, not one table
// per type. Type-specific fields live in `attributes`, validated per type
// at the application layer (DATA_ARCHITECTURE.md §3) — not built yet, since
// no service/UI writes to this table until Slice 2.
enum OrganizationType {
  farm
  estate
  producer
  roaster
  brewery
  winery
  distillery
  apiary
  laboratory
  restaurant
  venue
  association
  university
  supplier
  tour_operator
  nectar_nomada_partner

  @@schema("core")
}

model Organization {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationType OrganizationType    @map("organization_type")
  name             String
  description      String?
  // Contact details (ADR-073). CLAUDE.md §9 models Organizations as canonical
  // entities — a farm, a roaster, a laboratory — and reaching one is a fact
  // about it, so it belongs here rather than being carried by whichever Person
  // happens to be a member.
  //
  // Deliberately NOT unique, unlike Person.email: an Organization never
  // authenticates, so there is no lookup whose answer a duplicate could make
  // ambiguous, and two organizations sharing an owner's address is ordinary.
  //
  // Classification already governs whether these are visible — an `internal`
  // Organization does not publish its phone number just because the column
  // exists.
  contactEmail     String?             @map("contact_email")
  contactPhone     String?             @map("contact_phone")
  websiteUrl       String?             @map("website_url")
  attributes       Json?
  // P0 (41_P0_MASS_BALANCE.md §4) — how far a transformation may fail to
  // reconcile before it raises a Deviation, as a percentage of input mass.
  // A real column rather than a key inside `attributes`: that field is
  // documented as type-specific data validated at the application layer,
  // and a value load-bearing for a data invariant should not be reachable
  // only through an unvalidated blob. NULL falls back to
  // DEFAULT_MASS_BALANCE_TOLERANCE_PCT (lib/traceability/balance.ts) — a
  // farm that has never thought about tolerance still gets one.
  massBalanceTolerancePct Decimal?     @map("mass_balance_tolerance_pct") @db.Decimal(5, 2)
  status           RecordStatus        @default(draft)
  classification   ClassificationLevel @default(internal)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  createdBy        String?             @map("created_by") @db.Uuid
  creator          UserAccount?        @relation("OrganizationCreatedBy", fields: [createdBy], references: [id])

  locations                        Location[]
  // P2 (ADR-098) — recipes belong to the farm that runs them.
  processRecipes                   ProcessRecipe[]
  projectsOwned                    Project[]                @relation("ProjectOrganization")
  projectsAsClient                 Project[]                @relation("ProjectClientOrganization")
  samples                          Sample[]
  stories                          Story[]
  products                         Product[]
  experiences                      Experience[]
  competitionEntries               Entry[]
  referenceStandardsSupplied       ReferenceStandard[]
  lots                             Lot[]
  harvestEvents                    HarvestEvent[]
  biocharBatches                   BiocharBatch[]
  receivingEvents                  ReceivingEvent[]
  labourEntriesProvided            LabourEntry[]
  memberships                      OrganizationMembership[]
  plantingEventsSourced            PlantingEvent[]
  externalCoffeeOriginsAsProducer  ExternalCoffeeOrigin[]   @relation("ExternalCoffeeProducer")
  externalCoffeeOriginsAsProcessor ExternalCoffeeOrigin[]   @relation("ExternalCoffeeProcessor")
  externalCoffeeOriginsAsBrand     ExternalCoffeeOrigin[]   @relation("ExternalCoffeeBrand")

  @@map("organization")
  @@schema("core")
}

enum MembershipStatus {
  active
  ended

  @@schema("core")
}

// A7 (docs/implementation/22_APIARY_V1_SCOPING_REPORT.md) — implements the
// shape DOMAIN_MODEL.md §2 already specified but this codebase never
// built: descriptive metadata only (what to call this person in this
// context), grants no platform permission by itself. A separate,
// explicit Assignment is what grants access — the two are correlated in
// practice but never the same mechanism (DOMAIN_MODEL.md §2's own example:
// a producer can lose Partner Workspace access while remaining listed as
// the farm's owner).
model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId       String           @map("person_id") @db.Uuid
  person         Person           @relation(fields: [personId], references: [id])
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id])
  title          String?
  startedAt      DateTime         @default(now()) @map("started_at")
  endedAt        DateTime?        @map("ended_at")
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at")
  createdBy      String?          @map("created_by") @db.Uuid
  creator        UserAccount?     @relation("OrganizationMembershipCreatedBy", fields: [createdBy], references: [id])

  @@index([personId])
  @@index([organizationId])
  @@map("organization_membership")
  @@schema("core")
}

// DOMAIN_MODEL.md §3 — optional parent grouping above Project. Exists
// primarily so RBAC.md's `program` ScopeType has a real table to point at;
// kept minimal until a concrete need for richer Program fields appears.
model Program {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(draft)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdBy   String?      @map("created_by") @db.Uuid
  creator     UserAccount? @relation("ProgramCreatedBy", fields: [createdBy], references: [id])

  projects Project[]

  @@map("program")
  @@schema("core")
}

// CLAUDE.md §18 — the domain-tag vocabulary is explicitly open-ended
// ("possible future extension should not require redesign"), so this is a
// seeded reference table + join, not a closed enum that would need a
// migration every time a new domain (e.g. cacao, apiculture) is added.
model DomainTag {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique
  name String

  projects ProjectDomainTagAssignment[]

  @@map("domain_tag")
  @@schema("core")
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId String?  @map("program_id") @db.Uuid
  program   Program? @relation(fields: [programId], references: [id])

  // Owning/partner organization running this project — distinct from a
  // consulting client below (COMMERCE_OPERATIONS_TOOLS_ARCHITECTURE.md §O).
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation("ProjectOrganization", fields: [organizationId], references: [id])

  // Consulting client (ADR-020 item 4) — nullable, set only for
  // domain_tag = 'consulting' engagements. Not a new CRM entity; the
  // "client" relationship is exactly these two nullable FKs.
  clientOrganizationId String?       @map("client_organization_id") @db.Uuid
  clientOrganization   Organization? @relation("ProjectClientOrganization", fields: [clientOrganizationId], references: [id])
  clientPersonId       String?       @map("client_person_id") @db.Uuid
  clientPerson         Person?       @relation(fields: [clientPersonId], references: [id])

  primaryLocationId String?   @map("primary_location_id") @db.Uuid
  primaryLocation   Location? @relation("ProjectPrimaryLocation", fields: [primaryLocationId], references: [id])

  name           String
  // Public URL slug (Slice 2, Discover module) — nullable: an internal-only
  // project never needs one until/unless it's published.
  slug           String?             @unique
  description    String?
  status         RecordStatus        @default(draft)
  classification ClassificationLevel @default(internal)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by") @db.Uuid
  creator        UserAccount?        @relation("ProjectCreatedBy", fields: [createdBy], references: [id])

  domainTags  ProjectDomainTagAssignment[]
  samples     Sample[]
  stories     Story[]
  products    Product[]
  experiences Experience[]
  assets      Asset[]

  // Slice 5 (Partner Workspace) — module-owned, `partner` schema.
  tasks            Task[]
  fieldSubmissions FieldSubmission[]

  // Phase 1 — module-owned, `traceability` schema.
  lots            Lot[]
  harvestEvents   HarvestEvent[]
  receivingEvents ReceivingEvent[]

  // A1 (22_APIARY_V1_SCOPING_REPORT.md) — module-owned, `apiary` schema.
  hives Hive[]

  // RO1 (34_RO1_RESEARCH_OS.md) — module-owned, `research` schema.
  // Denormalized directly on Experiment/TreatmentBatch (not only reachable
  // via Protocol/ProtocolVersion) for the same RBAC-resolution reason as
  // Lot/Sample's own direct projectId.
  experiments      Experiment[]
  treatmentBatches TreatmentBatch[]

  @@index([programId])
  @@index([organizationId])
  @@index([clientOrganizationId])
  @@index([primaryLocationId])
  @@map("project")
  @@schema("core")
}

model ProjectDomainTagAssignment {
  projectId   String @map("project_id") @db.Uuid
  domainTagId String @map("domain_tag_id") @db.Uuid

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domainTag DomainTag @relation(fields: [domainTagId], references: [id], onDelete: Cascade)

  @@id([projectId, domainTagId])
  @@map("project_domain_tag")
  @@schema("core")
}

// DOMAIN_MODEL.md §3 — referenced by Research OS/Sensory/Competitions/
// Traceability, none of which exist yet, so this stays intentionally thin.
// `sampleType` is a free-text field, not an enum — COMMERCE_OPERATIONS_
// TOOLS_ARCHITECTURE.md §19's sample-type list is domain-specific and will
// be constrained (if at all) once a real consuming module exists.
model Sample {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // P0 (41_P0_MASS_BALANCE.md §7): scoped per organization, same reasoning
  // as Lot.lotCode. Unlike Lot, `organizationId` stays **nullable** here —
  // a Sample legitimately may have no organization (the S1 external-coffee
  // path: a green sample handed over at a fair, no lineage, an
  // ExternalCoffeeOrigin instead). Postgres treats NULLs as distinct, so
  // the composite unique below behaves as a partial index: two org-less
  // samples could share a code, which is a smaller problem than forcing an
  // organization onto a sample that genuinely has none.
  sampleCode String @map("sample_code")
  sampleType     String              @map("sample_type")
  description    String?
  projectId      String?             @map("project_id") @db.Uuid
  project        Project?            @relation(fields: [projectId], references: [id])
  organizationId String?             @map("organization_id") @db.Uuid
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  locationId     String?             @map("location_id") @db.Uuid
  location       Location?           @relation(fields: [locationId], references: [id])
  status         RecordStatus        @default(draft)
  classification ClassificationLevel @default(internal)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by") @db.Uuid
  creator        UserAccount?        @relation("SampleCreatedBy", fields: [createdBy], references: [id])

  // Phase 1, T5 (docs/implementation/PHASE_1_TECHNICAL_EXECUTION_PLAN.md
  // §18) — additive, nullable. Existing Sample rows (seeded for Sensory/
  // Competitions demo content) stay valid with NULL lineage: they predate
  // the Lot model and genuinely have no lot to point at, correctly
  // `missing`, never backfilled with a guess. A sample extracted from a
  // Lot is always paired with the sourceTransformationId
  // (transformationType "sample_extraction") that produced it — its
  // "output" is this Sample row, not a second Lot row.
  sourceLotId            String?            @map("source_lot_id") @db.Uuid
  sourceLot              Lot?               @relation(fields: [sourceLotId], references: [id])
  sourceTransformationId String?            @map("source_transformation_id") @db.Uuid
  sourceTransformation   LotTransformation? @relation(fields: [sourceTransformationId], references: [id])

  blindMappings      SensoryBlindMapping[]
  competitionEntries Entry[]
  measurements       Measurement[]
  assets             Asset[]

  // S1 (docs/implementation/32_S1_CAFES_EXTERNOS.md) — present exactly
  // when sourceLotId is null and this Sample's origin is a third-party
  // declaration rather than this platform's own traceability chain. The
  // two are mutually exclusive in practice (a Lot-sourced sample already
  // has real lineage; nothing here re-derives it), but not enforced as an
  // XOR constraint at the DB level — see ExternalCoffeeOrigin's own
  // comment for why.
  externalOrigin ExternalCoffeeOrigin?

  // RO1 — a tasted/analyzed Sample used as Research OS evidence (§2: "Sample
  // es canónico y ya llega a Sensory... no necesita mecanismo nuevo").
  researchEvidence Evidence[]

  @@unique([organizationId, sampleCode])
  @@index([projectId])
  @@index([organizationId])
  @@index([locationId])
  @@index([sourceLotId])
  @@index([sourceTransformationId])
  @@map("sample")
  @@schema("core")
}

// S1 (docs/implementation/32_S1_CAFES_EXTERNOS.md). A coffee that arrives
// already cupped-worthy with no Lot behind it — a client's sample, a
// competitor's entry, a green sample someone hands you at a fair. Producer,
// processor, and brand are three genuinely different organizations (§1's
// worked example: Agustín Gómez's Geisha, processed at Cafelino's
// beneficio, presented under Néctar Nómada's own brand) and none of the
// three implies the others.
//
// Not limited to third-party coffee — §1's own text: "es el modelo correcto
// para cualquier café donde producción y procesamiento se separan." A
// Lot-backed Sample could theoretically also carry one of these if that
// need arises later; today only the Lot-less path populates it, since
// that's the actual gap this ticket closes.
enum HarvestWindowPrecision {
  year
  month
  date

  @@schema("core")
}

model ExternalCoffeeOrigin {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sampleId String @unique @map("sample_id") @db.Uuid
  sample   Sample @relation(fields: [sampleId], references: [id])

  // §1 — all three nullable; "todos nulables salvo lo mínimo que
  // identifique el café" is enforced in the service layer (at least one
  // of the three must be given), not here — a DB-level CHECK across three
  // nullable FKs adds little and the service layer is where every other
  // "at least one of" rule in this codebase already lives (e.g.
  // Specimen's sectorSimple/gridRow, deliberately NOT enforced as an XOR
  // either).
  producerOrganizationId  String?       @map("producer_organization_id") @db.Uuid
  producerOrganization    Organization? @relation("ExternalCoffeeProducer", fields: [producerOrganizationId], references: [id])
  processorOrganizationId String?       @map("processor_organization_id") @db.Uuid
  processorOrganization   Organization? @relation("ExternalCoffeeProcessor", fields: [processorOrganizationId], references: [id])
  brandOrganizationId     String?       @map("brand_organization_id") @db.Uuid
  brandOrganization       Organization? @relation("ExternalCoffeeBrand", fields: [brandOrganizationId], references: [id])

  // §2 — one declaration-class for the whole bundle (manufacturer_
  // specification or interpretation, chosen at the action layer per
  // ADR-038's pattern — required, no default). dataQuality is per field
  // below instead, since reliability genuinely differs fact by fact (the
  // ticket's own calibration note: farm is usually solid, process
  // sometimes reliable, varietal is what most often comes in wrong) —
  // collapsing that into one record-level dataQuality would hide exactly
  // the distinction §2 asks to preserve.
  declaredProvenanceClass ProvenanceClass @map("declared_provenance_class")
  sourceReference         String?         @map("source_reference")

  // §6 — each declared fact carries its own "when did we learn this"
  // timestamp, not a full version history. Recommendation (see the S1
  // draft ADR's §6 section for the full reasoning): row-versioning is
  // machinery built for approved-document supersession with downstream
  // pinned references (ProtocolVersion, CompetitionResult) — nothing
  // points at "this ExternalCoffeeOrigin as of version N," so that
  // machinery would be pure overhead here. A per-fact knownAt column
  // answers the one question §6 actually asks — completing a record later
  // must not look like it was known from the start — without building a
  // parallel versioning system this entity doesn't need.
  declaredVarietal    String?      @map("declared_varietal")
  varietalDataQuality DataQuality? @map("varietal_data_quality")
  varietalKnownAt     DateTime?    @map("varietal_known_at")

  declaredProcess    String?      @map("declared_process")
  processDataQuality DataQuality? @map("process_data_quality")
  processKnownAt     DateTime?    @map("process_known_at")

  // §4 — variable precision, never a fabricated day. harvestWindowPrecision
  // is the authoritative field: year is populated whenever precision is
  // year/month/date, month only when month/date, day only when date. The
  // service layer enforces this shape; nothing here silently invents a
  // day out of "cosecha 2025."
  harvestWindowPrecision   HarvestWindowPrecision? @map("harvest_window_precision")
  harvestYear              Int?                    @map("harvest_year")
  harvestMonth             Int?                    @map("harvest_month")
  harvestDay               Int?                    @map("harvest_day")
  harvestWindowDataQuality DataQuality?            @map("harvest_window_data_quality")
  harvestWindowKnownAt     DateTime?               @map("harvest_window_known_at")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("ExternalCoffeeOriginCreatedBy", fields: [createdBy], references: [id])

  @@index([producerOrganizationId])
  @@index([processorOrganizationId])
  @@index([brandOrganizationId])
  @@map("external_coffee_origin")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// Slice 2 — Public Discovery (MVP_ROADMAP.md, read-only paths). Story,
// Product, and Experience are the canonical entities DOMAIN_MODEL.md already
// named; only their public-display shape is built here. Deliberately thin:
// - No StoryBlock/composition system yet (ADAPTIVE_INTELLIGENCE_EXPERIENCE_
//   REVIEW.md's own Foundational recommendation) — a single markdown body is
//   enough to validate the Discover architecture end-to-end; block-based
//   composition is real future work, not needed to ship a readable page.
// - No MediaAsset/object-storage pipeline yet — that's its own scoped pass
//   (DATA_ARCHITECTURE.md §5, ADAPTIVE_INTELLIGENCE_EXPERIENCE_REVIEW.md).
//   These pages are text/data-first for now, not photo-first.
// - No ProductVariant/SKU/Cart/Order (Slice 3) or ExperienceSession/Booking
//   (Slice 4) — Product and Experience here are browsable catalog entries
//   only, matching "read paths only, no booking/purchase yet."
// ---------------------------------------------------------------------------

model Story {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String              @unique
  title          String
  summary        String?
  bodyMarkdown   String?             @map("body_markdown")
  projectId      String?             @map("project_id") @db.Uuid
  project        Project?            @relation(fields: [projectId], references: [id])
  locationId     String?             @map("location_id") @db.Uuid
  location       Location?           @relation(fields: [locationId], references: [id])
  organizationId String?             @map("organization_id") @db.Uuid
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  authorPersonId String?             @map("author_person_id") @db.Uuid
  authorPerson   Person?             @relation(fields: [authorPersonId], references: [id])
  status         RecordStatus        @default(draft)
  classification ClassificationLevel @default(internal)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by") @db.Uuid
  creator        UserAccount?        @relation("StoryCreatedBy", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([locationId])
  @@index([organizationId])
  @@map("story")
  @@schema("core")
}

model Product {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String              @unique
  name           String
  summary        String?
  description    String?
  projectId      String?             @map("project_id") @db.Uuid
  project        Project?            @relation(fields: [projectId], references: [id])
  locationId     String?             @map("location_id") @db.Uuid
  location       Location?           @relation(fields: [locationId], references: [id])
  organizationId String?             @map("organization_id") @db.Uuid
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  status         RecordStatus        @default(draft)
  classification ClassificationLevel @default(internal)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by") @db.Uuid
  creator        UserAccount?        @relation("ProductCreatedBy", fields: [createdBy], references: [id])

  // Slice 3 (Commerce) — a Product is a catalog listing; ProductVariant is
  // the actual sellable/priced/inventoried unit (DOMAIN_MODEL.md Commerce
  // module: "Product → ProductVariant → SKU/Inventory/Price"). Display
  // price is computed from active variants, not stored on Product itself.
  variants           ProductVariant[]
  // Set when this catalog listing is also a sensory reference-standard kit
  // (BEVERAGE_SENSORY_PROTOCOLS.md §7.1) — one record, two roles.
  referenceStandards ReferenceStandard[]

  @@index([projectId])
  @@index([locationId])
  @@index([organizationId])
  @@map("product")
  @@schema("core")
}

model Experience {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String              @unique
  name            String
  summary         String?
  description     String?
  // Same reasoning as Product.priceAmount — never fabricated in seed data.
  priceAmount     Decimal?            @map("price_amount") @db.Decimal(10, 2)
  priceCurrency   String?             @map("price_currency")
  durationMinutes Int?                @map("duration_minutes")
  projectId       String?             @map("project_id") @db.Uuid
  project         Project?            @relation(fields: [projectId], references: [id])
  locationId      String?             @map("location_id") @db.Uuid
  location        Location?           @relation(fields: [locationId], references: [id])
  organizationId  String?             @map("organization_id") @db.Uuid
  organization    Organization?       @relation(fields: [organizationId], references: [id])
  status          RecordStatus        @default(draft)
  classification  ClassificationLevel @default(internal)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  createdBy       String?             @map("created_by") @db.Uuid
  creator         UserAccount?        @relation("ExperienceCreatedBy", fields: [createdBy], references: [id])

  // Slice 4 (Experiences & Reservations) — an Experience is the catalog
  // listing; ExperienceSession is the actual scheduled, bookable occurrence
  // (DOMAIN_MODEL.md: "Experience → ExperienceSession → Booking →
  // Participant"), same split as Product → ProductVariant in Slice 3.
  sessions ExperienceSession[]

  @@index([projectId])
  @@index([locationId])
  @@index([organizationId])
  @@map("experience")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// Slice 3 — Commerce (MVP_ROADMAP.md). First module in its own Postgres
// schema (`commerce`), per DATA_ARCHITECTURE.md §1's module-schema
// convention — Product itself stays in `core` (it's a canonical entity
// Discover already reads), everything sellable/transactional extends it
// from here.
// ---------------------------------------------------------------------------

enum ProductVariantStatus {
  active
  archived

  @@schema("commerce")
}

// The actual sellable/priced/inventoried unit. A Product needs at least one
// active Variant to be purchasable — Discover's Product pages already
// handle zero variants gracefully (still just a catalog listing).
model ProductVariant {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String               @unique
  // Null = the product's only/default variant (no size/weight options).
  variantName    String?              @map("variant_name")
  priceAmount    Decimal              @map("price_amount") @db.Decimal(10, 2)
  priceCurrency  String               @default("USD") @map("price_currency")
  // Null = not inventory-tracked (e.g. made-to-order); otherwise decremented
  // on paid Order creation (lib/commerce/orders.ts).
  inventoryCount Int?                 @map("inventory_count")
  status         ProductVariantStatus @default(active)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  createdBy      String?              @map("created_by") @db.Uuid
  creator        UserAccount?         @relation("ProductVariantCreatedBy", fields: [createdBy], references: [id])

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variant")
  @@schema("commerce")
}

enum CartStatus {
  active
  converted
  abandoned

  @@schema("commerce")
}

// One UserAccount can accumulate multiple Cart rows over time (one per
// converted/abandoned cycle) but should have at most one `active` cart at
// once — enforced in lib/commerce/cart.ts (find-or-create), not a DB
// constraint, since "at most one" per status value isn't expressible as a
// simple unique index without excluding the other statuses.
model Cart {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId String      @map("user_account_id") @db.Uuid
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id])
  status        CartStatus  @default(active)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items CartItem[]

  @@index([userAccountId, status])
  @@map("cart")
  @@schema("commerce")
}

model CartItem {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId           String         @map("cart_id") @db.Uuid
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String         @map("product_variant_id") @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([cartId, productVariantId])
  @@map("cart_item")
  @@schema("commerce")
}

enum OrderStatus {
  pending_payment
  paid
  fulfilled
  cancelled
  refunded

  @@schema("commerce")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Human-friendly, distinct from `id` — generated in lib/commerce/orders.ts,
  // not a DB sequence (keeps order-number formatting an application concern).
  orderNumber    String      @unique @map("order_number")
  userAccountId  String      @map("user_account_id") @db.Uuid
  userAccount    UserAccount @relation(fields: [userAccountId], references: [id])
  status         OrderStatus @default(pending_payment)
  subtotalAmount Decimal     @map("subtotal_amount") @db.Decimal(10, 2)
  currency       String      @default("USD")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  items    OrderItem[]
  payments Payment[]

  @@index([userAccountId])
  @@map("order")
  @@schema("commerce")
}

// unitPriceAmount/currency are a snapshot at purchase time, not a live
// lookup through productVariant — the same "preserve what actually
// happened" principle already governing Protocol execution and lot
// genealogy elsewhere in this schema, applied to price history. A later
// ProductVariant price change must never alter a historical Order's total.
model OrderItem {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String         @map("product_variant_id") @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPriceAmount  Decimal        @map("unit_price_amount") @db.Decimal(10, 2)
  currency         String

  @@index([orderId])
  @@map("order_item")
  @@schema("commerce")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded

  @@schema("commerce")
}

// One Order can have more than one Payment row over its life (a failed
// attempt followed by a successful retry) — Payment is an append-only
// attempt log, Order.status is the derived current state.
model Payment {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                 String        @map("order_id") @db.Uuid
  order                   Order         @relation(fields: [orderId], references: [id])
  provider                String        @default("stripe")
  providerSessionId       String?       @unique @map("provider_session_id")
  providerPaymentIntentId String?       @unique @map("provider_payment_intent_id")
  amount                  Decimal       @db.Decimal(10, 2)
  currency                String
  status                  PaymentStatus @default(pending)
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payment")
  @@schema("commerce")
}

// ---------------------------------------------------------------------------
// Slice 4 — Experiences & Reservations (MVP_ROADMAP.md). Second module-owned
// schema (`experiences`), same convention as Commerce — Experience itself
// stays in `core` (Discover already reads it as a catalog listing);
// everything scheduled/bookable extends it from here. Distinct booking
// engine per CLAUDE.md §12, not a Commerce SKU hack: capacity lives on the
// Session, not an inventory count, and a Booking can carry multiple named
// Participants.
// ---------------------------------------------------------------------------

enum ExperienceSessionStatus {
  scheduled
  cancelled
  completed

  @@schema("experiences")
}

// The actual scheduled, bookable occurrence of an Experience. An Experience
// needs at least one scheduled Session to be bookable — Discover's
// Experience pages already handle zero sessions gracefully (still just a
// catalog listing), same pattern as a Product with zero ProductVariants.
model ExperienceSession {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId      String                  @map("experience_id") @db.Uuid
  experience        Experience              @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  startAt           DateTime                @map("start_at")
  endAt             DateTime?               @map("end_at")
  // Null = not capacity-tracked; otherwise decremented by confirmed
  // Bookings' participantCount on paid Booking creation
  // (lib/experiences/bookings.ts).
  capacityTotal     Int?                    @map("capacity_total")
  capacityRemaining Int?                    @map("capacity_remaining")
  status            ExperienceSessionStatus @default(scheduled)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  createdBy         String?                 @map("created_by") @db.Uuid
  creator           UserAccount?            @relation("ExperienceSessionCreatedBy", fields: [createdBy], references: [id])

  bookings Booking[]

  @@index([experienceId])
  @@map("experience_session")
  @@schema("experiences")
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  refunded

  @@schema("experiences")
}

model Booking {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Human-friendly, distinct from `id` — generated in
  // lib/experiences/bookings.ts, same pattern as Order.orderNumber.
  bookingNumber       String            @unique @map("booking_number")
  experienceSessionId String            @map("experience_session_id") @db.Uuid
  experienceSession   ExperienceSession @relation(fields: [experienceSessionId], references: [id])
  userAccountId       String            @map("user_account_id") @db.Uuid
  userAccount         UserAccount       @relation(fields: [userAccountId], references: [id])
  status              BookingStatus     @default(pending_payment)
  participantCount    Int               @default(1) @map("participant_count")
  // Snapshot at booking time, not a live lookup through Experience — the
  // same provenance principle as OrderItem.unitPriceAmount (ADR-025 decision
  // 4): a later Experience price change must never rewrite a past Booking.
  unitPriceAmount     Decimal           @map("unit_price_amount") @db.Decimal(10, 2)
  currency            String            @default("USD")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  participants Participant[]
  payments     BookingPayment[]

  @@index([userAccountId])
  @@index([experienceSessionId])
  @@map("booking")
  @@schema("experiences")
}

model Participant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName  String   @map("full_name")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("participant")
  @@schema("experiences")
}

enum BookingPaymentStatus {
  pending
  succeeded
  failed
  refunded

  @@schema("experiences")
}

// Mirrors commerce.Payment exactly (same append-only attempt-log shape,
// reusing the same PaymentsProvider adapter — INTEGRATIONS.md's
// adapter-per-capability pattern means one Stripe integration serves both
// Commerce and Experiences, not a duplicated one per module) — a distinct
// model *and* a distinct status enum rather than a shared one, since it FKs
// to Booking, not Order, and every module schema so far defines its own
// enums even where identical in shape (e.g. ProductVariantStatus vs.
// ExperienceSessionStatus), not shared cross-schema.
model BookingPayment {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId               String               @map("booking_id") @db.Uuid
  booking                 Booking              @relation(fields: [bookingId], references: [id])
  provider                String               @default("stripe")
  providerSessionId       String?              @unique @map("provider_session_id")
  providerPaymentIntentId String?              @unique @map("provider_payment_intent_id")
  amount                  Decimal              @db.Decimal(10, 2)
  currency                String
  status                  BookingPaymentStatus @default(pending)
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  @@index([bookingId])
  @@map("booking_payment")
  @@schema("experiences")
}

// ---------------------------------------------------------------------------
// Slice 5 — Partner Workspace (MVP_ROADMAP.md). `Asset` is canonical
// (DOMAIN_MODEL.md §3, DATA_ARCHITECTURE.md §5) so it lives in `core`, same
// as Product/Experience — metadata only, the binary lives in R2
// (DECISIONS.md ADR-003) referenced by `storageKey`. `Task`/`FieldSubmission`
// are module-owned in a new `partner` schema, same convention as
// `commerce`/`experiences`. Per DOMAIN_MODEL.md §4, "Partner Workspace" is
// not a separate data model — it's a role-aware view over Assignment
// (scope=project), Task, and Asset uploads; there is no `PartnerWorkspace`
// table.
// ---------------------------------------------------------------------------

enum AssetStatus {
  draft
  approved
  archived

  @@schema("core")
}

// Metadata only — DATA_ARCHITECTURE.md §5 forbids binaries in Postgres.
// `derivativeOfAssetId` points at the original when this row is a generated
// thumbnail/preview; scientific/evidence originals are never overwritten,
// only superseded by a new row (same version-preservation principle as
// everywhere else — PLATFORM_OVERVIEW.md §3).
model Asset {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetType        String              @map("asset_type")
  storageKey       String              @unique @map("storage_key")
  storageBucket    String              @map("storage_bucket")
  checksumSha256   String?             @map("checksum_sha256")
  mimeType         String              @map("mime_type")
  sizeBytes        Int                 @map("size_bytes")
  originalFilename String?             @map("original_filename")
  creatorPersonId  String?             @map("creator_person_id") @db.Uuid
  creatorPerson    Person?             @relation("AssetCreatorPerson", fields: [creatorPersonId], references: [id])
  capturedAt       DateTime?           @map("captured_at")
  locationId       String?             @map("location_id") @db.Uuid
  location         Location?           @relation(fields: [locationId], references: [id])
  projectId        String?             @map("project_id") @db.Uuid
  project          Project?            @relation(fields: [projectId], references: [id])
  usageRights      String?             @map("usage_rights")
  status           AssetStatus         @default(draft)
  classification   ClassificationLevel @default(internal)

  derivativeOfAssetId String? @map("derivative_of_asset_id") @db.Uuid
  derivativeOf        Asset?  @relation("AssetDerivative", fields: [derivativeOfAssetId], references: [id])
  derivatives         Asset[] @relation("AssetDerivative")

  // T12.5: specific nullable FKs per possible Traceability parent, not a
  // polymorphic parent_type/parent_id pair (ADR-020 decision 8,
  // Measurement's own precedent). Receiving has no dedicated FK — a
  // receiving-stage photo attaches via lotId, the lot ReceivingEvent
  // itself creates; every other stage gets its own column because the
  // event/run/sample it documents is more specific than "this lot."
  lotId             String?          @map("lot_id") @db.Uuid
  lot               Lot?             @relation(fields: [lotId], references: [id])
  harvestEventId    String?          @map("harvest_event_id") @db.Uuid
  harvestEvent      HarvestEvent?    @relation(fields: [harvestEventId], references: [id])
  measurementId     String?          @map("measurement_id") @db.Uuid
  measurement       Measurement?     @relation(fields: [measurementId], references: [id])
  fermentationRunId String?          @map("fermentation_run_id") @db.Uuid
  fermentationRun   FermentationRun? @relation(fields: [fermentationRunId], references: [id])
  dryingRunId       String?          @map("drying_run_id") @db.Uuid
  dryingRun         DryingRun?       @relation(fields: [dryingRunId], references: [id])
  sampleId          String?          @map("sample_id") @db.Uuid
  sample            Sample?          @relation(fields: [sampleId], references: [id])
  // S1 (45_S1_SUELO_AMBIENTE_TAZA.md §2) — los dos sitios donde el marco pide
  // fotografía explícitamente: el Paso 2 «fotografiar el retorte y el proceso»
  // y el Paso 4 «fotografiar cada perfil con una escala».
  //
  // NO se añade una FK para las muestras de suelo y foliares: el marco no pide
  // fotos de ellas, y una columna que nada escribe es peso muerto que además
  // parece una capacidad que el sistema no tiene. Una foto general de un bloque
  // ya cabe en `locationId`, que existe desde el principio.
  biocharBatchId    String?          @map("biochar_batch_id") @db.Uuid
  biocharBatch      BiocharBatch?    @relation(fields: [biocharBatchId], references: [id])
  soilProfileId     String?          @map("soil_profile_id") @db.Uuid
  soilProfile       SoilProfile?     @relation(fields: [soilProfileId], references: [id])

  // A6 (22_APIARY_V1_SCOPING_REPORT.md — Photo attachment): same "specific
  // nullable FK per parent, not polymorphic" convention as the six
  // Traceability FKs above (ADR-020 decision 8). A honeyBatchId is
  // unintentionally unnecessary — a HoneyBatch is a Lot (§2), so the
  // existing lotId FK above already covers it; that reuse is the whole
  // point of A3's design.
  hiveId        String?      @map("hive_id") @db.Uuid
  hive          Hive?        @relation(fields: [hiveId], references: [id])
  colonyId      String?      @map("colony_id") @db.Uuid
  colony        Colony?      @relation(fields: [colonyId], references: [id])
  inspectionId  String?      @map("inspection_id") @db.Uuid
  inspection    Inspection?  @relation(fields: [inspectionId], references: [id])
  colonyEventId String?      @map("colony_event_id") @db.Uuid
  colonyEvent   ColonyEvent? @relation(fields: [colonyEventId], references: [id])

  // F1 (30_F1_OPERACION_FINCA_ESQUEMA.md) — same nullable-FK-per-parent
  // convention as every attachment point above.
  specimenId String?   @map("specimen_id") @db.Uuid
  specimen   Specimen? @relation(fields: [specimenId], references: [id])

  // RO1 (34_RO1_RESEARCH_OS.md §2) — same nullable-FK-per-parent convention:
  // "las fotos de un protocolo se adjuntan igual."
  treatmentBatchId  String?          @map("treatment_batch_id") @db.Uuid
  treatmentBatch    TreatmentBatch?  @relation(fields: [treatmentBatchId], references: [id])
  processingStageId String?          @map("processing_stage_id") @db.Uuid
  processingStage   ProcessingStage? @relation(fields: [processingStageId], references: [id])

  // T12.5: required, no default — same reasoning as ADR-038 (T9.5): a
  // photograph is a fact-bearing record, and a silent default would
  // misrepresent an unstated provenance as the strongest class in the
  // vocabulary. sourceReference/dataQuality follow DATA_ARCHITECTURE.md §4.
  provenanceClass ProvenanceClass @map("provenance_class")
  sourceReference String?         @map("source_reference")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("AssetCreatedBy", fields: [createdBy], references: [id])

  fieldSubmissions FieldSubmissionAsset[]
  evidence         Evidence[]
  fieldEvents      FieldEvent[]

  @@index([projectId])
  @@index([locationId])
  @@index([lotId])
  @@index([harvestEventId])
  @@index([measurementId])
  @@index([fermentationRunId])
  @@index([dryingRunId])
  @@index([sampleId])
  @@index([hiveId])
  @@index([colonyId])
  @@index([inspectionId])
  @@index([colonyEventId])
  @@index([specimenId])
  @@index([treatmentBatchId])
  @@index([processingStageId])
  @@index([biocharBatchId])
  @@index([soilProfileId])
  @@map("asset")
  @@schema("core")
}

enum TaskStatus {
  open
  in_progress
  submitted
  completed
  blocked

  @@schema("partner")
}

model Task {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?

  // Nullable — a Task can sit open for any partner assigned to the project,
  // not necessarily pre-assigned to one specific person.
  assignedToUserAccountId String?      @map("assigned_to_user_account_id") @db.Uuid
  assignedTo              UserAccount? @relation("TaskAssignedTo", fields: [assignedToUserAccountId], references: [id])

  dueDate DateTime?  @map("due_date")
  status  TaskStatus @default(open)

  // CLAUDE.md §10 classification axis, independent of the project-scoped
  // partner:* permission grant — MVP_ROADMAP.md's stated purpose for this
  // slice ("first slice where the classification axis meaningfully
  // restricts a non-admin, non-researcher user's view"). A Task above what
  // a partner's Assignment clears is invisible to them even on their own
  // assigned project.
  classification ClassificationLevel @default(internal)

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("TaskCreatedBy", fields: [createdBy], references: [id])

  submissions   FieldSubmission[]
  fieldSessions FieldSession[]

  @@index([projectId])
  @@index([assignedToUserAccountId])
  @@map("task")
  @@schema("partner")
}

// A partner's field data entry (CLAUDE.md §4's "Operational forms / Data
// entry / Documentation") — deliberately generic free text for this slice,
// not a module-specific form (research measurements, environmental
// observations), since Research OS and Environmental modules don't exist
// yet (DOMAIN_MODEL.md §4's own note that Partner Workspace's submission
// forms are module-specific once those modules land).
model FieldSubmission {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String? @map("task_id") @db.Uuid
  task      Task?   @relation(fields: [taskId], references: [id])

  submittedByUserAccountId String      @map("submitted_by_user_account_id") @db.Uuid
  submittedBy              UserAccount @relation("FieldSubmissionSubmittedBy", fields: [submittedByUserAccountId], references: [id])

  title String
  notes String

  classification ClassificationLevel @default(internal)

  createdAt DateTime @default(now()) @map("created_at")

  assets FieldSubmissionAsset[]

  @@index([projectId])
  @@index([taskId])
  @@map("field_submission")
  @@schema("partner")
}

model FieldSubmissionAsset {
  fieldSubmissionId String          @map("field_submission_id") @db.Uuid
  fieldSubmission   FieldSubmission @relation(fields: [fieldSubmissionId], references: [id], onDelete: Cascade)
  assetId           String          @map("asset_id") @db.Uuid
  asset             Asset           @relation(fields: [assetId], references: [id])

  @@id([fieldSubmissionId, assetId])
  @@map("field_submission_asset")
  @@schema("partner")
}

// ---------------------------------------------------------------------------
// Slice 6 — Sensory Evaluation (MVP_ROADMAP.md). CLAUDE.md §21: configurable
// Evaluation Protocols, never one universal form — SensoryProtocol/Version is
// the same versioned-protocol shape used elsewhere in this project's
// planning docs. Blind-identity restriction implements RBAC.md §7 literally:
// SensoryBlindMapping is its own table, gated by a dedicated
// blind_mapping:view permission the Sensory Judge profile does not hold — a
// Judge's resolved permissions genuinely cannot query it, not merely hidden
// from the screen they're shown. `core.Sample` (Foundational schema) is
// reused as-is as the canonical real-identity target.
// ---------------------------------------------------------------------------

enum SensoryProtocolStatus {
  active
  archived
  // BEVERAGE_SENSORY_PROTOCOLS.md §4 — a recognized evaluation category the
  // platform is designed to support, with no real attribute content built
  // yet. Distinct from `archived` (was active, now retired) — this was
  // never active in the first place.
  planned

  @@schema("sensory")
}

enum SensoryProtocolLicenseStatus {
  adapted_original
  licensed
  pending_license

  @@schema("sensory")
}

enum SensoryPurpose {
  // S2 §2a. What an evaluation is FOR. Five, and genuinely distinct — the
  // session format and deliberation mode are consequences of the purpose,
  // not independent axes, so they are not modelled separately.
  rank // score against a standard in order to rank — competition judge
  verify_conformance // check against a specification: passes or does not — QC
  characterize // describe what is there and how the process expressed — process panel
  select // decide between options for an end — green buyer
  hedonic // liking. CONSUMER_SENSORY_FEEDBACK.md / CLAUDE.md §49 already
  // forbid mixing this with technical judgement; S2 extends the
  // same logic to the other four.

  @@schema("sensory")
}

enum SensorySubject {
  // S2 §2b. Deliberately few. Alcohol content is a property of the product,
  // carbonation an attribute of process, extraction method is how a cup was
  // prepared — modelling those as subjects would grow the list without end
  // and would wrongly make two brews of the same beverage incomparable.
  raw_material_in_process // cherry, must, parchment
  intermediate_product // green, roasted, a honey batch
  prepared_beverage

  @@schema("sensory")
}

model SensoryProtocol {
  id                      String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 'coffee' | 'honey' | 'beer' | 'wine' | 'mead' | 'spirits' | 'other' — free
  // text per CLAUDE.md §21's open domain list, not a closed enum.
  domain                  String
  name                    String
  description             String?
  status                  SensoryProtocolStatus         @default(active)
  // BEVERAGE_SENSORY_PROTOCOLS.md §1/§3 — real sensory scoresheets are
  // frequently copyrighted professional standards (BJCP/SCA/WSET). Every
  // protocol must cite what it's grounded in and never claim to *be* an
  // official form unless actually licensed to do so.
  standardSourceReference String?                       @map("standard_source_reference")
  standardLicenseStatus   SensoryProtocolLicenseStatus? @map("standard_license_status")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")

  versions SensoryProtocolVersion[]

  @@map("sensory_protocol")
  @@schema("sensory")
}

enum SensoryProtocolVersionStatus {
  draft
  active
  superseded

  @@schema("sensory")
}

model SensoryProtocolVersion {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolId String                       @map("protocol_id") @db.Uuid
  protocol   SensoryProtocol              @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  version    Int
  scoreMin   Decimal                      @map("score_min") @db.Decimal(5, 2)
  scoreMax   Decimal                      @map("score_max") @db.Decimal(5, 2)
  status     SensoryProtocolVersionStatus @default(draft)
  createdAt  DateTime                     @default(now()) @map("created_at")

  supersededByVersionId String?                  @map("superseded_by_version_id") @db.Uuid
  supersededBy          SensoryProtocolVersion?  @relation("SensoryProtocolVersionSupersession", fields: [supersededByVersionId], references: [id])
  supersedes            SensoryProtocolVersion[] @relation("SensoryProtocolVersionSupersession")

  attributes            SensoryAttribute[]
  descriptors           SensoryDescriptor[]
  sessions              SensorySession[]
  competitionCategories CompetitionCategory[]

  @@unique([protocolId, version])
  @@map("sensory_protocol_version")
  @@schema("sensory")
}

model SensoryAttribute {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolVersionId String                 @map("protocol_version_id") @db.Uuid
  protocolVersion   SensoryProtocolVersion @relation(fields: [protocolVersionId], references: [id], onDelete: Cascade)
  name              String
  displayOrder      Int                    @map("display_order")
  scaleMin          Decimal                @map("scale_min") @db.Decimal(5, 2)
  scaleMax          Decimal                @map("scale_max") @db.Decimal(5, 2)
  description       String?
  // BEVERAGE_SENSORY_PROTOCOLS.md §3 — CVA's key structural innovation for
  // coffee: separating Descriptive Assessment (what it tastes like) from
  // Affective Assessment (how much the evaluator values it), rather than
  // collapsing description and preference into one score. Free text
  // ('descriptive' | 'affective'), null for protocols that don't use this
  // split (e.g. the existing single-section illustrative coffee protocol,
  // beer/mead/honey).
  section           String?

  responses    AttributeResponse[]
  panelResults PanelResult[]

  @@index([protocolVersionId])
  @@map("sensory_attribute")
  @@schema("sensory")
}

enum SensorySessionStatus {
  draft
  blind_coding
  in_progress
  completed
  locked

  @@schema("sensory")
}

model SensorySession {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  protocolVersionId String                 @map("protocol_version_id") @db.Uuid
  protocolVersion   SensoryProtocolVersion @relation(fields: [protocolVersionId], references: [id])
  scheduledAt       DateTime?              @map("scheduled_at")
  status            SensorySessionStatus   @default(draft)

  // S2 §2 — the two axes that distinguish one evaluation tool from another.
  // The third axis, role, is already RBAC's job and is deliberately not
  // modelled here.
  //
  // Nullable on purpose, and never inferred: S2 §6 forbids classifying an
  // existing evaluation automatically, because deducing what a past session
  // was FOR is exactly the interpretation provenance rules prohibit. Six
  // sessions predate this column and stay null until a human says otherwise.
  purpose           SensoryPurpose?
  subject           SensorySubject?
  // How this particular cup was prepared — espresso, filter, press. An
  // attribute of the subject, not a subject of its own (§2b), so two
  // evaluations of the same beverage prepared differently remain comparable.
  preparationMethod String?             @map("preparation_method")
  // CLAUDE.md §10 classification axis — same independent AND-gate as every
  // other module. Sensory data defaults internal (real judging results are
  // rarely public until formally released).
  classification    ClassificationLevel @default(internal)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  createdBy         String?             @map("created_by") @db.Uuid
  creator           UserAccount?        @relation("SensorySessionCreatedBy", fields: [createdBy], references: [id])

  flights               SensoryFlight[]
  competitionCategories CompetitionCategory[]

  @@index([protocolVersionId])
  @@map("sensory_session")
  @@schema("sensory")
}

model SensoryFlight {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String         @map("session_id") @db.Uuid
  session       SensorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name          String
  sequenceOrder Int            @map("sequence_order")

  blindSamples SensoryBlindSample[]

  @@index([sessionId])
  @@map("sensory_flight")
  @@schema("sensory")
}

model SensoryBlindSample {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flightId  String        @map("flight_id") @db.Uuid
  flight    SensoryFlight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  blindCode String        @map("blind_code")

  blindMapping      SensoryBlindMapping?
  assessments       Assessment[]
  panelResults      PanelResult[]
  competitionResult CompetitionResult?

  @@unique([flightId, blindCode])
  @@map("sensory_blind_sample")
  @@schema("sensory")
}

// The restricted table RBAC.md §7 describes literally — a Sensory Judge's
// resolved permissions never include blind_mapping:view, so this table is
// structurally unreachable to them, not merely unrendered by the UI.
model SensoryBlindMapping {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blindSampleId String             @unique @map("blind_sample_id") @db.Uuid
  blindSample   SensoryBlindSample @relation(fields: [blindSampleId], references: [id], onDelete: Cascade)
  sampleId      String             @map("sample_id") @db.Uuid
  sample        Sample             @relation(fields: [sampleId], references: [id])
  revealedAt    DateTime?          @map("revealed_at")

  @@map("sensory_blind_mapping")
  @@schema("sensory")
}

enum AssessmentStatus {
  submitted
  superseded

  @@schema("sensory")
}

// Immutable once submitted — CLAUDE.md §21 / DOMAIN_MODEL.md "Sensory
// Evaluation": corrections are new rows referencing the one they replace via
// supersedesAssessmentId, never an in-place update. No update path exists in
// lib/sensory/service.ts by design — AI_GOVERNANCE.md §2 explicitly forbids
// "alter submitted sensory forms," and this applies the same discipline to
// every caller, not only AI.
model Assessment {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blindSampleId          String             @map("blind_sample_id") @db.Uuid
  blindSample            SensoryBlindSample @relation(fields: [blindSampleId], references: [id], onDelete: Cascade)
  evaluatorUserAccountId String             @map("evaluator_user_account_id") @db.Uuid
  evaluator              UserAccount        @relation("AssessmentByEvaluator", fields: [evaluatorUserAccountId], references: [id])
  overallScore           Decimal?           @map("overall_score") @db.Decimal(5, 2)
  comment                String?
  status                 AssessmentStatus   @default(submitted)
  submittedAt            DateTime           @default(now()) @map("submitted_at")

  supersedesAssessmentId String?     @unique @map("supersedes_assessment_id") @db.Uuid
  supersedes             Assessment? @relation("AssessmentSupersession", fields: [supersedesAssessmentId], references: [id])
  supersededBy           Assessment? @relation("AssessmentSupersession")

  attributeResponses  AttributeResponse[]
  descriptorResponses SensoryDescriptorResponse[]

  // No correction workflow exists yet (DECISIONS.md ADR-030 decision 5) —
  // until one does, there must never be more than one Assessment row per
  // (blindSample, evaluator) at all, full stop. This is the DB-level
  // backstop for that: submitAssessment's own existence check is a
  // check-then-create race (two concurrent requests could both pass the
  // check), so the real guarantee has to live here. When a correction
  // workflow is eventually built, this constraint needs revisiting —
  // likely a partial unique index scoped to status = 'submitted' instead.
  @@unique([blindSampleId, evaluatorUserAccountId])
  @@index([blindSampleId])
  @@index([evaluatorUserAccountId])
  @@map("assessment")
  @@schema("sensory")
}

model AttributeResponse {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String           @map("assessment_id") @db.Uuid
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attributeId  String           @map("attribute_id") @db.Uuid
  attribute    SensoryAttribute @relation(fields: [attributeId], references: [id])
  value        Decimal          @db.Decimal(5, 2)
  comment      String?

  @@unique([assessmentId, attributeId])
  @@map("attribute_response")
  @@schema("sensory")
}

// R1 (docs/implementation/33_R1_ROASTSESSION_TAXONOMIA_SENSORIAL.md §2). One
// unified vocabulary/taxonomy table, not separate Descriptor and Defect
// tables — matches the shape BEVERAGE_SENSORY_PROTOCOLS.md's own defects-
// taxonomy section already specified (`sensory.honey_descriptor(id, family,
// specific_descriptor, expected_perception, classification [positivo|
// neutral|defecto], technical_cause (nullable))`), reused as-is rather than
// redesigned. A descriptor belongs to a SensoryProtocolVersion, same
// versioning discipline SensoryAttribute already follows — it does not
// float loose across protocols, and a new protocol version can supersede
// its predecessor's vocabulary the same way it can supersede attributes.
enum SensoryDescriptorClassification {
  positive
  neutral
  defect

  @@schema("sensory")
}

model SensoryDescriptor {
  id                 String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolVersionId  String                          @map("protocol_version_id") @db.Uuid
  protocolVersion    SensoryProtocolVersion          @relation(fields: [protocolVersionId], references: [id], onDelete: Cascade)
  family             String
  specificDescriptor String                          @map("specific_descriptor")
  expectedPerception String?                         @map("expected_perception")
  classification     SensoryDescriptorClassification
  // Only meaningful when classification = defect — a defect that names its
  // cause is diagnostic, not just a label (§2.2). Free text, not a closed
  // enum: the real causes are domain-specific (honey's six families are not
  // coffee's or beer's), and forcing every future domain's defect causes
  // into one shared enum would either fragment into per-domain enums anyway
  // or flatten genuinely different vocabularies into one.
  technicalCause     String?                         @map("technical_cause")
  displayOrder       Int?                            @map("display_order")
  createdAt          DateTime                        @default(now()) @map("created_at")

  responses                  SensoryDescriptorResponse[]
  // RO1.2 §2b-iii — a field descriptor optionally mapped to this structured
  // vocabulary later, by someone with judgment, never automatic.
  processSensoryObservations ProcessSensoryObservation[]

  @@index([protocolVersionId])
  @@map("sensory_descriptor")
  @@schema("sensory")
}

enum SensoryConfidenceLevel {
  low
  medium
  high

  @@schema("sensory")
}

// The structured pick, living alongside AttributeResponse's numeric scores
// and Assessment.comment's free text — additive, not a replacement for
// either. Nullable confidence: "confianza media" is meaningful when given,
// but not every evaluator workflow collects it, same "missing stays
// missing" discipline as Measurement.dataQuality.
model SensoryDescriptorResponse {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String                  @map("assessment_id") @db.Uuid
  assessment   Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  descriptorId String                  @map("descriptor_id") @db.Uuid
  descriptor   SensoryDescriptor       @relation(fields: [descriptorId], references: [id])
  confidence   SensoryConfidenceLevel?
  comment      String?

  @@unique([assessmentId, descriptorId])
  @@index([assessmentId])
  @@index([descriptorId])
  @@map("sensory_descriptor_response")
  @@schema("sensory")
}

// Derived metric, not a measurement — CLAUDE.md §28: "Derived metrics must
// store: method; formula; software/version when relevant; source dataset;
// timestamp; version." Upserted on demand from current (non-superseded)
// Assessments by lib/sensory/service.ts's computePanelResult, never
// hand-edited — the panel's own record of "how we got this number."
model PanelResult {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blindSampleId String             @map("blind_sample_id") @db.Uuid
  blindSample   SensoryBlindSample @relation(fields: [blindSampleId], references: [id], onDelete: Cascade)
  // Null = overall-score aggregate; set = one specific attribute's aggregate.
  attributeId   String?            @map("attribute_id") @db.Uuid
  attribute     SensoryAttribute?  @relation(fields: [attributeId], references: [id])
  method        String             @default("simple_mean_v1")
  responseCount Int                @map("response_count")
  meanValue     Decimal            @map("mean_value") @db.Decimal(6, 3)
  minValue      Decimal            @map("min_value") @db.Decimal(6, 3)
  maxValue      Decimal            @map("max_value") @db.Decimal(6, 3)
  computedAt    DateTime           @default(now()) @map("computed_at")

  @@unique([blindSampleId, attributeId])
  @@map("panel_result")
  @@schema("sensory")
}

// ---------------------------------------------------------------------------
// Slice 7 — AI (MVP_ROADMAP.md), implementing AI_GOVERNANCE.md's suggestion
// lifecycle literally: "AI Suggestion → Evidence/Reason → Human Review →
// Accept/Reject/Modify → Action → Audit Record." This is the ONLY table any
// AI-service code path may write to — enforced not just by convention but by
// a real, separately-privileged Postgres role (see
// prisma/migrations/*_ai_governance_role/migration.sql and
// lib/ai/db.ts) that holds INSERT on this table and nothing else. Human
// review decisions (accept/reject/modify) are written by the reviewing
// human's own request, through the normal `prisma` client, RBAC-checked
// like any other write — never by the AI role.
// ---------------------------------------------------------------------------

enum RecommendationStatus {
  pending
  accepted
  rejected
  modified

  @@schema("ai")
}

model Recommendation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suggestionType String   @map("suggestion_type")
  model          String
  modelVersion   String?  @map("model_version")
  createdAt      DateTime @default(now()) @map("created_at")

  // Related entity refs + input summary — deliberately untyped jsonb, since
  // this table's whole point is to work across every module without a
  // schema change per suggestion type (AI_GOVERNANCE.md §4).
  context            Json?
  recommendation     String
  supportingEvidence Json?    @map("supporting_evidence")
  confidence         Decimal? @db.Decimal(4, 3)

  // Not a real FK — related_entity_type spans every module's own schema,
  // and the ai_service Postgres role must not gain cross-schema read
  // access just to validate a foreign key. Application code resolves this
  // pair against the correct module table using resolvedPermissionKeys the
  // same way a human's own request would.
  relatedEntityType String? @map("related_entity_type")
  relatedEntityId   String? @map("related_entity_id") @db.Uuid

  status                RecommendationStatus @default(pending)
  reviewerUserAccountId String?              @map("reviewer_user_account_id") @db.Uuid
  reviewer              UserAccount?         @relation("RecommendationReviewedBy", fields: [reviewerUserAccountId], references: [id])
  decisionAt            DateTime?            @map("decision_at")
  actionTaken           String?              @map("action_taken")

  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
  @@map("recommendation")
  @@schema("ai")
}

// ---------------------------------------------------------------------------
// Competitions (CLAUDE.md §29-30, DOMAIN_MODEL.md "Competitions"). Explicitly
// NOT a parallel evaluation system: "Reuses SensoryProtocol/Assessment from
// the Sensory module for the actual judging mechanics rather than
// duplicating a scoring engine." This module is a workflow/chain-of-custody
// layer — registration, categories, entries, judge assignment (with
// conflict-of-interest tracking Sensory itself has no concept of), and
// finalized results/awards — wrapped around Sensory's existing
// SensorySession/SensoryFlight/SensoryBlindSample/SensoryBlindMapping/
// Assessment/PanelResult tables, which do the actual blind judging
// unchanged. A Competition judge is assigned exactly the way a Sensory judge
// always is — a session-scoped RBAC Assignment holding the "Sensory Judge"
// or "Sensory Head Judge" Role Profile — no parallel permission system.
// Direct cross-module references to `sensory.*` here are a deliberate,
// DOMAIN_MODEL.md-sanctioned exception to DATA_ARCHITECTURE.md §1's general
// "modules reference core, not each other" convention, precisely because
// reuse (not duplication) is the explicit design mandate for this module.
// ---------------------------------------------------------------------------

enum CompetitionStatus {
  active
  archived

  @@schema("competitions")
}

model Competition {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Same open, free-text domain convention as SensoryProtocol.domain.
  domain      String
  name        String
  description String?
  status      CompetitionStatus @default(active)
  createdAt   DateTime          @default(now()) @map("created_at")

  editions CompetitionEdition[]

  @@map("competition")
  @@schema("competitions")
}

enum CompetitionEditionStatus {
  planning
  open_for_entries
  judging
  completed

  @@schema("competitions")
}

model CompetitionEdition {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId String                   @map("competition_id") @db.Uuid
  competition   Competition              @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // e.g. "2026" — free text, not a year type, since some editions are
  // named rather than dated (e.g. "Inaugural Edition").
  label         String
  status        CompetitionEditionStatus @default(planning)
  createdAt     DateTime                 @default(now()) @map("created_at")

  categories CompetitionCategory[]

  @@index([competitionId])
  @@map("competition_edition")
  @@schema("competitions")
}

model CompetitionCategory {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  editionId                String                 @map("edition_id") @db.Uuid
  edition                  CompetitionEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name                     String
  sensoryProtocolVersionId String                 @map("sensory_protocol_version_id") @db.Uuid
  sensoryProtocolVersion   SensoryProtocolVersion @relation(fields: [sensoryProtocolVersionId], references: [id])
  // Null until judging actually begins for this category — set once, then
  // every blind-coding/judging/panel-result action for this category
  // happens entirely through the existing Sensory UI against this session.
  sensorySessionId         String?                @map("sensory_session_id") @db.Uuid
  sensorySession           SensorySession?        @relation(fields: [sensorySessionId], references: [id])
  createdAt                DateTime               @default(now()) @map("created_at")

  entries          Entry[]
  judgeAssignments CompetitionJudgeAssignment[]

  @@index([editionId])
  @@index([sensoryProtocolVersionId])
  @@map("competition_category")
  @@schema("competitions")
}

enum EntryStatus {
  registered
  received
  disqualified
  judged

  @@schema("competitions")
}

model Entry {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId               String              @map("category_id") @db.Uuid
  category                 CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // The canonical Sample being entered — later blind-coded into a
  // sensory.SensoryBlindSample within the category's session for judging.
  // Chain of custody (CLAUDE.md §29) is this FK plus Sample's own
  // provenance, not a duplicated tracking record.
  sampleId                 String              @map("sample_id") @db.Uuid
  sample                   Sample              @relation(fields: [sampleId], references: [id])
  competitorPersonId       String?             @map("competitor_person_id") @db.Uuid
  competitorPerson         Person?             @relation(fields: [competitorPersonId], references: [id])
  competitorOrganizationId String?             @map("competitor_organization_id") @db.Uuid
  competitorOrganization   Organization?       @relation(fields: [competitorOrganizationId], references: [id])
  status                   EntryStatus         @default(registered)
  registeredAt             DateTime            @default(now()) @map("registered_at")

  result CompetitionResult?

  @@index([categoryId])
  @@index([sampleId])
  @@map("entry")
  @@schema("competitions")
}

// Judge assignment metadata Sensory itself has no concept of
// (conflict-of-interest declaration, CLAUDE.md §29) — the actual permission
// grant to judge is the standard session-scoped RBAC Assignment, created
// alongside this row, not replaced by it.
model CompetitionJudgeAssignment {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId                 String              @map("category_id") @db.Uuid
  category                   CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userAccountId              String              @map("user_account_id") @db.Uuid
  userAccount                UserAccount         @relation(fields: [userAccountId], references: [id])
  conflictOfInterestDeclared Boolean             @default(false) @map("conflict_of_interest_declared")
  conflictOfInterestNotes    String?             @map("conflict_of_interest_notes")
  assignedAt                 DateTime            @default(now()) @map("assigned_at")

  @@unique([categoryId, userAccountId])
  @@map("competition_judge_assignment")
  @@schema("competitions")
}

enum CompetitionResultStatus {
  draft
  finalized

  @@schema("competitions")
}

// The competition's official, published outcome — distinct from Sensory's
// own PanelResult (raw statistical aggregate). A head judge reviews the
// PanelResult and finalizes a CompetitionResult from it; the underlying
// Assessments/PanelResult rows are never altered by this (CLAUDE.md §32 —
// AI/no one silently changes competition results; finalizing here is a
// distinct, audited human act, not an edit to the sensory data it's based
// on).
model CompetitionResult {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId                  String                  @unique @map("entry_id") @db.Uuid
  entry                    Entry                   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  blindSampleId            String                  @unique @map("blind_sample_id") @db.Uuid
  blindSample              SensoryBlindSample      @relation(fields: [blindSampleId], references: [id])
  finalScore               Decimal?                @map("final_score") @db.Decimal(6, 3)
  rank                     Int?
  status                   CompetitionResultStatus @default(draft)
  finalizedByUserAccountId String?                 @map("finalized_by_user_account_id") @db.Uuid
  finalizedByUserAccount   UserAccount?            @relation("CompetitionResultFinalizedBy", fields: [finalizedByUserAccountId], references: [id])
  finalizedAt              DateTime?               @map("finalized_at")

  award Award?

  @@map("competition_result")
  @@schema("competitions")
}

model Award {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultId  String            @unique @map("result_id") @db.Uuid
  result    CompetitionResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  // Free text, deliberately not a closed enum — CLAUDE.md §30: competition
  // scoring/award structures are configured per edition, not assumed.
  name      String
  awardedAt DateTime          @default(now()) @map("awarded_at")

  @@map("award")
  @@schema("competitions")
}

// ---------------------------------------------------------------------------
// Reference Standards & Panel Calibration (BEVERAGE_SENSORY_PROTOCOLS.md §7,
// DECISIONS.md ADR-035). What turns "we have a descriptor list" into a
// professional-grade panel program: calibrating evaluators against known,
// precisely-dosed reference compounds, recording per-evaluator calibration
// history (including known insensitivity/anosmia), and tracking real
// certifications. Supplier is deliberately open — any current or future
// supplier (FlavorActiV, AROXA, Néctar Nómada itself) is just a
// `core.Organization` row, never a hard-coded value (§7.1).
// ---------------------------------------------------------------------------

enum ReferenceStandardOrigin {
  commercial_third_party
  self_created
  adapted_from_commercial

  @@schema("sensory")
}

model ReferenceStandard {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compoundName             String                  @map("compound_name")
  sensoryDescriptor        String                  @map("sensory_descriptor")
  // 'beer' | 'wine' | 'coffee' | 'honey' | 'spirits' | 'water' | 'other' —
  // same open, free-text convention as SensoryProtocol.domain.
  category                 String
  typicalThresholdValue    Decimal?                @map("typical_threshold_value") @db.Decimal(10, 4)
  thresholdUnit            String?                 @map("threshold_unit")
  standardOrigin           ReferenceStandardOrigin @map("standard_origin")
  supplierOrganizationId   String?                 @map("supplier_organization_id") @db.Uuid
  supplierOrganization     Organization?           @relation(fields: [supplierOrganizationId], references: [id])
  supplierProductReference String?                 @map("supplier_product_reference")
  dataSheetReference       String?                 @map("data_sheet_reference")
  // Set when this standard is also a product sold through Commerce — one
  // record serving both a commercial listing and internal calibration use
  // (§7.1), not duplicated data.
  commerceProductId        String?                 @map("commerce_product_id") @db.Uuid
  commerceProduct          Product?                @relation(fields: [commerceProductId], references: [id])
  notes                    String?
  createdAt                DateTime                @default(now()) @map("created_at")

  selfCreatedDetail            SelfCreatedStandardDetail?
  calibrationResults           CalibrationResult[]
  evaluatorSensitivityProfiles EvaluatorSensitivityProfile[]

  @@index([category])
  @@index([supplierOrganizationId])
  @@map("reference_standard")
  @@schema("sensory")
}

enum StandardValidationMethod {
  none
  commercial_standard_comparison
  expert_panel_consensus
  triangle_test

  @@schema("sensory")
}

// A self-created standard's threshold/descriptor claims get the same
// evidence discipline as any other fact in this system (DATA_ARCHITECTURE.md
// §4) — "I made this and I know what's in it" is `creationMethod`/
// `compositionNotes`; `validatedAgainst` is what lets someone (including
// future-you) know whether the claimed threshold has actually been checked
// against something external, or is still provisional (`none` is a
// legitimate, honestly-recorded value, not a gap to hide).
model SelfCreatedStandardDetail {
  referenceStandardId String                   @id @map("reference_standard_id") @db.Uuid
  referenceStandard   ReferenceStandard        @relation(fields: [referenceStandardId], references: [id], onDelete: Cascade)
  compositionNotes    String?                  @map("composition_notes")
  creationMethod      String?                  @map("creation_method")
  baseMaterialSource  String?                  @map("base_material_source")
  validatedAgainst    StandardValidationMethod @default(none) @map("validated_against")
  validationReference String?                  @map("validation_reference")
  createdByPersonId   String?                  @map("created_by_person_id") @db.Uuid
  createdByPerson     Person?                  @relation(fields: [createdByPersonId], references: [id])
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@map("self_created_standard_detail")
  @@schema("sensory")
}

// A panelist capability test, structurally distinct from SensorySession
// (which evaluates products, not people) — CLAUDE.md's evaluator-profile
// principle (§27) applied concretely.
model CalibrationSession {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionDate            DateTime @map("session_date")
  category               String
  conductedByPersonId    String?  @map("conducted_by_person_id") @db.Uuid
  conductedByPerson      Person?  @relation(fields: [conductedByPersonId], references: [id])
  // Array of {referenceStandardId, actualConcentration} — a trainer may
  // dose below/above a standard's default concentration for a given
  // exercise, so this is the session's own record, not just a link.
  referenceStandardsUsed Json?    @map("reference_standards_used")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at")

  results CalibrationResult[]

  @@map("calibration_session")
  @@schema("sensory")
}

model CalibrationResult {
  id                           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calibrationSessionId         String             @map("calibration_session_id") @db.Uuid
  calibrationSession           CalibrationSession @relation(fields: [calibrationSessionId], references: [id], onDelete: Cascade)
  evaluatorPersonId            String             @map("evaluator_person_id") @db.Uuid
  evaluatorPerson              Person             @relation(fields: [evaluatorPersonId], references: [id])
  referenceStandardId          String             @map("reference_standard_id") @db.Uuid
  referenceStandard            ReferenceStandard  @relation(fields: [referenceStandardId], references: [id])
  correctlyIdentified          Boolean            @map("correctly_identified")
  perceivedDescriptorGiven     String?            @map("perceived_descriptor_given")
  perceivedIntensityRating     Decimal?           @map("perceived_intensity_rating") @db.Decimal(6, 3)
  actualConcentrationPresented Decimal?           @map("actual_concentration_presented") @db.Decimal(10, 4)
  notes                        String?

  @@index([calibrationSessionId])
  @@index([evaluatorPersonId])
  @@map("calibration_result")
  @@schema("sensory")
}

enum SensitivityConfidenceLevel {
  not_tested
  tested_once
  regularly_calibrated

  @@schema("sensory")
}

// Why this matters, stated once (BEVERAGE_SENSORY_PROTOCOLS.md §7.3): some
// panelists are genuinely anosmic to specific compounds — a rigorous panel
// needs to know this per-panelist, not discover it mid-evaluation. This is
// what makes a panel's aggregate PanelResult actually trustworthy: an
// evaluator's assessment of a related off-flavor carries different weight
// if their calibration history shows reliable detection at low
// concentrations versus never having been tested, or known insensitivity.
model EvaluatorSensitivityProfile {
  personId              String                     @map("person_id") @db.Uuid
  person                Person                     @relation(fields: [personId], references: [id])
  referenceStandardId   String                     @map("reference_standard_id") @db.Uuid
  referenceStandard     ReferenceStandard          @relation(fields: [referenceStandardId], references: [id])
  demonstratedThreshold Decimal?                   @map("demonstrated_threshold") @db.Decimal(10, 4)
  knownAnosmic          Boolean?                   @map("known_anosmic")
  lastCalibrationDate   DateTime?                  @map("last_calibration_date")
  confidenceLevel       SensitivityConfidenceLevel @default(not_tested) @map("confidence_level")

  @@id([personId, referenceStandardId])
  @@map("evaluator_sensitivity_profile")
  @@schema("sensory")
}

// ---------------------------------------------------------------------------
// Phase 1 — Coffee Lot Genealogy (docs/implementation/PHASE_1_TECHNICAL_
// EXECUTION_PLAN.md, ticket T1). Reconciles DOMAIN_MODEL.md §4's Agricultural
// Traceability chain (Lot → HarvestEvent → Selection → Processing →
// Fermentation → Drying → Storage → ... — which names the stages) with
// COMMERCE_OPERATIONS_TOOLS_ARCHITECTURE.md §F's already-approved
// Lot/LotTransformation mechanism (which is how a lot actually splits,
// merges, or blends between those stages) — the latter is the physical
// mechanics underneath the former's named pipeline, not a competing model.
// ---------------------------------------------------------------------------

// DATA_ARCHITECTURE.md §4 — specified as "mandatory, not conventional" since
// the platform's first architecture pass, implemented for the first time
// here. Applied to every new Phase 1 fact-bearing table (execution plan
// §6.2); retrofitting it onto already-built Sensory/Competitions/Partner
// tables is a deliberately separate, explicitly-sequenced fast-follow
// (execution plan §6.3), not part of this migration.
enum ProvenanceClass {
  measured_fact
  original_record
  direct_observation
  scientific_evidence
  manufacturer_specification
  interpretation
  hypothesis
  conclusion
  recommendation
  ai_suggestion

  @@schema("core")
}

enum DataQuality {
  verified
  verified_with_limitation
  provisional
  unconfirmed
  conflicting
  superseded
  working_hypothesis
  not_tested
  missing_source_record

  @@schema("core")
}

enum LotType {
  cherry
  processing
  drying
  green
  roast
  sample
  other
  // A3 (22_APIARY_V1_SCOPING_REPORT.md §2) — HoneyBatch is a Lot, not a
  // parallel table: a physically distinct output material reuses the
  // existing Lot machinery (Sample/Measurement/QuantityEvent/Asset)
  // unmodified, the same reasoning already applied to `roast`.
  honey

  @@schema("traceability")
}

model Lot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // P0 (41_P0_MASS_BALANCE.md §7): scoped per organization, not globally
  // unique. A global unique is both an offline-collision hazard (two
  // disconnected devices minting "PE-79") and a multi-tenant defect (two
  // farms cannot both number a batch "01"). See @@unique below.
  lotCode String  @map("lot_code")
  lotType LotType @map("lot_type")
  // P0: required. Was nullable, but no row ever used that (verified 0 of 43
  // before the migration), and a batch with no owning organization is
  // meaningless under multi-tenancy — it is also what makes the scoped
  // unique above a real constraint rather than one NULLs slip through.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String?             @map("project_id") @db.Uuid
  project        Project?            @relation(fields: [projectId], references: [id])
  // Same project/organization/location triple every other traceable
  // canonical entity (Sample, Story, Product, Experience) already carries.
  // Needed as a real RBAC scope target, not just descriptive metadata: a
  // location-scoped Farm Operator Assignment (execution plan §26 decision
  // record) can only authorize an action against a Lot if the Lot itself
  // resolves to that location — RBAC.md §3's leaf-scope containment rule
  // means a project-scoped check alone would never succeed for such an
  // Assignment.
  locationId     String?             @map("location_id") @db.Uuid
  location       Location?           @relation(fields: [locationId], references: [id])
  // Administrative record lifecycle (draft/approved/archived/...) — distinct
  // from a lot's *processing stage*, which is never stored here. Current
  // stage is always derived by querying this lot's LotTransformation
  // history (execution plan §8.2: "current state is computed, never an
  // overwritable column").
  status         RecordStatus        @default(draft)
  classification ClassificationLevel @default(internal)
  // P0 (§8) — the reliability of this lot's own quantity record, distinct
  // from `status` (its administrative lifecycle) and from the
  // provenanceClass carried by each individual event. Set to `conflicting`
  // on the three lots whose ledger was inflated by the pre-P0 write path
  // (PE-79/PE-80/PE-90); reporting excludes those rather than quoting a
  // figure known to be wrong. Nullable and unset for every other lot —
  // absence means "no reason to doubt it", never "verified".
  dataQuality    DataQuality?        @map("data_quality")
  // P3 (44_P3_SELECTION.md §3) — why this lot was rejected, when it was.
  //
  // Deliberately NOT a new `LotType` value, diverging from the audit's §25.
  // `lotType` describes the material's *stage*, and a lot of floaters is
  // physically still cherry; a rejected parchment is still parchment. Folding
  // a quality judgement into the stage enum would make it mean two things at
  // once, and could not express rejected material at a later stage at all.
  // Stage and quality are two axes here, the same separation `dataQuality`
  // already has from `status`.
  //
  // Null for every ordinary lot. Its presence is what marks a lot as a
  // rejection stream — which can still be stored, sold or reprocessed, since
  // audit §18's rule is that not every rejection is waste.
  rejectionCategoryValueId String?               @map("rejection_category_value_id") @db.Uuid
  rejectionCategoryValue   VariableCatalogValue? @relation("LotRejectionCategory", fields: [rejectionCategoryValueId], references: [id])
  createdAt      DateTime            @default(now()) @map("created_at")
  createdBy      String?             @map("created_by") @db.Uuid
  creator        UserAccount?        @relation("LotCreatedBy", fields: [createdBy], references: [id])

  transformationInputs      LotTransformationInput[]
  transformationOutputs     LotTransformationOutput[]
  quantityEvents            QuantityEvent[]
  measurements              Measurement[]
  samples                   Sample[]
  storageAssignments        StorageAssignment[]
  // 1:1 — a Lot originates from at most one of these (or from a
  // LotTransformation output, which carries no back-relation of its own
  // kind here since that Lot is one of possibly several outputs).
  harvestEvent              HarvestEvent?
  receivingEvent            ReceivingEvent?
  apiaryHarvestEvent        ApiaryHarvestEvent?
  assets                    Asset[]
  // RO1 — a PE protocol treatment applied to this Lot, when one exists
  // (nullable on TreatmentBatch — Research OS isn't coffee-only).
  treatmentBatches          TreatmentBatch[]
  // RO1.2 §1a — this Lot was used as another treatment's washing medium
  // ("Doble Mosto Guacho," PE-106/PE-107) — closer to inoculating than to
  // rinsing, so recording which lot the mosto came from matters.
  washMediumSourceForStages ProcessingStage[]         @relation("ProcessingStageWashMediumSourceLot")

  @@unique([organizationId, lotCode])
  @@index([organizationId])
  @@index([projectId])
  @@index([rejectionCategoryValueId])
  @@map("lot")
  @@schema("traceability")
}

enum LotTransformationType {
  split
  merge
  blend
  stage_change
  sample_extraction
  loss
  disposal
  sale
  // P3 (44_P3_SELECTION.md §1). Cherry sorting as a material operation:
  // one input, an accepted output and one output per rejection stream.
  // Registered in balance.ts's CONSERVING_TYPES — accepted + rejected +
  // declared loss must equal the input, which is the first transformation
  // where an out-of-balance figure means a real discrepancy rather than a
  // yield (ADR-094 Decision 4).
  selection

  @@schema("traceability")
}

// Append-only by construction — lib/traceability/lots.ts deliberately has no
// update function for this table or its input/output joins. A correction is
// always a new LotTransformation, never an edit to an existing one, the same
// principle already proven for sensory.Assessment (immutable,
// supersedesAssessmentId for corrections) and SensoryProtocolVersion
// (versioned, never overwritten) elsewhere in this schema — getting this
// wrong would silently corrupt traceability with no error, discovered only
// when a report doesn't add up.
model LotTransformation {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transformationType LotTransformationType @map("transformation_type")
  occurredAt         DateTime              @map("occurred_at")
  operatorPersonId   String?               @map("operator_person_id") @db.Uuid
  operator           Person?               @relation(fields: [operatorPersonId], references: [id])
  notes              String?
  // T9.5: no default. T1-T9 left this NOT NULL with a silent
  // @default(direct_observation) that every write path fell through to
  // unchallenged — a row that nobody chose a class for still asserted the
  // strongest claim in the vocabulary. Required at the type level now
  // (lib/traceability/*.ts's input interfaces carry no `?`); the caller
  // must state a real class.
  provenanceClass    ProvenanceClass       @map("provenance_class")
  // Citation for this specific fact ("lab report #123", "calibrated scale
  // reading 2026-01-01") — distinct from operatorPersonId (who did it) and
  // occurredAt (when it happened), which this table already carries.
  // Verification-pass finding: not added for T1-T9 alongside
  // provenanceClass; completed here rather than left compounding.
  sourceReference    String?               @map("source_reference")
  createdAt          DateTime              @default(now()) @map("created_at")
  createdBy          String?               @map("created_by") @db.Uuid
  creator            UserAccount?          @relation("LotTransformationCreatedBy", fields: [createdBy], references: [id])

  // Links a stage_change transformation to the run it starts or ends
  // (execution plan §15 — "input/output lot(s) are not FKs on
  // FermentationRun directly, they're expressed through the
  // LotTransformation that references this run"). Null for every
  // transformation type that isn't bracketing a stage run.
  fermentationRunId String?          @map("fermentation_run_id") @db.Uuid
  fermentationRun   FermentationRun? @relation(fields: [fermentationRunId], references: [id])
  // Same mechanism, T7's DryingRun.
  dryingRunId       String?          @map("drying_run_id") @db.Uuid
  dryingRun         DryingRun?       @relation(fields: [dryingRunId], references: [id])
  // Same mechanism, R1's RoastSession.
  roastSessionId    String?          @map("roast_session_id") @db.Uuid
  roastSession      RoastSession?    @relation(fields: [roastSessionId], references: [id])

  // P0 (41_P0_MASS_BALANCE.md §4) — material that leaves the chain without
  // becoming an output Lot: mucilage, water, handling loss. Distinct from a
  // `loss` transformation, which is the whole lot going; this is the
  // shrinkage inside a transformation that also produced something.
  // P3 §1 — both nullable and only meaningful for transformationType
  // `selection`. equipmentNote stays free text, matching
  // FermentationRun.vesselNote's precedent: no Equipment entity exists yet.
  selectionMethodValueId String?               @map("selection_method_value_id") @db.Uuid
  selectionMethodValue   VariableCatalogValue? @relation("LotTransformationSelectionMethod", fields: [selectionMethodValueId], references: [id])
  equipmentNote          String?               @map("equipment_note")

  declaredLossQuantity Decimal? @map("declared_loss_quantity") @db.Decimal(10, 3)
  declaredLossUnit     String?  @map("declared_loss_unit")
  declaredLossReason   String?  @map("declared_loss_reason")
  // Σinputs − Σoutputs − declaredLoss, computed at write time and *stored*.
  // Stored rather than derived because it is the value an audit asks about
  // years later, and recomputing it from a history that has since been
  // corrected would answer a different question than "what did this
  // reconcile to when it was recorded". NULL when any input lot has no
  // ledger at all — unknown, never zero (ADR-080's distinction).
  unexplainedQuantity Decimal? @map("unexplained_quantity") @db.Decimal(10, 3)

  inputs         LotTransformationInput[]
  outputs        LotTransformationOutput[]
  quantityEvents QuantityEvent[]
  samples        Sample[]
  deviations     Deviation[]
  fieldEvents    FieldEvent[]

  @@index([occurredAt])
  @@index([fermentationRunId])
  @@index([dryingRunId])
  @@index([selectionMethodValueId])
  @@map("lot_transformation")
  @@schema("traceability")
}

model LotTransformationInput {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transformationId String            @map("transformation_id") @db.Uuid
  transformation   LotTransformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  lotId            String            @map("lot_id") @db.Uuid
  lot              Lot               @relation(fields: [lotId], references: [id])
  quantity         Decimal?          @db.Decimal(10, 3)
  unit             String?

  @@index([transformationId])
  @@index([lotId])
  @@map("lot_transformation_input")
  @@schema("traceability")
}

model LotTransformationOutput {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transformationId String            @map("transformation_id") @db.Uuid
  transformation   LotTransformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  lotId            String            @map("lot_id") @db.Uuid
  lot              Lot               @relation(fields: [lotId], references: [id])
  quantity         Decimal?          @db.Decimal(10, 3)
  unit             String?

  @@index([transformationId])
  @@index([lotId])
  @@map("lot_transformation_output")
  @@schema("traceability")
}

// `adjustment` is split into _increase/_decrease rather than carrying a
// separate direction column: quantity is always a non-negative magnitude
// (see QuantityEvent below), and every other event type's effect on a lot's
// running total is unambiguous from its name alone (execution plan §9's
// sketch left this one case underspecified — resolved here rather than
// adding a nullable direction field just for one event type).
enum QuantityEventType {
  received
  process_output
  loss
  sample_removed
  adjustment_increase
  adjustment_decrease
  transfer_in
  transfer_out

  @@schema("traceability")
}

// Append-only mass/quantity ledger (execution plan §9) — a Lot's current
// quantity is always SUM(QuantityEvent), computed by
// lib/traceability/quantity.ts, never a stored overwritable column, same
// principle as LotTransformation above. `quantity` is a non-negative
// magnitude for every event type; direction is derived from `eventType`.
model QuantityEvent {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId            String             @map("lot_id") @db.Uuid
  lot              Lot                @relation(fields: [lotId], references: [id])
  eventType        QuantityEventType  @map("event_type")
  quantity         Decimal            @db.Decimal(10, 3)
  unit             String
  occurredAt       DateTime           @map("occurred_at")
  transformationId String?            @map("transformation_id") @db.Uuid
  transformation   LotTransformation? @relation(fields: [transformationId], references: [id])
  // T9.5: no default — see LotTransformation.provenanceClass's comment.
  provenanceClass  ProvenanceClass    @map("provenance_class")
  sourceReference  String?            @map("source_reference")
  dataQuality      DataQuality?       @map("data_quality")
  notes            String?
  // P2 (43_P2_OPERATOR_CORE.md §5) — three different facts the schema could
  // previously hold only one of. The audit's worked example: measured at
  // 14:00, entered on the phone at 14:23, synced the next morning at 09:17.
  // `occurredAt` is when it happened, `recordedAt` is the device clock when
  // the operator entered it, `createdAt` is server receipt, `syncedAt` is when
  // it arrived from a device.
  //
  // `deviceId` is a bare nullable UUID for now: the `Device` table (with token
  // issuance and revocation) belongs to Phase 4, and the FK is added then —
  // the same additive-FK-per-parent pattern Measurement already used for
  // FermentationRun and DryingRun.
  recordedAt DateTime? @map("recorded_at")
  syncedAt   DateTime? @map("synced_at")
  captureDeviceId  String?            @map("capture_device_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  createdBy        String?            @map("created_by") @db.Uuid
  creator          UserAccount?       @relation("QuantityEventCreatedBy", fields: [createdBy], references: [id])

  fieldEvents FieldEvent[]

  @@index([lotId])
  @@index([transformationId])
  @@map("quantity_event")
  @@schema("traceability")
}

enum MeasurementSourceType {
  manual
  device
  sensor
  lab
  import
  external_context
  derived

  @@schema("traceability")
}

// Generalized typed observation (execution plan §10) — temperature, pH,
// Brix, relative humidity, moisture, water activity (§10.3's matrix).
// Weight is deliberately NOT here: it's a *quantity* of material
// (QuantityEvent, §9), not an *observation about* material.
//
// Specific nullable FKs, not a polymorphic subject_type/subject_id pair
// (COMMERCE_OPERATIONS_TOOLS_ARCHITECTURE.md §I's referential-integrity
// trade-off). fermentationRunId/dryingRunId/storageAssignmentId are plain
// UUID columns with no DB-level FK yet — FermentationRun/DryingRun/
// StorageAssignment don't exist until T6-T8; the constraint is added then,
// additively, same pattern as every other Phase 1 migration.
//
// Phase 1 write paths only ever produce sourceType "manual" — the other six
// values exist now so integrating a device/sensor/lab feed later needs no
// migration (execution plan §10.2).
//
// Corrections: never an in-place UPDATE. correctsId (self-referencing,
// nullable) + a mandatory reason (enforced in
// lib/traceability/measurements.ts, not the DB) point a correction at the
// row it corrects — same shape as sensory.Assessment.supersedesAssessmentId.
model Measurement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variable   String
  value      Decimal  @db.Decimal(12, 4)
  unit       String
  occurredAt DateTime @map("occurred_at")

  lotId               String?            @map("lot_id") @db.Uuid
  lot                 Lot?               @relation(fields: [lotId], references: [id])
  sampleId            String?            @map("sample_id") @db.Uuid
  sample              Sample?            @relation(fields: [sampleId], references: [id])
  // FermentationRun/DryingRun/StorageAssignment exist as of T6/T7/T8 — all
  // real FKs now, each added additively when its table landed.
  fermentationRunId   String?            @map("fermentation_run_id") @db.Uuid
  fermentationRun     FermentationRun?   @relation(fields: [fermentationRunId], references: [id])
  dryingRunId         String?            @map("drying_run_id") @db.Uuid
  dryingRun           DryingRun?         @relation(fields: [dryingRunId], references: [id])
  storageAssignmentId String?            @map("storage_assignment_id") @db.Uuid
  storageAssignment   StorageAssignment? @relation(fields: [storageAssignmentId], references: [id])
  // R1 — also the mechanism that distinguishes a pre-roast green-coffee
  // moisture/density reading (§1.4) from an ordinary storage-phase one:
  // both carry lotId, but only the pre-roast reading also carries
  // roastSessionId. No new field needed to express "which moment" — the
  // presence of this FK already says so unambiguously.
  roastSessionId      String?            @map("roast_session_id") @db.Uuid
  roastSession        RoastSession?      @relation(fields: [roastSessionId], references: [id])
  // RO1 — a PE-protocol reading (Brix/pH/moisture) taken during a
  // TreatmentBatch's execution, at a specific ProcessingStage moment
  // (post-fermentación, seco, taza...). Same additive-FK-per-parent pattern
  // as every other parent above.
  treatmentBatchId    String?            @map("treatment_batch_id") @db.Uuid
  treatmentBatch      TreatmentBatch?    @relation(fields: [treatmentBatchId], references: [id])
  processingStageId   String?            @map("processing_stage_id") @db.Uuid
  processingStage     ProcessingStage?   @relation(fields: [processingStageId], references: [id])
  // S1 (45_S1_SUELO_AMBIENTE_TAZA.md §2) — el primer sujeto de Measurement
  // que NO es café. Los anteriores son todos eslabones de la misma cadena
  // (Lot, Sample, y los seis enlaces que exigen un Lot al lado); un lote de
  // biochar no está en esa cadena.
  //
  // Por eso es un sujeto INDEPENDIENTE y no un enlace más: no exige `lotId`,
  // lo excluye. Y su autorización es otra — `location:manage_attributes`
  // contra la Location donde el lote se produjo, no `lot:manage` —, así que
  // `recordMeasurement` resuelve el ámbito por rama y no por acumulación.
  biocharBatchId      String?            @map("biochar_batch_id") @db.Uuid
  biocharBatch        BiocharBatch?      @relation(fields: [biocharBatchId], references: [id])
  // S1 §2 — los otros dos sujetos que no son café. Misma forma que
  // `biocharBatchId`: independientes, excluyen `lotId` en vez de exigirlo, y su
  // ámbito es la Location del bloque muestreado.
  soilSampleId        String?            @map("soil_sample_id") @db.Uuid
  soilSample          SoilSample?        @relation(fields: [soilSampleId], references: [id])
  foliarSampleId      String?            @map("foliar_sample_id") @db.Uuid
  foliarSample        FoliarSample?      @relation(fields: [foliarSampleId], references: [id])

  sourceType       MeasurementSourceType @default(manual) @map("source_type")
  // Legacy free-text device label from T3. No code path has ever written it;
  // left in place rather than repurposed, because a column that once meant
  // "some string a lab machine reported" and now means "a registered device"
  // would make old rows lie. `captureDeviceId` below is the real one.
  deviceId         String?               @map("device_id")
  // P2 (43_P2_OPERATOR_CORE.md §5) — three different facts the schema could
  // previously hold only one of. The audit's worked example: measured at
  // 14:00, entered on the phone at 14:23, synced the next morning at 09:17.
  // `occurredAt` is when it happened, `recordedAt` is the device clock when
  // the operator entered it, `createdAt` is server receipt, `syncedAt` is when
  // it arrived from a device.
  //
  // `deviceId` is a bare nullable UUID for now: the `Device` table (with token
  // issuance and revocation) belongs to Phase 4, and the FK is added then —
  // the same additive-FK-per-parent pattern Measurement already used for
  // FermentationRun and DryingRun.
  recordedAt DateTime? @map("recorded_at")
  syncedAt   DateTime? @map("synced_at")
  captureDeviceId String? @map("capture_device_id") @db.Uuid
  operatorPersonId String?               @map("operator_person_id") @db.Uuid
  operator         Person?               @relation(fields: [operatorPersonId], references: [id])

  correctsId  String?       @map("corrects_id") @db.Uuid
  corrects    Measurement?  @relation("MeasurementCorrection", fields: [correctsId], references: [id])
  corrections Measurement[] @relation("MeasurementCorrection")
  reason      String?

  // T9.5: no default — see LotTransformation.provenanceClass's comment.
  provenanceClass ProvenanceClass @map("provenance_class")
  sourceReference String?         @map("source_reference")
  dataQuality     DataQuality?    @map("data_quality")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  createdBy       String?         @map("created_by") @db.Uuid
  creator         UserAccount?    @relation("MeasurementCreatedBy", fields: [createdBy], references: [id])

  assets      Asset[]
  evidence    Evidence[]
  fieldEvents FieldEvent[]

  @@index([lotId])
  @@index([sampleId])
  @@index([fermentationRunId])
  @@index([dryingRunId])
  @@index([storageAssignmentId])
  @@index([roastSessionId])
  @@index([treatmentBatchId])
  @@index([processingStageId])
  @@index([biocharBatchId])
  @@index([soilSampleId])
  @@index([foliarSampleId])
  @@index([correctsId])
  @@map("measurement")
  @@schema("traceability")
}

// First-mile capture (execution plan §13) — the real, UI-facing origin
// point for a Lot. Both HarvestEvent and ReceivingEvent create a Lot
// (lotType = cherry) atomically; resultingLotId is unique (1:1 with the
// Lot it creates) — a Lot only ever comes into existence through one of
// these or as a LotTransformation output, never standalone (§30).
//
// projectId is not in the plan's own §13 sketch (locationId/organizationId
// only) — added so the created Lot carries the same project scope every
// other traceable entity does; needed for a project-scoped Farm Operator
// to reach it, and for §32's own DEMO chain, which is explicitly scoped to
// the Las Nubes project. Additive to a brand-new table, same category of
// refinement as T1's Lot.locationId.
model HarvestEvent {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId       String          @map("location_id") @db.Uuid // the plot
  location         Location        @relation(fields: [locationId], references: [id])
  organizationId   String          @map("organization_id") @db.Uuid // the farm
  organization     Organization    @relation(fields: [organizationId], references: [id])
  projectId        String?         @map("project_id") @db.Uuid
  project          Project?        @relation(fields: [projectId], references: [id])
  harvestedAt      DateTime        @map("harvested_at")
  // Mixed-cultivar support: free text now, a LotCultivarComposition join
  // table if/when a real mixed-lot reporting need appears — not built
  // speculatively (§13).
  cultivarNotes    String?         @map("cultivar_notes")
  cherryWeightKg   Decimal?        @map("cherry_weight_kg") @db.Decimal(10, 3)
  brix             Decimal?        @db.Decimal(5, 2)
  temperatureC     Decimal?        @map("temperature_c") @db.Decimal(5, 2)
  condition        String?
  ripenessNotes    String?         @map("ripeness_notes")
  operatorPersonId String?         @map("operator_person_id") @db.Uuid
  operator         Person?         @relation("HarvestEventOperator", fields: [operatorPersonId], references: [id])
  notes            String?
  resultingLotId   String          @unique @map("resulting_lot_id") @db.Uuid
  resultingLot     Lot             @relation(fields: [resultingLotId], references: [id])
  // T9.5: no default — see LotTransformation.provenanceClass's comment.
  provenanceClass  ProvenanceClass @map("provenance_class")
  sourceReference  String?         @map("source_reference")
  createdAt        DateTime        @default(now()) @map("created_at")
  createdBy        String?         @map("created_by") @db.Uuid
  creator          UserAccount?    @relation("HarvestEventCreatedBy", fields: [createdBy], references: [id])

  assets        Asset[]
  labourEntries LabourEntry[]
  sources       HarvestEventSource[]
  fieldEvents   FieldEvent[]

  @@index([locationId])
  @@index([organizationId])
  @@index([projectId])
  @@map("harvest_event")
  @@schema("traceability")
}

// Same shape as HarvestEvent, for material arriving from an external
// supplier rather than an owned harvest — a second, near-identical table
// rather than a nullable "is this a harvest or receiving" flag, since the
// field semantics genuinely diverge (farm/plot vs. supplier/delivery-note,
// DOMAIN_MODEL.md §20). locationId is nullable here (where received, if
// even tracked) since, unlike a harvest's plot, it isn't always known or
// meaningful for an external delivery.
model ReceivingEvent {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid // the supplier
  organization     Organization    @relation(fields: [organizationId], references: [id])
  locationId       String?         @map("location_id") @db.Uuid // where received, if known
  location         Location?       @relation(fields: [locationId], references: [id])
  projectId        String?         @map("project_id") @db.Uuid
  project          Project?        @relation(fields: [projectId], references: [id])
  receivedAt       DateTime        @map("received_at")
  deliveryNote     String?         @map("delivery_note")
  cultivarNotes    String?         @map("cultivar_notes")
  cherryWeightKg   Decimal?        @map("cherry_weight_kg") @db.Decimal(10, 3)
  brix             Decimal?        @db.Decimal(5, 2)
  temperatureC     Decimal?        @map("temperature_c") @db.Decimal(5, 2)
  condition        String?
  operatorPersonId String?         @map("operator_person_id") @db.Uuid
  operator         Person?         @relation("ReceivingEventOperator", fields: [operatorPersonId], references: [id])
  notes            String?
  resultingLotId   String          @unique @map("resulting_lot_id") @db.Uuid
  resultingLot     Lot             @relation(fields: [resultingLotId], references: [id])
  // T9.5: no default — see LotTransformation.provenanceClass's comment.
  provenanceClass  ProvenanceClass @map("provenance_class")
  sourceReference  String?         @map("source_reference")
  createdAt        DateTime        @default(now()) @map("created_at")
  createdBy        String?         @map("created_by") @db.Uuid
  creator          UserAccount?    @relation("ReceivingEventCreatedBy", fields: [createdBy], references: [id])

  labourEntries LabourEntry[]

  @@index([organizationId])
  @@index([locationId])
  @@index([projectId])
  @@map("receiving_event")
  @@schema("traceability")
}

enum FermentationInterventionType {
  inoculation
  agitation
  purge
  addition
  sample
  transfer
  termination
  other

  @@schema("traceability")
}

// Stage-run execution record (execution plan §15) — the first of three
// (FermentationRun/DryingRun/StorageAssignment), sets the pattern T7/T8
// follow. Deliberately has no lotId of its own: which Lot is running
// through it is expressed via the LotTransformation(s) that reference this
// run (fermentationRunId on LotTransformation), never duplicated here.
//
// Lifecycle: startFermentationRun creates this row plus a stage_change
// LotTransformation (input: the lot entering fermentation, zero outputs —
// nothing changes lot-identity-wise yet). endFermentationRun sets endedAt
// once (a real one-time transition recording an actual event, not an
// edit — same as StorageAssignment's own endedAt, §17) and creates a
// second stage_change LotTransformation (same input lot, output: a new
// Lot at the next stage), matching §8.3's lineage diagram exactly.
model FermentationRun {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vesselNote       String?      @map("vessel_note") // free text ("Tank 3") — no Vessel entity yet, DOMAIN_MODEL.md §20
  startedAt        DateTime     @map("started_at")
  endedAt          DateTime?    @map("ended_at")
  operatorPersonId String?      @map("operator_person_id") @db.Uuid
  operator         Person?      @relation("FermentationRunOperator", fields: [operatorPersonId], references: [id])
  inoculated       Boolean      @default(false)
  inoculationNote  String?      @map("inoculation_note")
  createdAt        DateTime     @default(now()) @map("created_at")
  createdBy        String?      @map("created_by") @db.Uuid
  creator          UserAccount? @relation("FermentationRunCreatedBy", fields: [createdBy], references: [id])

  // P2 (ADR-098) — the recipe version this run was operated against, so its
  // targets can be compared with what actually happened. Nullable: every run
  // recorded before this existed has no recipe, and a run improvised without
  // one is a legitimate state, not a gap to be backfilled.
  //
  // Points at the *version*, never at the recipe: editing a recipe must not
  // rewrite what a run six months ago was aiming for (CLAUDE.md §3).
  processRecipeVersionId String?               @map("process_recipe_version_id") @db.Uuid
  processRecipeVersion   ProcessRecipeVersion? @relation(fields: [processRecipeVersionId], references: [id])

  interventions              FermentationIntervention[]
  measurements               Measurement[]
  transformations            LotTransformation[]
  assets                     Asset[]
  labourEntries              LabourEntry[]
  materialConsumptionEntries MaterialConsumptionEntry[]

  @@index([processRecipeVersionId])
  @@map("fermentation_run")
  @@schema("traceability")
}

/// P2 (ADR-098). A named, reusable process — "Lavado tradicional", "Honey 48h"
/// — carrying the numbers a run of it is aiming for. BeerSmith's shape, and
/// the product owner's own words: the recipe declares the target, the session
/// records what actually happened, and the value is in the difference.
///
/// Deliberately NOT the research Protocol. A protocol is an experiment with
/// approval and deviation machinery; this is routine production. Folding one
/// into the other would make every ordinary fermentation an experiment.
model ProcessRecipe {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  organizationId String?             @map("organization_id") @db.Uuid
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  status         RecordStatus        @default(draft)
  classification ClassificationLevel @default(internal)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by") @db.Uuid
  creator        UserAccount?        @relation("ProcessRecipeCreatedBy", fields: [createdBy], references: [id])

  versions ProcessRecipeVersion[]

  // Scoped to the organization rather than globally: two farms may both run a
  // process they each call "Lavado".
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("process_recipe")
  @@schema("traceability")
}

/// An immutable set of targets. Changing a recipe means a new version, never
/// an edit — CLAUDE.md §3's version-preservation rule, and the reason a run
/// points here rather than at the recipe.
model ProcessRecipeVersion {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId  String       @map("recipe_id") @db.Uuid
  recipe    ProcessRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version   Int
  notes     String?
  status    RecordStatus @default(draft)
  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("ProcessRecipeVersionCreatedBy", fields: [createdBy], references: [id])

  targets          ProcessTarget[]
  fermentationRuns FermentationRun[]

  @@unique([recipeId, version])
  @@index([recipeId])
  @@map("process_recipe_version")
  @@schema("traceability")
}

/// One number a run is aiming for: "pH 3.8 at the end", "Brix 22 at the start".
///
/// `moment` is what makes original-vs-final work — the same variable targeted
/// twice in one process is the ordinary case (original gravity and final
/// gravity), not an edge case.
///
/// A target may be a point (`targetValue`), a range (`minValue`/`maxValue`),
/// or both — "aim for 3.8, anywhere in 3.7–3.9 is fine". All three are
/// nullable because a recipe that says "measure pH at the end" without
/// declaring a number is still a useful instruction, and inventing a target
/// to fill the column would be inventing a fact (CLAUDE.md §3).
model ProcessTarget {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeVersionId  String               @map("recipe_version_id") @db.Uuid
  recipeVersion    ProcessRecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  // MeasurementVariable (lib/traceability/units.ts) reused, not duplicated —
  // the same canonical names the readings themselves use, so target and actual
  // are comparable without a mapping table.
  variable         String
  moment           ProcessTargetMoment
  targetValue      Decimal?             @map("target_value") @db.Decimal(12, 4)
  minValue         Decimal?             @map("min_value") @db.Decimal(12, 4)
  maxValue         Decimal?             @map("max_value") @db.Decimal(12, 4)
  unit             String
  note             String?
  displayOrder     Int                  @default(0) @map("display_order")

  @@unique([recipeVersionId, variable, moment])
  @@index([recipeVersionId])
  @@map("process_target")
  @@schema("traceability")
}

/// When in a run a target applies. Three, because that is what the domain has:
/// a reading at the start (original gravity/Brix), readings along the way that
/// tell you whether to keep going, and a reading at the end (final gravity, pH
/// drop) that says the run is done.
enum ProcessTargetMoment {
  initial
  during
  final

  @@schema("traceability")
}

model FermentationIntervention {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fermentationRunId String                       @map("fermentation_run_id") @db.Uuid
  fermentationRun   FermentationRun              @relation(fields: [fermentationRunId], references: [id])
  interventionType  FermentationInterventionType @map("intervention_type")
  occurredAt        DateTime                     @map("occurred_at")
  notes             String?
  createdAt         DateTime                     @default(now()) @map("created_at")
  createdBy         String?                      @map("created_by") @db.Uuid
  creator           UserAccount?                 @relation("FermentationInterventionCreatedBy", fields: [createdBy], references: [id])

  @@index([fermentationRunId])
  @@map("fermentation_intervention")
  @@schema("traceability")
}

// §16's own sketch left DryingTurnEvent.eventType a plain String
// ('turned'|'covered'|'uncovered' as an inline comment) — made a real enum
// here instead, matching FermentationInterventionType's precedent (T6) and
// this codebase's general practice of typed enums with an `other` escape
// valve over unvalidated strings for closed vocabularies.
enum DryingTurnEventType {
  turned
  covered
  uncovered
  other

  @@schema("traceability")
}

// Same shape and lifecycle as FermentationRun (T6) — no lotId of its own;
// which Lot is drying is expressed via the stage_change LotTransformation(s)
// that reference this run. locationId (the drying site/bed) is descriptive
// context only, not a second RBAC gate — access is still resolved against
// the source lot's own project/location, same as every other traceability
// write path in this module.
model DryingRun {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  method       String? // 'raised_bed' | 'patio' | 'mechanical' | free text — §16
  locationId   String?      @map("location_id") @db.Uuid
  location     Location?    @relation(fields: [locationId], references: [id])
  layerDepthCm Decimal?     @map("layer_depth_cm") @db.Decimal(6, 2)
  startedAt    DateTime     @map("started_at")
  endedAt      DateTime?    @map("ended_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  createdBy    String?      @map("created_by") @db.Uuid
  creator      UserAccount? @relation("DryingRunCreatedBy", fields: [createdBy], references: [id])

  turningEvents              DryingTurnEvent[]
  measurements               Measurement[]
  transformations            LotTransformation[]
  assets                     Asset[]
  labourEntries              LabourEntry[]
  materialConsumptionEntries MaterialConsumptionEntry[]

  @@index([locationId])
  @@map("drying_run")
  @@schema("traceability")
}

model DryingTurnEvent {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dryingRunId      String              @map("drying_run_id") @db.Uuid
  dryingRun        DryingRun           @relation(fields: [dryingRunId], references: [id])
  eventType        DryingTurnEventType @map("event_type")
  occurredAt       DateTime            @map("occurred_at")
  operatorPersonId String?             @map("operator_person_id") @db.Uuid
  operator         Person?             @relation("DryingTurnEventOperator", fields: [operatorPersonId], references: [id])
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  createdBy        String?             @map("created_by") @db.Uuid
  creator          UserAccount?        @relation("DryingTurnEventCreatedBy", fields: [createdBy], references: [id])

  @@index([dryingRunId])
  @@map("drying_turn_event")
  @@schema("traceability")
}

// R1 (docs/implementation/33_R1_ROASTSESSION_TAXONOMIA_SENSORIAL.md §1). Same
// shape and lifecycle as FermentationRun/DryingRun — no lotId of its own;
// which green Lot went in and which roast Lot came out is expressed through
// the stage_change LotTransformation this run brackets, via
// LotTransformation.roastSessionId (matching fermentationRunId/dryingRunId's
// exact precedent), never a direct FK here.
//
// The already-verified case — one green Lot roasted three ways, recorded
// as one `split` LotTransformation with three outputs (§1.1, "eso no se
// toca") — isn't reused directly, because each of the three roasts is a
// genuinely separate execution (different roaster, equipment, profile,
// timing), which this entity's one-run-per-transformation shape can't
// express if three roasts shared one transformation row. Recording each
// roast as its own `stage_change` transformation (same input green Lot,
// one output roast Lot each) produces the identical queryable DAG shape —
// getLotLineage's recursive CTE follows lot_transformation_input/output
// edges generically, indifferent to whether three children came from one
// transformation row or three — without touching recordTransformation or
// the split mechanism at all.
//
// roasterPersonId is deliberately a first-class, queryable FK, not folded
// into notes: "el tostador es una variable del experimento, no solo un
// actor" (§1.3) — the case this ticket exists for is the same coffee
// roasted by two roasters on two machines, compared side by side.
//
// equipmentNote stays free text, matching FermentationRun.vesselNote's own
// precedent exactly — no Equipment entity exists yet
// (18_EQUIPMENT_AND_READINESS_PROMPT_REVISED.md, still V2).
//
// No curve/profile columns here — first/second crack are the two
// universally-named checkpoints every roast log tracks regardless of
// equipment, so they get real columns; every other curve point (bean/air
// temperature over time) is recorded as ordinary Measurement rows via the
// new Measurement.roastSessionId FK below, reusing the exact generalized
// mechanism T3 already built and T7 already proved works for a run-scoped
// series, rather than a new time-series table or an opaque file reference.
model RoastSession {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roastLevel        String?      @map("roast_level") // free text ("claro filtro", "medio espresso") — vocabulary varies by market/style, not a closed enum
  equipmentNote     String?      @map("equipment_note")
  roasterPersonId   String?      @map("roaster_person_id") @db.Uuid
  roaster           Person?      @relation("RoastSessionRoaster", fields: [roasterPersonId], references: [id])
  chargeWeightKg    Decimal?     @map("charge_weight_kg") @db.Decimal(10, 3)
  dischargeWeightKg Decimal?     @map("discharge_weight_kg") @db.Decimal(10, 3)
  startedAt         DateTime     @map("started_at")
  endedAt           DateTime?    @map("ended_at")
  firstCrackAt      DateTime?    @map("first_crack_at")
  secondCrackAt     DateTime?    @map("second_crack_at")
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  createdBy         String?      @map("created_by") @db.Uuid
  creator           UserAccount? @relation("RoastSessionCreatedBy", fields: [createdBy], references: [id])

  measurements    Measurement[]
  transformations LotTransformation[]

  @@index([roasterPersonId])
  @@map("roast_session")
  @@schema("traceability")
}

// T12.6 (docs/implementation/20_CAPTURE_OR_LOSE_IT_REPORT.md §2). Labour
// time is entirely irrecoverable if not captured during the harvest
// window (ADR-044's capture-or-lose-it clause) — no payroll/timesheet
// system exists elsewhere in the platform to reconstruct it from later.
//
// Deliberately no lotId — every parent here (HarvestEvent/ReceivingEvent/
// FermentationRun/DryingRun) already sits on the genealogy DAG, so labour
// inherits lineage for free without a second, potentially ambiguous
// attachment point. Aggregate headcount + duration, not named individuals
// or clock-in/out — the field-form reality (§3) is "four people, three
// hours," not a timesheet; named identity and precise timestamps are on
// the deliberately-not-captured list (§4), a real, stated choice, not an
// oversight.
model LabourEntry {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  harvestEventId    String?          @map("harvest_event_id") @db.Uuid
  harvestEvent      HarvestEvent?    @relation(fields: [harvestEventId], references: [id])
  receivingEventId  String?          @map("receiving_event_id") @db.Uuid
  receivingEvent    ReceivingEvent?  @relation(fields: [receivingEventId], references: [id])
  fermentationRunId String?          @map("fermentation_run_id") @db.Uuid
  fermentationRun   FermentationRun? @relation(fields: [fermentationRunId], references: [id])
  dryingRunId       String?          @map("drying_run_id") @db.Uuid
  dryingRun         DryingRun?       @relation(fields: [dryingRunId], references: [id])
  // F1 (30_F1_OPERACION_FINCA_ESQUEMA.md §4) — a fifth nullable parent,
  // ADR-020 decision 8's pattern extended rather than reworked. Digging
  // 600 holes or clearing an apiary site is real labour with no batch to
  // attach to yet — "el trabajo se registra contra el lugar donde ocurre."
  locationId        String?          @map("location_id") @db.Uuid
  location          Location?        @relation(fields: [locationId], references: [id])

  workerCount Int     @map("worker_count")
  hours       Decimal @db.Decimal(6, 2)
  taskNote    String? @map("task_note")

  // In-kind flag — labour provided by a third party (a partner, a
  // neighboring farm), not Néctar Nómada's own. Rides this table rather
  // than a new one; optional, off by default (§3).
  providedByOrganizationId String?       @map("provided_by_organization_id") @db.Uuid
  providedByOrganization   Organization? @relation(fields: [providedByOrganizationId], references: [id])

  occurredAt       DateTime @default(now()) @map("occurred_at")
  operatorPersonId String?  @map("operator_person_id") @db.Uuid
  operator         Person?  @relation("LabourEntryOperator", fields: [operatorPersonId], references: [id])

  // Required, no default — a photo/labour tally is a fact-bearing record
  // (ADR-038's reasoning, same as T12.5's Asset.provenanceClass).
  // dataQuality is the separate "how much do we trust it" axis (verified
  // vs. provisional) — a same-day headcount and a next-morning
  // recollection can both be direct_observation, differing only here.
  provenanceClass ProvenanceClass @map("provenance_class")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("LabourEntryCreatedBy", fields: [createdBy], references: [id])

  @@index([harvestEventId])
  @@index([receivingEventId])
  @@index([fermentationRunId])
  @@index([dryingRunId])
  @@index([locationId])
  @@map("labour_entry")
  @@schema("traceability")
}

// T12.6 (§2). Batch-identified material consumption (yeast, cultures,
// nutrients, treatments) — the batch is the irrecoverable identity fact;
// a fermentation result isn't fully interpretable later without knowing
// which culture batch produced it. Scoped to fermentation/drying only
// (the two stages the source report names) — not lotId, same DAG
// reasoning as LabourEntry above. materialName/batchLabel are free text,
// not an FK to a Consumable entity — none exists yet (`18_
// EQUIPMENT_AND_READINESS_PROMPT_REVISED.md` owns that model); these
// columns are a natural later FK-swap target once it ships, not this
// ticket's migration to write. Deliberately not stock-linked — this
// table records the fact of consumption, never decrements a balance.
model MaterialConsumptionEntry {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fermentationRunId String?          @map("fermentation_run_id") @db.Uuid
  fermentationRun   FermentationRun? @relation(fields: [fermentationRunId], references: [id])
  dryingRunId       String?          @map("drying_run_id") @db.Uuid
  dryingRun         DryingRun?       @relation(fields: [dryingRunId], references: [id])
  // F1 §4 — same pattern as LabourEntry.locationId above: nutrients,
  // biochar, and lime applied to a plot before any batch exists.
  locationId        String?          @map("location_id") @db.Uuid
  location          Location?        @relation(fields: [locationId], references: [id])

  materialName String   @map("material_name")
  batchLabel   String   @map("batch_label")
  quantity     Decimal? @db.Decimal(10, 3)
  unit         String?

  occurredAt       DateTime @default(now()) @map("occurred_at")
  operatorPersonId String?  @map("operator_person_id") @db.Uuid
  operator         Person?  @relation("MaterialConsumptionEntryOperator", fields: [operatorPersonId], references: [id])

  // Required, no default — same reasoning as LabourEntry.provenanceClass
  // above. Fixed to direct_observation at the action layer for every
  // call site (app/actions/traceability.ts) — none of these entries has
  // a genuinely ambiguous provenance the way a lab-reported measurement
  // sometimes does, so no operator-facing picker is exposed for it.
  provenanceClass ProvenanceClass @map("provenance_class")
  dataQuality     DataQuality?    @map("data_quality")
  notes           String?

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("MaterialConsumptionEntryCreatedBy", fields: [createdBy], references: [id])

  @@index([fermentationRunId])
  @@index([dryingRunId])
  @@index([locationId])
  @@map("material_consumption_entry")
  @@schema("traceability")
}

// F1 (30_F1_OPERACION_FINCA_ESQUEMA.md §4) — "Siembra"/"Recepción de
// material vegetal" carry origin+varietal+quantity semantics that don't
// fit LabourEntry (hours/workers) or MaterialConsumptionEntry (a
// materialName+batchLabel consumed against a fermentation/drying run).
// Reusing ReceivingEvent (T4) was considered and rejected: that table
// produces a `Lot` and carries coffee-cherry-specific fields
// (cherryWeightKg/brix/temperatureC) — seedlings arriving at a nursery
// aren't processable material entering the traceability chain, so forcing
// them through ReceivingEvent would be the same kind of conflation
// CLAUDE.md §18 already warns against for Species/Cultivar. A small,
// single-purpose new entity, same shape as HarvestEvent/ReceivingEvent —
// not a general-purpose parallel table.
// P2 (43_P2_OPERATOR_CORE.md §3). The envelope for one visit: "Kenneth went to
// Lote 3 on Tuesday morning and did these eleven things."
//
// Nothing expressed that before. Every existing event table is anchored to its
// own domain parent — a run, a colony, a stage — never to a visit, so the
// chronology of a person's actual working session existed nowhere.
//
// This is also the natural **offline transaction boundary** and the natural
// unit of selective sync (audit §17): a device pulls the sessions assigned to
// its operator and pushes them back whole. Getting its shape right here is
// what makes Phase 4 tractable.
//
// `operatorPersonId` is a **Person, not a UserAccount**, deliberately. Most
// Person rows in this database have no email and therefore no account, and a
// session recorded by someone who cannot log in is the normal case, not the
// exception.
model FieldSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  operatorPersonId String @map("operator_person_id") @db.Uuid
  operator         Person @relation("FieldSessionOperator", fields: [operatorPersonId], references: [id])

  // Nullable: a session may be unplanned. Somebody walking a block because
  // they noticed something is a real session, and refusing to record it
  // without a task first would push it back to memory.
  taskId String? @map("task_id") @db.Uuid
  task   Task?   @relation(fields: [taskId], references: [id])

  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  // Where the session began. Nullable — a device without a fix, or a session
  // recorded at a desk afterwards, both genuinely have no coordinates, and a
  // fabricated one is worse than none.
  startLatitude  Float? @map("start_latitude")
  startLongitude Float? @map("start_longitude")
  startAccuracyM Float? @map("start_accuracy_m")

  notes String?

  provenanceClass ProvenanceClass @map("provenance_class")
  dataQuality     DataQuality?    @map("data_quality")

  // P2 §5 — see the Measurement comment for the full reasoning.
  recordedAt DateTime? @map("recorded_at")
  syncedAt   DateTime? @map("synced_at")
  deviceId   String?   @map("device_id") @db.Uuid

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("FieldSessionCreatedBy", fields: [createdBy], references: [id])

  events FieldEvent[]

  @@index([locationId])
  @@index([operatorPersonId])
  @@index([taskId])
  @@index([startedAt])
  @@map("field_session")
  @@schema("traceability")
}

// P2 (43_P2_OPERATOR_CORE.md §4). A chronological **spine**, not a replacement.
//
// The temptation is one generic event table that FermentationIntervention,
// DryingTurnEvent, SpecimenObservation, QuantityEvent and
// ProcessingStageObservation all migrate into. That would degrade their
// domain-specific typed columns into JSON — precisely what CLAUDE.md §49
// forbids — and lose the validation each of them carries.
//
// So this table owns no domain semantics. It records *when, where and by whom*
// something happened during a session, and points at the row that holds *what*
// through a nullable FK per parent — the same ADR-020 decision 8 pattern
// `Asset` already applies fifteen times. The result is one queryable timeline
// over heterogeneous events, with every domain table left intact.
//
// `eventKindValueId` is a VariableCatalog value rather than an enum: what an
// operator might record will keep growing, and P1 established that a growing
// vocabulary is a catalog entry plus a re-seed, never a migration.
model FieldEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldSessionId String       @map("field_session_id") @db.Uuid
  fieldSession   FieldSession @relation(fields: [fieldSessionId], references: [id], onDelete: Cascade)

  eventKindValueId String               @map("event_kind_value_id") @db.Uuid
  eventKindValue   VariableCatalogValue @relation("FieldEventKind", fields: [eventKindValueId], references: [id])

  occurredAt DateTime @map("occurred_at")

  latitude  Float? @map("latitude")
  longitude Float? @map("longitude")
  accuracyM Float? @map("accuracy_m")

  operatorPersonId String? @map("operator_person_id") @db.Uuid
  operator         Person? @relation("FieldEventOperator", fields: [operatorPersonId], references: [id])

  notes String?

  // The row that holds what actually happened. At most one is set; the event
  // is still valid with none (a bare observation with only notes and a
  // position is a real thing an operator records).
  measurementId         String?              @map("measurement_id") @db.Uuid
  measurement           Measurement?         @relation(fields: [measurementId], references: [id])
  quantityEventId       String?              @map("quantity_event_id") @db.Uuid
  quantityEvent         QuantityEvent?       @relation(fields: [quantityEventId], references: [id])
  specimenObservationId String?              @map("specimen_observation_id") @db.Uuid
  specimenObservation   SpecimenObservation? @relation(fields: [specimenObservationId], references: [id])
  assetId               String?              @map("asset_id") @db.Uuid
  asset                 Asset?               @relation(fields: [assetId], references: [id])
  harvestEventId        String?              @map("harvest_event_id") @db.Uuid
  harvestEvent          HarvestEvent?        @relation(fields: [harvestEventId], references: [id])
  lotTransformationId   String?              @map("lot_transformation_id") @db.Uuid
  lotTransformation     LotTransformation?   @relation(fields: [lotTransformationId], references: [id])

  provenanceClass ProvenanceClass @map("provenance_class")

  recordedAt DateTime? @map("recorded_at")
  syncedAt   DateTime? @map("synced_at")
  deviceId   String?   @map("device_id") @db.Uuid

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("FieldEventCreatedBy", fields: [createdBy], references: [id])

  @@index([fieldSessionId])
  @@index([occurredAt])
  @@index([eventKindValueId])
  @@index([measurementId])
  @@index([assetId])
  @@map("field_event")
  @@schema("traceability")
}

// P1 (42_P1_LAND_FOUNDATION.md §1) — renovation is a *new* cohort, never an
// edit to the old one. A stumped and replanted block leaves the previous
// cohort `removed` with a removedAt, and what stood there stays true; same
// version-preservation rule as ProtocolVersion and Assessment.
enum PlantingCohortStatus {
  active
  removed
  renovated

  @@schema("traceability")
}

// P1 §1 — the standing population in a block: what is planted, how old, how
// dense. The one genuine gap on the land side.
//
// Three things partially answered this and none answered it. `PlantingEvent`
// records *that* material arrived or went into the ground — an event, not a
// population, and there was exactly one row. `Specimen` tracks *individual*
// plants and traps, which is right for the broca traps and far too granular
// for four thousand trees. `Location.plantSpacingMeters` is a single value
// for a whole plot.
model PlantingCohort {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  // Nullable and must stay so: a block whose cultivar nobody is sure of is an
  // ordinary situation, and `desconocido` recorded honestly beats a guess
  // promoted to a fact (CLAUDE.md §3). Points at the `cultivar`
  // VariableCatalog (§2) rather than a Species/Cultivar taxonomy — those are
  // specified in DOMAIN_MODEL.md §4 and have now been declined three times.
  cultivarValueId String?               @map("cultivar_value_id") @db.Uuid
  cultivarValue   VariableCatalogValue? @relation("PlantingCohortCultivar", fields: [cultivarValueId], references: [id])

  // `plantedPrecision` reuses S1's HarvestWindowPrecision rather than
  // inventing a second precision vocabulary. "Sembrado en 2019" and "sembrado
  // el 14 de marzo de 2019" are different claims, and a producer usually knows
  // the first and not the second — forcing a full date would manufacture
  // precision that does not exist.
  plantedAt        DateTime?               @map("planted_at")
  plantedPrecision HarvestWindowPrecision? @map("planted_precision")

  plantCount        Int?     @map("plant_count")
  densityPerHectare Decimal? @map("density_per_hectare") @db.Decimal(10, 2)
  spacingMeters     Decimal? @map("spacing_meters") @db.Decimal(5, 2)

  status    PlantingCohortStatus @default(active)
  removedAt DateTime?            @map("removed_at")
  notes     String?

  // ADR-038 — required, no default. A cohort recorded from a planting record
  // is an original_record; one reconstructed from a producer's memory years
  // later is not, and the difference is exactly what dataQuality is for.
  provenanceClass ProvenanceClass @map("provenance_class")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("PlantingCohortCreatedBy", fields: [createdBy], references: [id])

  plantingEvents      PlantingEvent[]
  specimens           Specimen[]
  harvestEventSources HarvestEventSource[]

  @@index([locationId])
  @@index([cultivarValueId])
  @@map("planting_cohort")
  @@schema("traceability")
}

// P1 §5 — a harvest drawing from several blocks.
//
// `HarvestEvent.locationId` deliberately stays required and unchanged: it is
// the primary plot, the one a single-block harvest names, and the one V1's own
// test asserts is structurally required. These rows are *additional*
// contributions, and a single-block harvest simply has none — which keeps
// every existing row valid and every existing query correct, as a
// nullable-and-migrate approach would not.
model HarvestEventSource {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  harvestEventId String       @map("harvest_event_id") @db.Uuid
  harvestEvent   HarvestEvent @relation(fields: [harvestEventId], references: [id], onDelete: Cascade)
  locationId     String       @map("location_id") @db.Uuid
  location       Location     @relation(fields: [locationId], references: [id])

  plantingCohortId String?         @map("planting_cohort_id") @db.Uuid
  plantingCohort   PlantingCohort? @relation(fields: [plantingCohortId], references: [id])

  cherryWeightKg Decimal? @map("cherry_weight_kg") @db.Decimal(10, 3)
  notes          String?

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("HarvestEventSourceCreatedBy", fields: [createdBy], references: [id])

  @@unique([harvestEventId, locationId, plantingCohortId])
  @@index([harvestEventId])
  @@index([locationId])
  @@index([plantingCohortId])
  @@map("harvest_event_source")
  @@schema("traceability")
}

// S1 (45_S1_SUELO_AMBIENTE_TAZA.md §2, semanas 6–10) — la muestra de suelo que
// va al laboratorio.
//
// **La muestra y el resultado son dos cosas distintas y no se funden.** Aquí
// vive la muestra: de dónde salió, de qué profundidad, de cuántas submuestras
// se compuso, a qué laboratorio fue y con qué método se extrajo. Los resultados
// de la Tabla 3 son `Measurement` —lecturas con unidad, procedencia y calidad
// de dato, corregibles sin borrar la original— colgados de esta fila.
//
// **Por qué no reusar `Sample`.** `Sample` es de café: lleva `sourceLotId`,
// `sourceTransformationId`, `externalOrigin`, códigos ciegos de sensorial y
// entradas de competencia. Ninguno de esos campos significa nada para un puñado
// de tierra. Es la misma línea que ya se trazó entre `Specimen` y `Lot`.
model SoilSample {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sampleCode String @map("sample_code")

  // El bloque, y el ancla de RBAC.
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  // La parcela de tratamiento dentro del bloque. Texto por ahora: el diseño del
  // ensayo (T0–T4, bloques al azar con repeticiones) es el Paso 8 y todavía no
  // existe como entidad. Cuando exista, esto pasa a ser una clave — pero el
  // muestreo del Paso 6 ocurre ANTES y no puede esperar a que el ensayo esté
  // trazado.
  treatmentPlotLabel String? @map("treatment_plot_label")

  // El punto permanente y etiquetado de §14.1, «para que las rondas siguientes
  // vuelvan al mismo sitio». Sin él, una serie temporal de química de suelo
  // compara sitios distintos y lo llama cambio.
  samplingPointLabel String? @map("sampling_point_label")

  // §14.1 pide 0–20, 20–40 y 40–60 cm «aproximadamente». Dos enteros y no un
  // enum de tres bandas justamente por ese «aproximadamente»: una cuarta
  // profundidad o un 0–15 real no deben obligar a mentir ni a migrar.
  depthTopCm    Int? @map("depth_top_cm")
  depthBottomCm Int? @map("depth_bottom_cm")

  sampledAt DateTime @map("sampled_at")

  // §14.1: «10–15 submuestras a la misma profundidad dentro de una parcela,
  // mezcladas, y una submuestra representativa enviada. Compositar dentro de
  // una parcela y una profundidad; NUNCA entre tratamientos ni entre
  // profundidades.» Esa regla es estructural aquí: una fila ES un compuesto de
  // una parcela y una profundidad, y el conteo dice de cuántas.
  subSampleCount Int? @map("sub_sample_count")

  laboratory String?
  // «El fósforo es muy dependiente del método — anotar el extractante»
  // (Tabla 3). Un P Bray y un P Mehlich no se comparan, y sin esto un
  // histórico de fósforo mezcla dos escalas sin avisar.
  extractionMethod String? @map("extraction_method")

  notes String?

  // ADR-038 — requerido, sin default.
  provenanceClass ProvenanceClass @map("provenance_class")
  sourceReference String?         @map("source_reference")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("SoilSampleCreatedBy", fields: [createdBy], references: [id])

  measurements Measurement[]

  @@unique([locationId, sampleCode])
  @@index([locationId])
  @@map("soil_sample")
  @@schema("traceability")
}

// S1 §2 (semanas 6–10) — la muestra foliar.
//
// §7.1 es el motivo de que casi todos estos campos existan: «la concentración
// foliar varía sistemáticamente con la posición de la hoja, su edad, el
// cultivar, el estado fenológico y la estación. Si el muestreo no está
// estandarizado, la comparación entre años **no significa nada** y las
// diferencias entre tratamientos quedan ahogadas por el ruido del muestreo.»
//
// Por eso el marco enumera lo que hay que **registrar en cada muestra**, y esa
// lista es literalmente esta tabla. Un análisis foliar sin su protocolo no es
// un dato peor: es un dato incomparable, que es peor que no tenerlo porque
// parece que sirve.
model FoliarSample {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sampleCode String @map("sample_code")

  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  treatmentPlotLabel String? @map("treatment_plot_label")

  sampledAt DateTime @map("sampled_at")

  // «El par de hojas definido — normalmente el tercero o cuarto contando desde
  // la punta». Un entero, no un enum: el marco dice explícitamente que fijar el
  // número exacto es un acuerdo con el laboratorio, no una constante nuestra.
  leafPairPosition Int? @map("leaf_pair_position")

  // «Posición de la rama en el dosel (tercio superior, medio, inferior)» — la
  // lista la da el marco, así que aquí sí se enumera.
  canopyPosition CanopyPosition? @map("canopy_position")

  // «Edad del árbol y cultivar», «estado fenológico al muestrear».
  treeAgeYears        Int?    @map("tree_age_years")
  cultivar            String?
  phenologicalStage   String? @map("phenological_stage")

  // «Y si la rama muestreada llevaba fruto». Booleano nullable y no tres
  // estados como en la calicata: aquí no hay «no se miró» plausible — quien
  // arranca la hoja tiene la rama en la mano. `null` sigue siendo «no
  // registrado».
  branchBearingFruit Boolean? @map("branch_bearing_fruit")

  laboratory String?
  notes      String?

  provenanceClass ProvenanceClass @map("provenance_class")
  sourceReference String?         @map("source_reference")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("FoliarSampleCreatedBy", fields: [createdBy], references: [id])

  measurements Measurement[]

  @@unique([locationId, sampleCode])
  @@index([locationId])
  @@map("foliar_sample")
  @@schema("traceability")
}

// §7.1 — «tercio superior, medio o inferior». La lista es del marco.
enum CanopyPosition {
  upper
  middle
  lower

  @@schema("traceability")
}

// S1 (45_S1_SUELO_AMBIENTE_TAZA.md §2, semanas 3–6) — la calicata: la
// descripción del perfil de suelo de un bloque.
//
// El marco es inusualmente rotundo sobre este paso: «cuesta casi nada y
// probablemente producirá la observación más útil del Año 0» (Paso 4), y §19 lo
// llama la actividad de mayor valor y menor coste de todo el programa. La razón
// está en §6.1: humedad alta y encharcamiento **no son lo mismo**, y confundirlos
// lleva a la intervención equivocada. Un suelo húmedo y bien estructurado es un
// activo; uno húmedo y compactado, o húmedo sobre una capa de arcilla que
// impide, es un techo de rendimiento y de taza que ningún programa de
// fertilización levanta. Lo que distingue los dos casos **se ve en la calicata**
// y en ningún otro sitio.
//
// Descripción, no análisis: **no depende de ningún laboratorio**, y por eso
// puede aterrizar antes que nada químico. Las cifras físicas —densidad aparente,
// resistencia a la penetración, infiltración— llegan con la ronda de muestreo
// del Paso 6 y son `Measurement`, no columnas de aquí.
model SoilProfile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // El bloque descrito, y el ancla de RBAC. Requerido: una descripción de
  // perfil que no diga de qué suelo habla no describe nada.
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])

  // Requerida. Una calicata es una observación de un día, y §14 pide repetirla:
  // la del Año 0 y la de dentro de tres años son dos filas, no una editada. Lo
  // que se corrige con PATCH es una errata de transcripción; volver a describir
  // el mismo bloque es una fila nueva.
  describedAt DateTime @map("described_at")

  // El Paso 4 pide 80–100 cm «donde el terreno lo permita», así que la
  // profundidad alcanzada es un dato y no un supuesto: una calicata de 40 cm
  // porque salió roca dice algo, y decir que llegó a 100 sería falso.
  pitDepthCm Int? @map("pit_depth_cm")

  // «El número más importante para la salud radicular en este tipo de suelo»
  // (§5). Las raíces finas del café se concentran arriba, así que una
  // restricción somera hace un daño desproporcionado.
  rootingDepthCm   Int?    @map("rooting_depth_cm")
  rootDistribution String? @map("root_distribution")

  // §6.1 — las tres señales visuales de anaerobiosis periódica, más el olor.
  // Cada una por separado y con tres estados, no un booleano: «no se miró» y
  // «se miró y no había» son hechos distintos (ADR-080), y un booleano nullable
  // los confunde en cuanto alguien lee `!mottling`.
  mottling               SoilFeatureObservation? @map("mottling")
  greyColours            SoilFeatureObservation? @map("grey_colours")
  rootChannelConcretions SoilFeatureObservation? @map("root_channel_concretions")
  sourSmell              SoilFeatureObservation? @map("sour_smell")

  // La capa que impide, si la hay. La profundidad va aparte de la nota porque
  // es la cifra que decide si el problema es de drenaje o de nutrición.
  impedingLayerDepthCm Int?    @map("impeding_layer_depth_cm")
  impedingLayerNote    String? @map("impeding_layer_note")

  notes String?

  // ADR-038 — requerido, sin default. Una calicata descrita por quien la cavó
  // es `direct_observation`; una transcrita de la libreta de otro no lo es.
  provenanceClass ProvenanceClass @map("provenance_class")
  sourceReference String?         @map("source_reference")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("SoilProfileCreatedBy", fields: [createdBy], references: [id])

  horizons SoilHorizon[]
  assets   Asset[]

  @@index([locationId])
  @@map("soil_profile")
  @@schema("traceability")
}

// Un horizonte del perfil. Tabla hija y no un bloque de texto en `SoilProfile`
// porque el Paso 4 pide describir **los horizontes** —en plural— con color,
// estructura y textura al tacto cada uno, y porque la profundidad a la que
// cambia el material es justo lo que hay que poder comparar entre bloques y
// entre años. Un párrafo no se compara.
model SoilHorizon {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  soilProfileId String      @map("soil_profile_id") @db.Uuid
  soilProfile   SoilProfile @relation(fields: [soilProfileId], references: [id], onDelete: Cascade)

  // Orden desde la superficie. Explícito y no derivado de `topCm`, porque un
  // horizonte cuya profundidad nadie midió sigue teniendo un sitio en la
  // secuencia observada.
  ordinal Int

  topCm    Int? @map("top_cm")
  bottomCm Int? @map("bottom_cm")

  // «A», «Bt», «C»… Texto libre y no un enum: la nomenclatura de horizontes es
  // un sistema entero, el marco no da lista, y quien describe puede no usarla.
  designation String?

  // Color, estructura y textura al tacto. Los tres en texto por la misma razón
  // que `Location.slopeDescription`: son descripciones, y el marco no enumera
  // valores. El color puede venir en notación Munsell o en palabras; forzar una
  // sola forma perdería la que el describiente sí sabe dar.
  colour        String?
  structure     String?
  textureByFeel String? @map("texture_by_feel")

  notes String?

  @@unique([soilProfileId, ordinal])
  @@index([soilProfileId])
  @@map("soil_horizon")
  @@schema("traceability")
}

// §6.1 — tres estados, no dos. «Presente» y «ausente» son las dos
// observaciones; `not_observed` es la tercera, y existe porque quien describe
// una calicata a veces no busca una señal concreta, y un hueco que se lea como
// «no había» convierte una omisión en un hallazgo.
enum SoilFeatureObservation {
  present
  absent
  not_observed

  @@schema("traceability")
}

// S1 (45_S1_SUELO_AMBIENTE_TAZA.md §2, semanas 1–4) — el lote de biochar, con
// los campos de la Tabla 6 del marco de investigación.
//
// **Por qué entidad propia y no `Lot`.** Un lote de biochar no recorre la
// cadena de trazabilidad del café: no se cosecha, no se fermenta, no se cata, y
// el balance de masa no tiene nada que decir sobre él. Reusar `Lot` obligaría a
// un `lotType` que no describe nada y pondría la maquinaria de conservación a
// opinar sobre un material que no es café.
//
// **Por qué no es `TreatmentBatch` tampoco.** Ese modela la ejecución de un
// protocolo sobre material que se procesa. Esto es materia prima producida
// antes y con independencia de cualquier experimento; el vínculo entre ambos lo
// hará la aplicación de enmienda (§2, semanas 10–14), que está pendiente de una
// decisión del dueño.
//
// **§9.2 del marco se titula «Biochar is not one material»**, y ése es el punto
// entero: sin régimen térmico, materia prima y carga documentados, «10 t/ha de
// biochar» describe un volumen, no un tratamiento (§10.1). Por eso casi todo
// aquí es nullable pero nada tiene default: lo que no se midió queda vacío, y
// vacío se lee como «sin registrar», nunca como cero (ADR-080).
model BiocharBatch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // «LN-BC-2026-001» en el ejemplo del marco. Único por organización, mismo
  // razonamiento que `Lot.lotCode`: dos fincas pueden numerar desde 001.
  batchCode      String       @map("batch_code")
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Dónde se PRODUJO, que no es dónde se aplicará. Se llama así justamente
  // para que nadie lo confunda con la parcela tratada: un lote se quema una vez
  // y puede aplicarse en varios bloques, a dosis distintas y en fechas
  // distintas — por eso «dosis», «frecuencia» y «parcela», que la Tabla 6 lista
  // aquí porque es un formulario de papel, viven en la aplicación de enmienda y
  // no en esta fila.
  //
  // Requerido, y no sólo porque todo lote se hace en algún sitio: es el ancla
  // de RBAC. Sin un ámbito concreto contra el que resolver, no hay autorización
  // que comprobar.
  producedAtLocationId String   @map("produced_at_location_id") @db.Uuid
  producedAtLocation   Location @relation("BiocharBatchProducedAt", fields: [producedAtLocationId], references: [id])

  // Nullable a propósito: el Paso 2 del plan de acción es documentar lo que Bob
  // **ya hace**, y un lote descrito de memoria puede no tener fecha exacta. El
  // envejecimiento (Tabla 6, «Aging») se deriva de esta fecha y la de
  // aplicación al leer; no se guarda, porque las dos entradas se pueden
  // corregir — misma regla que densidad y rendimiento.
  producedAt DateTime? @map("produced_at")

  // --- Materia prima -------------------------------------------------------
  // Texto libre, no un enum, y es deliberado. §9.2 sí distingue clases que
  // importan —madera, residuo de cosecha, gallinaza— pero la Tabla 6 pide
  // «tipo de material y proporciones si va mezclado», que es una descripción,
  // no una casilla. Inventar aquí un vocabulario cerrado es exactamente lo que
  // `Location.slopeDescription` decidió no hacer.
  feedstock       String?
  feedstockSource String? @map("feedstock_source")

  // --- Régimen térmico -----------------------------------------------------
  moistureCondition   BiocharMoistureCondition? @map("moisture_condition")
  kilnDesign          String?                   @map("kiln_design")
  // «Aproximada donde sea medible; anotar el método» — por eso van juntos. Un
  // 550 leído con termopar y un 550 estimado por el color de la llama son
  // afirmaciones distintas, y sin el método no se distinguen.
  peakTemperatureC    Int?                      @map("peak_temperature_c")
  temperatureMethod   String?                   @map("temperature_method")
  burnDurationMinutes Int?                      @map("burn_duration_minutes")
  timeAtPeakMinutes   Int?                      @map("time_at_peak_minutes")
  // «La variable que separa pirólisis de combustión.»
  oxygenManagement    String?                   @map("oxygen_management")

  // --- Enfriado y forma ----------------------------------------------------
  cooling           BiocharCooling? @map("cooling")
  quenchWaterSource String?         @map("quench_water_source")
  particleSize      String?         @map("particle_size")
  storageConditions String?         @map("storage_conditions")

  // --- Carga ---------------------------------------------------------------
  // «Determina si el material actúa de portador de nutrientes o de sumidero»:
  // un biochar sin cargar puede adsorber nitrógeno del suelo al principio.
  chargingMaterial     String?  @map("charging_material")
  chargingRatio        String?  @map("charging_ratio")
  coComposted          Boolean? @map("co_composted")
  chargingDurationDays Int?     @map("charging_duration_days")

  // --- Laboratorio ---------------------------------------------------------
  // Sólo cuál. Los resultados de la Tabla 7 son `Measurement` —lecturas con
  // unidad, procedencia y calidad de dato, corregibles sin borrar la
  // original— y todavía no están conectados: `recordMeasurement` exige hoy un
  // Lot o un Sample como sujeto, y admitir un tercero exige darle su propia
  // ruta de ámbito. Es el paso siguiente, no éste.
  analysisLaboratory String? @map("analysis_laboratory")

  notes String?

  // ADR-038 — requerido, sin default. Un lote transcrito del cuaderno de Bob
  // mientras quemaba es `original_record`; uno reconstruido de memoria dos años
  // después no lo es, y fingir que sí es justo el fallo que esta columna existe
  // para impedir.
  provenanceClass ProvenanceClass @map("provenance_class")
  sourceReference String?         @map("source_reference")
  dataQuality     DataQuality?    @map("data_quality")

  // S1 §2 — la caracterización de la Tabla 7. Cada parámetro (pH, CEC, ceniza,
  // carbono, N, macros) es una lectura con unidad, procedencia y calidad de
  // dato, corregible sin borrar la original: eso es `Measurement`, no una
  // columna por parámetro en esta tabla.
  measurements Measurement[]
  assets       Asset[]

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("BiocharBatchCreatedBy", fields: [createdBy], references: [id])

  @@unique([organizationId, batchCode])
  @@index([organizationId])
  @@index([producedAtLocationId])
  @@map("biochar_batch")
  @@schema("traceability")
}

// Tabla 6, «Moisture condition»: la lista la da el marco —«green, air-dried, or
// dried»—, así que aquí no se inventa nada. La humedad aproximada en cifra es
// un `Measurement` (Tabla 7), no un valor de este enum.
enum BiocharMoistureCondition {
  green
  air_dried
  dried

  @@schema("traceability")
}

// Tabla 6, «Cooling / quenching»: también enumerado por el marco —«water
// quench, sealed cooling, or open cooling»—. La fuente del agua va aparte, en
// texto, porque el marco la pide y no da lista.
enum BiocharCooling {
  water_quench
  sealed_cooling
  open_cooling

  @@schema("traceability")
}

enum PlantingEventType {
  // The 600 Caturra seedlings arriving from Cafelino on 2026-08-08.
  received
  // The same material actually going into the ground — may be the same
  // day as `received` or weeks later (nursery holding period); two
  // distinct facts, not implied by each other.
  planted

  @@schema("traceability")
}

model PlantingEvent {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String            @map("location_id") @db.Uuid
  location   Location          @relation(fields: [locationId], references: [id])
  eventType  PlantingEventType @map("event_type")

  // Free text, not a Species/Cultivar FK — those tables are specified
  // (DOMAIN_MODEL.md §4) but not built, and building a taxonomy system was
  // not asked for by this ticket. "Caturra"/"Catuaí" as typed-enough text
  // is what the product owner actually needs recorded today.
  varietal String?
  quantity Int?
  unit     String? @default("plantones")

  // Where the material came from — the 600 Caturra seedlings came from
  // Cafelino. Nullable: a `planted` event for material already on-site
  // (no new arrival) has no separate source to name.
  sourceOrganizationId String?       @map("source_organization_id") @db.Uuid
  sourceOrganization   Organization? @relation(fields: [sourceOrganizationId], references: [id])

  // P1 §1 — the cohort this event established or added to. Nullable: the one
  // pre-existing row predates cohorts and stays valid with NULL, never
  // backfilled with a guess.
  plantingCohortId String?         @map("planting_cohort_id") @db.Uuid
  plantingCohort   PlantingCohort? @relation(fields: [plantingCohortId], references: [id])

  occurredAt       DateTime @default(now()) @map("occurred_at")
  operatorPersonId String?  @map("operator_person_id") @db.Uuid
  operator         Person?  @relation("PlantingEventOperator", fields: [operatorPersonId], references: [id])
  notes            String?

  // Required, no default (ADR-038 pattern) — a planting recorded the same
  // day is direct_observation; one logged from memory weeks later is not.
  provenanceClass ProvenanceClass @map("provenance_class")
  sourceReference String?         @map("source_reference")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("PlantingEventCreatedBy", fields: [createdBy], references: [id])

  @@index([locationId])
  @@index([sourceOrganizationId])
  @@index([plantingCohortId])
  @@map("planting_event")
  @@schema("traceability")
}

// F1 §3/§5, extending SPECIMEN_AND_MATERIAL_TRACEABILITY.md §2's design.
// `species_id`/`cultivar_id` from that doc's original sketch are dropped
// here — the Species/Cultivar tables they'd reference are themselves
// specified but not built (DOMAIN_MODEL.md §4), and building that taxonomy
// was not asked for by this ticket; `commonName`/`varietalNote` (free
// text) are what's actually needed today, same reasoning as
// PlantingEvent.varietal above.
//
// `specimenType` resolves this ticket's own open question (§5): the
// broca traps are modeled as Specimens per the product owner's direct
// decision, not as equipment, so the table needs a discriminator between
// a tracked plant and a monitoring trap rather than nulling out
// plant-only fields for a trap. A new `specimen:manage`/`specimen:view`
// permission pair gates this table (RBAC catalog) — the same reasoning
// A1 used to give Apiary its own permission instead of folding into
// `lot:manage`: a Specimen is a standing land asset, not a Lot in the
// processing-chain sense.
enum SpecimenType {
  plant
  trap

  @@schema("traceability")
}

enum SpecimenStatus {
  active
  // Maps to both "retirada" (a trap, cycle-eligible) and a permanently
  // removed plant — the history of *why*/whether it cycles back lives in
  // SpecimenObservation (installed/removed/reinstalled), not as extra
  // status values here. "Reinstalada" is simply a return to `active`
  // preceded by a `reinstalled` observation — no third status invented.
  removed
  // Plant-only in practice; a trap is never "dead," just removed.
  dead

  @@schema("traceability")
}

// F1 §3 — both sector mechanisms available on every Specimen, neither
// required: "un Specimen puede tener uno, el otro, los dos, o ninguno."
// `sectorSimple` works from day one with no field prep; `gridRow`/
// `gridPosition` are more precise but need physically-numbered rows —
// the farm evolves from approximate to precise, not the other way around.
enum SpecimenSector {
  alto
  medio
  bajo

  @@schema("traceability")
}

model Specimen {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  locationId   String         @map("location_id") @db.Uuid
  location     Location       @relation(fields: [locationId], references: [id])
  specimenType SpecimenType   @map("specimen_type")
  commonName   String         @map("common_name")
  varietalNote String?        @map("varietal_note")
  plantedDate  DateTime?      @map("planted_date")
  status       SpecimenStatus @default(active)

  // P1 §1 — a tracked individual belongs to a cohort. Nullable: a trap
  // belongs to no cohort at all, and a plant tagged before cohorts existed
  // keeps NULL.
  plantingCohortId String?         @map("planting_cohort_id") @db.Uuid
  plantingCohort   PlantingCohort? @relation(fields: [plantingCohortId], references: [id])

  sectorSimple SpecimenSector? @map("sector_simple")
  gridRow      Int?            @map("grid_row")
  gridPosition Int?            @map("grid_position")
  // "A cierta distancia entre tantos plantones" (§5) — qualitative by the
  // product owner's own wording, not a number with a given unit.
  densityNote  String?         @map("density_note")

  notes String?

  // Colony (A2) already established this exact precedent: an origin/
  // existence fact gets provenanceClass too, not just its observations.
  provenanceClass ProvenanceClass @map("provenance_class")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("SpecimenCreatedBy", fields: [createdBy], references: [id])

  observations SpecimenObservation[]
  assets       Asset[]

  @@index([locationId])
  @@index([plantingCohortId])
  @@map("specimen")
  @@schema("traceability")
}

// F1 §5 — extends SPECIMEN_AND_MATERIAL_TRACEABILITY.md §2's
// SpecimenObservation with trap-specific values rather than a parallel
// "TrapCheck" entity: "una revisión de trampa es una observación fechada
// con un valor — misma forma, distinto sujeto." `installed`/`removed`/
// `reinstalled` back Specimen.status transitions for a trap's real
// activate→retire→reinstall cycle (repela); `trap_check` is the
// capture-count reading itself.
enum SpecimenObservationType {
  bloom_start
  bloom_peak
  bloom_end
  health
  material_harvested
  installed
  removed
  reinstalled
  trap_check
  other

  @@schema("traceability")
}

model SpecimenObservation {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  specimenId       String                  @map("specimen_id") @db.Uuid
  specimen         Specimen                @relation(fields: [specimenId], references: [id], onDelete: Cascade)
  observationType  SpecimenObservationType @map("observation_type")
  observedAt       DateTime                @map("observed_at")
  observerPersonId String?                 @map("observer_person_id") @db.Uuid
  observer         Person?                 @relation("SpecimenObservationObserver", fields: [observerPersonId], references: [id])

  // Only meaningful for observationType = trap_check — the 18 de julio
  // minutes' actual capture-count reading. Nullable and untyped-by-name
  // beyond that: not generalized into a Measurement-style value/unit pair
  // ahead of a second numeric observation type actually needing one.
  captureCount Int? @map("capture_count")

  notes String?

  provenanceClass ProvenanceClass @map("provenance_class")
  dataQuality     DataQuality?    @map("data_quality")

  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  creator   UserAccount? @relation("SpecimenObservationCreatedBy", fields: [createdBy], references: [id])

  fieldEvents FieldEvent[]

  @@index([specimenId])
  @@map("specimen_observation")
  @@schema("traceability")
}

// Location history (execution plan §17) — genuinely simpler than
// FermentationRun/DryingRun: storage doesn't change a Lot's identity, so
// there's no bracketing stage_change LotTransformation pair here, just a
// direct lotId FK. History is preserved by never updating endedAt
// retroactively past the truth: moving a lot's storage location creates a
// *new* StorageAssignment row (with the prior one's endedAt set once, at
// the actual move time) rather than mutating locationId in place. Current
// quantity stays computed from QuantityEvent (§9), never duplicated here.
// Sample extraction from storage is a LotTransformation
// (sample_extraction, T5), not a field on this table.
model StorageAssignment {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId         String       @map("lot_id") @db.Uuid
  lot           Lot          @relation(fields: [lotId], references: [id])
  locationId    String       @map("location_id") @db.Uuid
  location      Location     @relation(fields: [locationId], references: [id])
  containerNote String?      @map("container_note") // "Bag #14" — free text, no Container entity in Phase 1
  startedAt     DateTime     @map("started_at")
  endedAt       DateTime?    @map("ended_at") // null = current assignment
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  creator       UserAccount? @relation("StorageAssignmentCreatedBy", fields: [createdBy], references: [id])

  measurements Measurement[]

  @@index([lotId])
  @@index([locationId])
  @@map("storage_assignment")
  @@schema("traceability")
}

// ---------------------------------------------------------------------------
// Apiary — ticket A1 (docs/implementation/22_APIARY_V1_SCOPING_REPORT.md
// §2-3), a separate vertical from coffee's `traceability` schema, its own
// `apiary` Postgres schema per DATA_ARCHITECTURE.md §1's one-schema-per-
// module convention. Only touches coffee at the RBAC/Location layer
// (Location.locationType gains `apiary_site`, above), never at any
// coffee-specific table.
//
// `Apiary` itself is not a table — it's a Location (`apiary_site`), the
// same relationship a farm has to its plots (§2). `Hive` is the physical,
// addressable structure; `Colony` is the living occupant, genuinely
// distinct even though they're 1:1 most of the time — a colony can die,
// swarm, or be requeened while the hive box persists (§2).
//
// A2 (§1a, §3 REVISED) added Colony's origin fields, plus Inspection and
// ColonyEvent as two separate tables — the §1a correction: a beekeeper who
// only feeds a colony was never inspecting it, so folding feeding/
// treatment/passing-observation into Inspection would corrupt Inspection's
// own evidentiary weight ("a trained person opened the hive and assessed
// it"). Inspection stays formal and structurally protected; ColonyEvent is
// a separate, type-discriminated log for the other three, the same shape
// FermentationIntervention/DryingTurnEvent/QuantityEvent already use
// elsewhere in this schema.
// ---------------------------------------------------------------------------

enum HiveStatus {
  active
  empty
  retired

  @@schema("apiary")
}

// Same project/location dual-carry every other RBAC-checked canonical
// entity uses (Lot, Sample, Story, Product, Experience) — T1's own note
// on Lot.locationId applies identically here: a Farm Operator Assignment
// can be scoped to either a project or a location (execution plan §26),
// and RBAC.md §3's leaf-scope containment rule means a project-scoped
// Assignment could never reach a Hive at all without projectId — real for
// A7's actual plan (a Project like Cerro Azul gains the `apiary` domain
// tag and a Farm Operator Assignment scoped to that Project, not
// necessarily to the apiary_site Location specifically). Not spelled out
// in §2's literal field list; added here for the same reason T1 added
// Lot.locationId beyond its own original sketch.
model Hive {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier  String // e.g. "H-014" — unique within its apiary, not globally
  locationId  String       @map("location_id") @db.Uuid // the Apiary (Location.locationType = apiary_site)
  location    Location     @relation(fields: [locationId], references: [id])
  projectId   String?      @map("project_id") @db.Uuid
  project     Project?     @relation(fields: [projectId], references: [id])
  installedAt DateTime?    @map("installed_at")
  status      HiveStatus   @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   String?      @map("created_by") @db.Uuid
  creator     UserAccount? @relation("HiveCreatedBy", fields: [createdBy], references: [id])

  colonies Colony[]
  assets   Asset[]

  @@unique([locationId, identifier])
  @@index([locationId])
  @@index([projectId])
  @@map("hive")
  @@schema("apiary")
}

enum ColonyStatus {
  active
  dead
  absconded

  @@schema("apiary")
}

// §1's boundary analysis: "Pass, required — a capture-or-lose-it fact,
// same class as T12.6." Flat fact only, not full division mechanics —
// a `split` origin does not carry a parent-Colony FK; full genealogy is
// explicitly deferred to v1.1 (§5), same as queen genealogy.
enum ColonyOriginType {
  purchased
  captured
  split
  other

  @@schema("apiary")
}

// Genuinely distinct from Hive even though 1:1 most of the time (§2).
// `hiveId` is reassignable (a colony can move hives) — no move operation
// exists yet in A1, this is schema-only; append-only history for a move,
// if ever needed, is a later concern (same "not built speculatively"
// discipline as everywhere else in this schema, §13).
model Colony {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hiveId          String           @map("hive_id") @db.Uuid
  hive            Hive             @relation(fields: [hiveId], references: [id])
  status          ColonyStatus     @default(active)
  startedAt       DateTime         @map("started_at")
  // A2 — required, no default: verified zero Colony rows existed in Neon
  // before this migration, so this doesn't retrofit a required column onto
  // live data (unlike ADR-038's own T9.5 retrofit, which had to reckon
  // with existing rows).
  originType      ColonyOriginType @map("origin_type")
  originNote      String?          @map("origin_note") // e.g. supplier name, capture location — free text, no structured Supplier/parent-Colony FK
  // ADR-038 pattern, applied here per 22_APIARY_V1_SCOPING_REPORT.md §1's
  // explicit instruction — no default, the action layer must state a real
  // class.
  provenanceClass ProvenanceClass  @map("provenance_class")
  dataQuality     DataQuality?     @map("data_quality")
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String?          @map("created_by") @db.Uuid
  creator         UserAccount?     @relation("ColonyCreatedBy", fields: [createdBy], references: [id])

  inspections         Inspection[]
  colonyEvents        ColonyEvent[]
  apiaryHarvestEvents ApiaryHarvestEvent[]
  assets              Asset[]

  @@index([hiveId])
  @@map("colony")
  @@schema("apiary")
}

// §1a — formal and structurally protected: no `feeding`/`treatment` value
// exists in any enum on this table, so the DB schema itself makes the
// original collapse-bug impossible, not just discouraged by convention.
// `outcome` is NOT NULL, unconditional — the split into a separate table
// (rather than the collapsed single-table design) is what makes this a
// real DB-level guarantee instead of a service-layer-conditional
// requirement (§1a's own note on this being a genuine improvement, not
// just a consequence of the split).
enum InspectionOutcome {
  nothing_unusual
  issue_observed

  @@schema("apiary")
}

model Inspection {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colonyId         String            @map("colony_id") @db.Uuid
  colony           Colony            @relation(fields: [colonyId], references: [id])
  occurredAt       DateTime          @map("occurred_at")
  operatorPersonId String?           @map("operator_person_id") @db.Uuid
  operator         Person?           @relation("InspectionOperator", fields: [operatorPersonId], references: [id])
  outcome          InspectionOutcome
  broodPatternNote String?           @map("brood_pattern_note")
  queenSighted     Boolean?          @map("queen_sighted")
  storesLevel      String?           @map("stores_level")
  temperamentNote  String?           @map("temperament_note")
  pestDiseaseFlags String?           @map("pest_disease_flags")
  note             String?
  // Fixed to direct_observation at the action layer for every call site —
  // a trained person directly assessed the colony (§1a). Not
  // operator-selectable, same discipline as every other fixed-per-call-site
  // provenanceClass in this codebase (T12.6's own precedent).
  provenanceClass  ProvenanceClass   @map("provenance_class")
  dataQuality      DataQuality?      @map("data_quality")
  // A5/A0 (25_OFFLINE_OPTIONS_ANALYSIS.md §0/§4) — idempotent sync: a
  // client-generated draft id, checked server-side before insert, so a
  // retried "Sync now" pass after a dropped response never writes the
  // same field entry twice. Nullable — only offline-queued submissions
  // carry one; a direct online call (if any existed) would not.
  clientDraftId    String?           @unique @map("client_draft_id")
  // P2 §5 — device capture time. This table already has an offline write path
  // (clientDraftId, A5), so it is the one place where device-vs-server time
  // genuinely diverges today rather than in theory.
  recordedAt DateTime? @map("recorded_at")
  syncedAt   DateTime? @map("synced_at")
  captureDeviceId String? @map("capture_device_id") @db.Uuid

  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by") @db.Uuid
  creator          UserAccount?      @relation("InspectionCreatedBy", fields: [createdBy], references: [id])

  assets Asset[]

  @@index([colonyId])
  @@map("inspection")
  @@schema("apiary")
}

// §1a — feeding/treatment/passing_observation share one type-discriminated
// table because none of the three carries Inspection's evidentiary claim;
// the corruption risk in the original (rejected) design was specific to
// mixing those with Inspection, not a general problem with sharing a
// table. `other` mirrors the same catch-all convention as
// FermentationInterventionType/DryingTurnEventType.
enum ColonyEventType {
  feeding
  treatment
  passing_observation
  other

  @@schema("apiary")
}

model ColonyEvent {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colonyId            String          @map("colony_id") @db.Uuid
  colony              Colony          @relation(fields: [colonyId], references: [id])
  eventType           ColonyEventType @map("event_type")
  occurredAt          DateTime        @map("occurred_at")
  operatorPersonId    String?         @map("operator_person_id") @db.Uuid
  operator            Person?         @relation("ColonyEventOperator", fields: [operatorPersonId], references: [id])
  feedingMaterial     String?         @map("feeding_material") // e.g. "sugar syrup 1:1" — feeding only
  feedingQuantity     Decimal?        @map("feeding_quantity") @db.Decimal(10, 3)
  feedingUnit         String?         @map("feeding_unit")
  treatmentProduct    String?         @map("treatment_product") // e.g. "Apivar" — treatment only
  // Nullable at the DB level (meaningless for the other three event
  // types) but required at the service layer whenever eventType =
  // treatment (§1a) — same shape as MaterialConsumptionEntry.batchLabel's
  // existing requiredness (T12.6), enforced in recordColonyEvent, not here.
  treatmentBatchLabel String?         @map("treatment_batch_label")
  treatmentDose       Decimal?        @map("treatment_dose") @db.Decimal(10, 3)
  treatmentDoseUnit   String?         @map("treatment_dose_unit")
  note                String? // passing_observation's payload; free text on any type
  // Fixed at the action layer, never operator-selectable: feeding/treatment
  // -> original_record (a record of an action taken); passing_observation
  // -> direct_observation (a state fact, witnessed) — §1a's own framing,
  // mapped onto ProvenanceClass values that already exist, no invention
  // needed.
  provenanceClass     ProvenanceClass @map("provenance_class")
  dataQuality         DataQuality?    @map("data_quality")
  // A5/A0 — same idempotent-sync purpose as Inspection.clientDraftId above.
  clientDraftId       String?         @unique @map("client_draft_id")
  // P2 §5 — device capture time. This table already has an offline write path
  // (clientDraftId, A5), so it is the one place where device-vs-server time
  // genuinely diverges today rather than in theory.
  recordedAt DateTime? @map("recorded_at")
  syncedAt   DateTime? @map("synced_at")
  captureDeviceId String? @map("capture_device_id") @db.Uuid

  createdAt           DateTime        @default(now()) @map("created_at")
  createdBy           String?         @map("created_by") @db.Uuid
  creator             UserAccount?    @relation("ColonyEventCreatedBy", fields: [createdBy], references: [id])

  assets Asset[]

  @@index([colonyId])
  @@map("colony_event")
  @@schema("apiary")
}

// A3 (§2, §3) — mirrors HarvestEvent's shape exactly (colonyId in place of
// locationId/organizationId, since colonyId already gives a complete path
// to Hive -> Location/Project — no need to duplicate that here). Produces
// a Lot the same way recordHarvestEvent does: atomically, in the same
// transaction, with a matching QuantityEvent("received") when weight is
// given. This is the "existing Lot machinery" reuse §2 argues for — no
// new Sample/Measurement/QuantityEvent/Asset code, only this one small
// event table plus the LotType addition above.
model ApiaryHarvestEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colonyId          String          @map("colony_id") @db.Uuid
  colony            Colony          @relation(fields: [colonyId], references: [id])
  occurredAt        DateTime        @map("occurred_at")
  extractedWeightKg Decimal?        @map("extracted_weight_kg") @db.Decimal(10, 3)
  framesHarvested   Int?            @map("frames_harvested")
  operatorPersonId  String?         @map("operator_person_id") @db.Uuid
  operator          Person?         @relation("ApiaryHarvestEventOperator", fields: [operatorPersonId], references: [id])
  notes             String?
  resultingLotId    String          @unique @map("resulting_lot_id") @db.Uuid
  resultingLot      Lot             @relation(fields: [resultingLotId], references: [id])
  // ADR-038 pattern — no default, the action layer must state a real class.
  provenanceClass   ProvenanceClass @map("provenance_class")
  sourceReference   String?         @map("source_reference")
  createdAt         DateTime        @default(now()) @map("created_at")
  createdBy         String?         @map("created_by") @db.Uuid
  creator           UserAccount?    @relation("ApiaryHarvestEventCreatedBy", fields: [createdBy], references: [id])

  @@index([colonyId])
  @@map("apiary_harvest_event")
  @@schema("apiary")
}

// =============================================================================
// Research OS — RO1 (docs/implementation/34_RO1_RESEARCH_OS.md). Full schema
// per DOMAIN_MODEL.md §4 / CLAUDE.md §17; UI is built only for the subset
// §5 names — creating/versioning/listing a protocol, executing one against a
// Lot, and viewing results including the sensory link. The rest of the chain
// below (Publication, AnalysisPlan/Run/Result, Deviation/CorrectiveAction,
// Approval, Interpretation -> Conclusion -> ResearchRecommendation) gets
// schema and service functions, deliberately no screens yet — "el esquema
// existe; las pantallas llegan cuando se usen" (§5).
// =============================================================================

model ResearchProgram {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(draft)
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   String?      @map("created_by") @db.Uuid
  creator     UserAccount? @relation("ResearchProgramCreatedBy", fields: [createdBy], references: [id])

  questions          ResearchQuestion[]
  experiments        Experiment[]
  researchActivities ResearchActivity[]

  @@map("research_program")
  @@schema("research")
}

model ResearchQuestion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchProgramId String          @map("research_program_id") @db.Uuid
  researchProgram   ResearchProgram @relation(fields: [researchProgramId], references: [id])
  questionText      String          @map("question_text")
  createdAt         DateTime        @default(now()) @map("created_at")
  createdBy         String?         @map("created_by") @db.Uuid
  creator           UserAccount?    @relation("ResearchQuestionCreatedBy", fields: [createdBy], references: [id])

  hypotheses Hypothesis[]

  @@index([researchProgramId])
  @@map("research_question")
  @@schema("research")
}

model Hypothesis {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchQuestionId String           @map("research_question_id") @db.Uuid
  researchQuestion   ResearchQuestion @relation(fields: [researchQuestionId], references: [id])
  statement          String
  createdAt          DateTime         @default(now()) @map("created_at")
  createdBy          String?          @map("created_by") @db.Uuid
  creator            UserAccount?     @relation("HypothesisCreatedBy", fields: [createdBy], references: [id])

  experiments Experiment[]

  @@index([researchQuestionId])
  @@map("hypothesis")
  @@schema("research")
}

model Experiment {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchProgramId       String          @map("research_program_id") @db.Uuid
  researchProgram         ResearchProgram @relation(fields: [researchProgramId], references: [id])
  hypothesisId            String?         @map("hypothesis_id") @db.Uuid
  hypothesis              Hypothesis?     @relation(fields: [hypothesisId], references: [id])
  // Denormalized, matching Lot/Sample's own precedent — avoids a multi-hop
  // join (Experiment -> Protocol -> ProtocolVersion -> ...) for every RBAC
  // scope check.
  projectId               String?         @map("project_id") @db.Uuid
  project                 Project?        @relation(fields: [projectId], references: [id])
  name                    String
  description             String?
  status                  RecordStatus    @default(draft)
  // §4a — "cada experimento tiene un tratamiento control explícito." Points
  // at the one TreatmentBatch that IS this experiment's baseline; declared,
  // never inferred (declareControlTreatmentBatch, lib/research/programs.ts).
  controlTreatmentBatchId String?         @unique @map("control_treatment_batch_id") @db.Uuid
  controlTreatmentBatch   TreatmentBatch? @relation("ExperimentControlTreatmentBatch", fields: [controlTreatmentBatchId], references: [id])
  // §4f — "linaje entre ensayos... qué ensayo derivó de cuál y por qué."
  // Deliberately separate from the Lot lineage DAG (lot_transformation,
  // §7's PE-80-94 nomenclature) — this is scientific/experimental
  // derivation (a prior trial's findings informed the next design), a
  // different kind of "led to" than a physical lot split.
  derivedFromExperimentId String?         @map("derived_from_experiment_id") @db.Uuid
  derivedFromExperiment   Experiment?     @relation("ExperimentLineage", fields: [derivedFromExperimentId], references: [id])
  derivationNote          String?         @map("derivation_note")
  derivedExperiments      Experiment[]    @relation("ExperimentLineage")
  // §4g — "la tarjeta de referencia lista explícitamente lo que no está
  // medido todavía... eso es el límite declarado de lo que el método puede
  // afirmar hoy." Free text, not a structured checklist — the real list
  // (β-glucosidasa, GC-MS, LC-MS, pH/°Brix comparativo, microbiología
  // cuantitativa, cupping formal) is the product owner's own wording, kept
  // verbatim rather than forced into an invented enum.
  declaredLimitations     String?         @map("declared_limitations")
  createdAt               DateTime        @default(now()) @map("created_at")
  createdBy               String?         @map("created_by") @db.Uuid
  creator                 UserAccount?    @relation("ExperimentCreatedBy", fields: [createdBy], references: [id])

  protocols       Protocol[]
  analysisPlans   AnalysisPlan[]
  publications    Publication[]
  interpretations Interpretation[]

  @@index([researchProgramId])
  @@index([hypothesisId])
  @@index([projectId])
  @@index([derivedFromExperimentId])
  @@map("experiment")
  @@schema("research")
}

// §4 — "la numeración PE-77 a PE-112 codifica algo, pero no está documentado
// qué. No lo adivines." externalIdentifier stores the code verbatim
// ("PE-89") as an opaque, uninterpreted string; identifierConvention is a
// free-text slot for whenever the product owner explains what the number
// encodes — not guessed, not decomposed into structured parts today.
model Protocol {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId         String?      @map("experiment_id") @db.Uuid
  experiment           Experiment?  @relation(fields: [experimentId], references: [id])
  name                 String
  externalIdentifier   String?      @unique @map("external_identifier")
  identifierConvention String?      @map("identifier_convention")
  description          String?
  createdAt            DateTime     @default(now()) @map("created_at")
  createdBy            String?      @map("created_by") @db.Uuid
  creator              UserAccount? @relation("ProtocolCreatedBy", fields: [createdBy], references: [id])

  versions ProtocolVersion[]

  @@index([experimentId])
  @@map("protocol")
  @@schema("research")
}

// Same three-state lifecycle as SensoryProtocolVersionStatus — the fourth
// reuse of the Protocol -> ProtocolVersion pattern §2 points at ("no
// inventes un quinto mecanismo de versionado"), not a new vocabulary.
enum ProtocolVersionStatus {
  draft
  active
  superseded

  @@schema("research")
}

model ProtocolVersion {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolId String                @map("protocol_id") @db.Uuid
  protocol   Protocol              @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  version    Int
  status     ProtocolVersionStatus @default(draft)
  notes      String?
  createdAt  DateTime              @default(now()) @map("created_at")
  createdBy  String?               @map("created_by") @db.Uuid
  creator    UserAccount?          @relation("ProtocolVersionCreatedBy", fields: [createdBy], references: [id])

  supersededByVersionId String?           @map("superseded_by_version_id") @db.Uuid
  supersededBy          ProtocolVersion?  @relation("ProtocolVersionSupersession", fields: [supersededByVersionId], references: [id])
  supersedes            ProtocolVersion[] @relation("ProtocolVersionSupersession")

  variables            ProtocolVariable[]
  requiredMeasurements ProtocolRequiredMeasurement[]
  treatmentBatches     TreatmentBatch[]

  @@unique([protocolId, version])
  @@map("protocol_version")
  @@schema("research")
}

enum ProtocolVariableValueType {
  text
  numeric
  boolean
  catalog
  closed_enum

  @@schema("research")
}

model VariableCatalog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  values               VariableCatalogValue[]
  protocolVariables    ProtocolVariable[]
  requiredMeasurements ProtocolRequiredMeasurement[]

  @@map("variable_catalog")
  @@schema("research")
}

model VariableCatalogValue {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogId              String                 @map("catalog_id") @db.Uuid
  catalog                VariableCatalog        @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  value                  String
  // §3a-bis — "qué significa ese valor y qué lo distingue del vecino."
  // Optional deliberately: requiring it would slow field capture. Same
  // shape as SensoryDescriptor.expectedPerception/technicalCause (R1) —
  // the same standardize-the-language-over-time reasoning applied to
  // process variables instead of tasting descriptors.
  definition             String?                @map("definition")
  // §3a-bis — "nombres alternativos que apuntan al mismo valor canónico."
  // Real case this exists for: honey-by-color and semi-wash-by-percentage
  // may name the same process. Self-referential, one level (an alias
  // points directly at its canonical row, never chains through another
  // alias) — resolveCatalogValue (lib/research/protocols.ts) follows this
  // once. Null means this row IS canonical.
  aliasOfId              String?                @map("alias_of_id") @db.Uuid
  aliasOf                VariableCatalogValue?  @relation("VariableCatalogValueAlias", fields: [aliasOfId], references: [id])
  aliases                VariableCatalogValue[] @relation("VariableCatalogValueAlias")
  displayOrder           Int                    @default(0) @map("display_order")
  impliesUnknownIdentity Boolean                @default(false) @map("implies_unknown_identity")

  values             TreatmentBatchVariableValue[]
  observations       ProcessingStageObservation[]
  plantingCohorts    PlantingCohort[]              @relation("PlantingCohortCultivar")
  fieldEvents        FieldEvent[]                  @relation("FieldEventKind")
  selectionMethodOf  LotTransformation[]           @relation("LotTransformationSelectionMethod")
  rejectionCategoryOf Lot[]                        @relation("LotRejectionCategory")
  washMediumOfStages ProcessingStage[]             @relation("ProcessingStageWashMedium")

  @@unique([catalogId, value])
  @@index([aliasOfId])
  @@map("variable_catalog_value")
  @@schema("research")
}

// §3 — "el modelo tiene que poder responder: mostrame todos los protocolos
// donde la única diferencia fue agua de río versus quebrada." One row per
// controlled factor a ProtocolVersion declares (water source, yeast
// presence, fermentation orientation, bag position, volume...); the actual
// value per execution lives on TreatmentBatchVariableValue below, keyed to
// this row, so both "which variable" and "what value" stay structured and
// queryable rather than living in prose.
model ProtocolVariable {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolVersionId String                    @map("protocol_version_id") @db.Uuid
  protocolVersion   ProtocolVersion           @relation(fields: [protocolVersionId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  valueType         ProtocolVariableValueType @map("value_type")
  unit              String?
  // §3a — only set when valueType = catalog (Recipiente, Levadura/cultivo,
  // Método de inoculación, Grado de proceso).
  catalogId         String?                   @map("catalog_id") @db.Uuid
  catalog           VariableCatalog?          @relation(fields: [catalogId], references: [id])
  // §3a — only set when valueType = closed_enum (Fuente de agua, Posición
  // de masa). Frozen at creation; changing the set means a new
  // ProtocolVersion, not editing this row (§9.2).
  enumValues        String[]                  @map("enum_values")
  // False for a variable that's recorded but not deliberately varied
  // between treatments (e.g. operator name) — true for the isolated factors
  // §1 names (water source, yeast, orientation, bag position, volume).
  isControlled      Boolean                   @default(true) @map("is_controlled")
  displayOrder      Int                       @default(0) @map("display_order")

  values TreatmentBatchVariableValue[]

  @@index([protocolVersionId])
  @@index([catalogId])
  @@map("protocol_variable")
  @@schema("research")
}

// §3's design warning, restated: "un campo opcional es un campo vacío la
// mayoría de las veces" (provenanceClass's own history, T9.5). This is the
// mechanism that fixes it for Research OS — not more optional fields on
// Measurement, but a ProtocolVersion declaring exactly which measurements
// it requires and at which processing stage. When a batch runs under this
// version, the system knows what to measure, and completeProcessingStage
// (lib/research/treatments.ts) refuses to close a stage that's missing one
// (§9 verification scenario 5).
// §3b — a required measurement is either a numeric MeasurementVariable
// reading (variable set, catalogId null — Brix/pH/humedad/peso/densidad,
// recorded as ordinary Measurement rows) or a categorical VariableCatalog
// pick (catalogId set, variable null — "Estudio de cerezas"'s Selección,
// Flotado, Condición visual, Limpieza, Color, Firmeza, Densidad-bracket,
// Tamaño/forma, Defectos, recorded as ProcessingStageObservation rows).
// Exactly one of the two is set — enforced in lib/research/protocols.ts,
// not at the DB level (Prisma has no CHECK-constraint shorthand here).
model ProtocolRequiredMeasurement {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolVersionId String           @map("protocol_version_id") @db.Uuid
  protocolVersion   ProtocolVersion  @relation(fields: [protocolVersionId], references: [id], onDelete: Cascade)
  // MeasurementVariable (lib/traceability/units.ts) reused, not duplicated —
  // Brix/pH/humedad are already canonical variables (brix, ph, moisture).
  variable          String?
  // §3b — set instead of `variable` for a categorical pick.
  catalogId         String?          @map("catalog_id") @db.Uuid
  catalog           VariableCatalog? @relation(fields: [catalogId], references: [id])
  // Free text naming the ProcessingStage moment this applies to
  // ("post-fermentación", "seco", "taza") — ProcessingStage.name is itself
  // free text below, so this matches by string equality, not FK: a required
  // measurement is declared on the protocol version before any batch (and
  // therefore any stage row) exists.
  atProcessingStage String           @map("at_processing_stage")
  displayOrder      Int              @default(0) @map("display_order")

  @@index([protocolVersionId])
  @@index([catalogId])
  @@map("protocol_required_measurement")
  @@schema("research")
}

// A single execution of a ProtocolVersion — one PE run. lotId is the real
// coffee this treatment applies to when one exists (nullable: Research OS
// isn't coffee-only, DOMAIN_MODEL.md §4). projectId is denormalized for the
// same RBAC-resolution reason as Experiment.projectId above.
model TreatmentBatch {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolVersionId String          @map("protocol_version_id") @db.Uuid
  protocolVersion   ProtocolVersion @relation(fields: [protocolVersionId], references: [id])
  lotId             String?         @map("lot_id") @db.Uuid
  lot               Lot?            @relation(fields: [lotId], references: [id])
  projectId         String?         @map("project_id") @db.Uuid
  project           Project?        @relation(fields: [projectId], references: [id])
  batchLabel        String          @map("batch_label")
  operatorPersonId  String?         @map("operator_person_id") @db.Uuid
  operator          Person?         @relation("TreatmentBatchOperator", fields: [operatorPersonId], references: [id])
  startedAt         DateTime        @map("started_at")
  endedAt           DateTime?       @map("ended_at")
  notes             String?
  // ADR-038 — required, no default: a treatment execution is a fact-bearing
  // record, same reasoning as every other evidentiary write in this schema.
  provenanceClass   ProvenanceClass @map("provenance_class")
  sourceReference   String?         @map("source_reference")
  createdAt         DateTime        @default(now()) @map("created_at")
  createdBy         String?         @map("created_by") @db.Uuid
  creator           UserAccount?    @relation("TreatmentBatchCreatedBy", fields: [createdBy], references: [id])

  variableValues       TreatmentBatchVariableValue[]
  processingStages     ProcessingStage[]
  measurements         Measurement[]
  assets               Asset[]
  evidence             Evidence[]
  deviations           Deviation[]
  // §4a — the inverse of Experiment.controlTreatmentBatchId: present when
  // this batch IS the declared control/baseline for some Experiment.
  controlForExperiment Experiment?                   @relation("ExperimentControlTreatmentBatch")

  @@index([protocolVersionId])
  @@index([lotId])
  @@index([projectId])
  @@map("treatment_batch")
  @@schema("research")
}

model TreatmentBatchVariableValue {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treatmentBatchId   String                @map("treatment_batch_id") @db.Uuid
  treatmentBatch     TreatmentBatch        @relation(fields: [treatmentBatchId], references: [id], onDelete: Cascade)
  protocolVariableId String                @map("protocol_variable_id") @db.Uuid
  protocolVariable   ProtocolVariable      @relation(fields: [protocolVariableId], references: [id])
  textValue          String?               @map("text_value")
  numericValue       Decimal?              @map("numeric_value") @db.Decimal(12, 4)
  booleanValue       Boolean?              @map("boolean_value")
  // §3a — set instead of textValue for a catalog-typed variable.
  catalogValueId     String?               @map("catalog_value_id") @db.Uuid
  catalogValue       VariableCatalogValue? @relation(fields: [catalogValueId], references: [id])
  // §3a — "Spontaneous Wild" case: required (validated in
  // lib/research/treatments.ts) when catalogValue.impliesUnknownIdentity is
  // true, otherwise optional.
  dataQuality        DataQuality?          @map("data_quality")

  @@unique([treatmentBatchId, protocolVariableId])
  @@index([catalogValueId])
  @@map("treatment_batch_variable_value")
  @@schema("research")
}

model ProcessingStage {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treatmentBatchId         String                @map("treatment_batch_id") @db.Uuid
  treatmentBatch           TreatmentBatch        @relation(fields: [treatmentBatchId], references: [id])
  // Free text ("post-fermentación", "seco", "taza") — matches
  // ProtocolRequiredMeasurement.atProcessingStage by string equality, same
  // open-vocabulary reasoning as RoastSession.roastLevel.
  name                     String
  sequenceOrder            Int                   @map("sequence_order")
  // §3a — "el cuarto es parte de la variable, no contexto." Which room
  // (typically a drying room) this stage occurred in. Descriptive-context
  // shape matches DryingRun.locationId's own precedent, but load-bearing
  // here: a "nivel de cama" ProtocolVariable value is only interpretable
  // paired with this Location's own dryingRoomBedLevelCount/
  // dryingRoomLightExposure (§9.6) — level 1 in the solar room and level 1
  // in the dark room are different exposures, not the same number.
  locationId               String?               @map("location_id") @db.Uuid
  location                 Location?             @relation(fields: [locationId], references: [id])
  startedAt                DateTime              @map("started_at")
  completedAt              DateTime?             @map("completed_at")
  notes                    String?
  // RO1.2 §1a — the washing medium is its own dimension (agua limpia,
  // mosto propio, mosto de otro lote, ninguno), not a variant of "lavado":
  // water rinses and dilutes, mosto keeps the microbial load and the
  // compounds already developed. `washMediumCatalogValueId` picks which
  // (from the `medio_lavado` VariableCatalog, §3a's mechanism);
  // `washMediumSourceLotId` records which other Lot the mosto came from
  // when it isn't the batch's own (the product owner already does this —
  // PE-106/PE-107, "Doble Mosto Guacho") — closer to inoculating than to
  // rinsing, so which lot matters. Quantity and the medium's own pH/Brix/
  // temperature are ordinary Measurement rows (volumen_medio_lavado/
  // ph_medio/brix_medio/temperatura_medio), not new fields here — same
  // reasoning cereza's Brix/peso already follows.
  washMediumCatalogValueId String?               @map("wash_medium_catalog_value_id") @db.Uuid
  washMediumCatalogValue   VariableCatalogValue? @relation("ProcessingStageWashMedium", fields: [washMediumCatalogValueId], references: [id])
  washMediumSourceLotId    String?               @map("wash_medium_source_lot_id") @db.Uuid
  washMediumSourceLot      Lot?                  @relation("ProcessingStageWashMediumSourceLot", fields: [washMediumSourceLotId], references: [id])
  createdAt                DateTime              @default(now()) @map("created_at")
  createdBy                String?               @map("created_by") @db.Uuid
  creator                  UserAccount?          @relation("ProcessingStageCreatedBy", fields: [createdBy], references: [id])

  measurements        Measurement[]
  observations        ProcessingStageObservation[]
  sensoryObservations ProcessSensoryObservation[]
  assets              Asset[]
  deviations          Deviation[]

  @@index([treatmentBatchId])
  @@index([locationId])
  @@index([washMediumCatalogValueId])
  @@index([washMediumSourceLotId])
  @@map("processing_stage")
  @@schema("research")
}

// §3b — "Estudio de cerezas" controlled-vocabulary attributes (Selección,
// Flotado, Condición visual, Limpieza, Color, Firmeza, Densidad-bracket,
// Tamaño/forma, Defectos de grano). Deliberately NOT
// SensoryDescriptor/SensoryDescriptorResponse (R1) — that pair is
// structurally coupled to Assessment/BlindSample/a judging session, and a
// pre-processing cherry inspection has none of those. Reuses the
// VariableCatalog mechanism §3a already builds instead of standing up a
// third parallel system. Brix/peso-inicial/densidad numeric readings stay
// ordinary Measurement rows (MeasurementVariable already has "brix") — this
// table is only for the genuinely categorical picks.
model ProcessingStageObservation {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processingStageId String               @map("processing_stage_id") @db.Uuid
  processingStage   ProcessingStage      @relation(fields: [processingStageId], references: [id])
  catalogValueId    String               @map("catalog_value_id") @db.Uuid
  catalogValue      VariableCatalogValue @relation(fields: [catalogValueId], references: [id])
  occurredAt        DateTime             @map("occurred_at")
  notes             String?
  // ADR-038 — required, no default.
  provenanceClass   ProvenanceClass      @map("provenance_class")
  sourceReference   String?              @map("source_reference")
  createdAt         DateTime             @default(now()) @map("created_at")
  createdBy         String?              @map("created_by") @db.Uuid
  creator           UserAccount?         @relation("ProcessingStageObservationCreatedBy", fields: [createdBy], references: [id])

  @@index([processingStageId])
  @@index([catalogValueId])
  @@map("processing_stage_observation")
  @@schema("research")
}

// RO1.2 §2b — sensory evaluation of the MEDIUM during processing (mosto,
// cereza, pergamino, grano), distinct from both ProcessingStageObservation
// (physical state — color, firmeza, flotado) and Assessment (finished
// product, weeks later). Its value is operational: it says whether a
// fermentation is on track while there's still time to intervene, which a
// cupping score three weeks later can't. Time series by design — repeated
// readings at different moments (12h, 36h) say different things about the
// same fermentation, not one judgment.
//
// Field vocabulary is deliberately NOT forced to technical terms (§2b-iii):
// a field worker's own language ("huele a guarapo") communicates something
// real in the moment, and often the worker is the one present at 6am, not
// a technician. `freeTextDescriptor` is recorded verbatim; an optional link
// to a structured SensoryDescriptor (R1) is a later mapping made by someone
// with judgment, never automatic — same "let the equivalence emerge from
// use, don't impose a translation" goal RO1.1 already applied to honey
// color.
//
// Inference is deliberately NOT a field on this row. "Huele a éster
// frutal" is a direct observation; "hay levadura no-Saccharomyces activa"
// is an interpretation, and without quantitative microbiology (named as
// not-yet-measured on the product owner's own CryoBloom reference card)
// it's an informed hypothesis, not a fact. Recording it as a same-row text
// field would blur exactly the line ADR-038/Evidence→Interpretation exists
// to hold — so a real inference goes through that existing chain instead:
// create an Evidence row via `evidenceProcessSensoryObservationId`, then an
// EvidenceClaim/Interpretation off of it, provenanceClass "interpretation".
enum ProcessSensoryMedium {
  mosto
  cereza
  pergamino
  grano

  @@schema("research")
}

model ProcessSensoryObservation {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processingStageId      String               @map("processing_stage_id") @db.Uuid
  processingStage        ProcessingStage      @relation(fields: [processingStageId], references: [id])
  observedAt             DateTime             @map("observed_at")
  observerPersonId       String?              @map("observer_person_id") @db.Uuid
  observer               Person?              @relation("ProcessSensoryObservationObserver", fields: [observerPersonId], references: [id])
  medium                 ProcessSensoryMedium
  freeTextDescriptor     String               @map("free_text_descriptor")
  structuredDescriptorId String?              @map("structured_descriptor_id") @db.Uuid
  structuredDescriptor   SensoryDescriptor?   @relation(fields: [structuredDescriptorId], references: [id])
  intensity              String?
  // "La observación que dispara una intervención es distinta de la que
  // solo se anota" — which ones led to action is what later teaches which
  // signals matter.
  triggeredIntervention  Boolean              @default(false) @map("triggered_intervention")
  // ADR-038 — required, no default. Almost always direct_observation for
  // the descriptor fields themselves; the separate inference (if any) gets
  // its own provenanceClass on the Interpretation built off this row.
  provenanceClass        ProvenanceClass      @map("provenance_class")
  sourceReference        String?              @map("source_reference")
  createdAt              DateTime             @default(now()) @map("created_at")
  createdBy              String?              @map("created_by") @db.Uuid
  creator                UserAccount?         @relation("ProcessSensoryObservationCreatedBy", fields: [createdBy], references: [id])

  evidence Evidence[]

  @@index([processingStageId])
  @@index([structuredDescriptorId])
  @@index([observerPersonId])
  @@map("process_sensory_observation")
  @@schema("research")
}

// A piece of evidence supporting an experiment's interpretation — a tasted
// Sample, a photo Asset, a Measurement summary, or free-standing content.
// Sample/Asset/Measurement are reused, not re-modeled (§2): a tasted
// sample's evidentiary weight is the existing Sample row itself.
model Evidence {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treatmentBatchId            String?                    @map("treatment_batch_id") @db.Uuid
  treatmentBatch              TreatmentBatch?            @relation(fields: [treatmentBatchId], references: [id])
  sampleId                    String?                    @map("sample_id") @db.Uuid
  sample                      Sample?                    @relation(fields: [sampleId], references: [id])
  assetId                     String?                    @map("asset_id") @db.Uuid
  asset                       Asset?                     @relation(fields: [assetId], references: [id])
  measurementId               String?                    @map("measurement_id") @db.Uuid
  measurement                 Measurement?               @relation(fields: [measurementId], references: [id])
  // RO1.2 §2b-iii — lets a process-sensory observation's inference (e.g.
  // "hay levadura no-Saccharomyces activa") become a real Interpretation,
  // instead of a same-row text field blurring observation vs. inference.
  processSensoryObservationId String?                    @map("process_sensory_observation_id") @db.Uuid
  processSensoryObservation   ProcessSensoryObservation? @relation(fields: [processSensoryObservationId], references: [id])
  description                 String?
  // ADR-038 — required, no default.
  provenanceClass             ProvenanceClass            @map("provenance_class")
  sourceReference             String?                    @map("source_reference")
  createdAt                   DateTime                   @default(now()) @map("created_at")
  createdBy                   String?                    @map("created_by") @db.Uuid
  creator                     UserAccount?               @relation("EvidenceCreatedBy", fields: [createdBy], references: [id])

  claims EvidenceClaim[]

  @@index([treatmentBatchId])
  @@index([sampleId])
  @@index([assetId])
  @@index([measurementId])
  @@index([processSensoryObservationId])
  @@map("evidence")
  @@schema("research")
}

model EvidenceClaim {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId String       @map("evidence_id") @db.Uuid
  evidence   Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  claimText  String       @map("claim_text")
  createdAt  DateTime     @default(now()) @map("created_at")
  createdBy  String?      @map("created_by") @db.Uuid
  creator    UserAccount? @relation("EvidenceClaimCreatedBy", fields: [createdBy], references: [id])

  interpretations Interpretation[]

  @@index([evidenceId])
  @@map("evidence_claim")
  @@schema("research")
}

model Interpretation {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId       String         @map("experiment_id") @db.Uuid
  experiment         Experiment     @relation(fields: [experimentId], references: [id])
  evidenceClaimId    String?        @map("evidence_claim_id") @db.Uuid
  evidenceClaim      EvidenceClaim? @relation(fields: [evidenceClaimId], references: [id])
  interpretationText String         @map("interpretation_text")
  createdAt          DateTime       @default(now()) @map("created_at")
  createdBy          String?        @map("created_by") @db.Uuid
  creator            UserAccount?   @relation("InterpretationCreatedBy", fields: [createdBy], references: [id])

  conclusions Conclusion[]

  @@index([experimentId])
  @@index([evidenceClaimId])
  @@map("interpretation")
  @@schema("research")
}

model Conclusion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interpretationId String          @map("interpretation_id") @db.Uuid
  interpretation   Interpretation  @relation(fields: [interpretationId], references: [id])
  conclusionText   String          @map("conclusion_text")
  // §4b — "cualquier conclusión comparativa es provenanceClass =
  // 'interpretation', nunca measured_fact." Required, no default (ADR-038
  // pattern); createConclusion (lib/research/evidence.ts) rejects
  // measured_fact whenever isComparative is true — a single, un-replicated
  // TreatmentBatch run can never earn measured-fact certainty about a
  // difference between treatments.
  provenanceClass  ProvenanceClass @map("provenance_class")
  // §4b — true when this conclusion compares two or more treatments (e.g.
  // "el tratamiento puntuó más alto que el control"). False for a
  // conclusion about a single treatment's own result.
  isComparative    Boolean         @default(false) @map("is_comparative")
  createdAt        DateTime        @default(now()) @map("created_at")
  createdBy        String?         @map("created_by") @db.Uuid
  creator          UserAccount?    @relation("ConclusionCreatedBy", fields: [createdBy], references: [id])

  recommendations ResearchRecommendation[]

  @@index([interpretationId])
  @@map("conclusion")
  @@schema("research")
}

// Named ResearchRecommendation, not Recommendation — the AI Layer already
// has a `Recommendation` model (Slice 7, "ai" schema) with an unrelated
// shape (suggestionType/model/confidence/reviewer). Same English word, two
// different concepts (DOMAIN_MODEL.md §4, "hallazgo 18" of the `17_` audit);
// this ticket's own §2 requires resolving the collision before creating the
// second one. Prefixed to match this chain's own ResearchProgram/
// ResearchQuestion naming, not "Research" bolted on awkwardly elsewhere.
model ResearchRecommendation {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conclusionId       String       @map("conclusion_id") @db.Uuid
  conclusion         Conclusion   @relation(fields: [conclusionId], references: [id])
  recommendationText String       @map("recommendation_text")
  createdAt          DateTime     @default(now()) @map("created_at")
  createdBy          String?      @map("created_by") @db.Uuid
  creator            UserAccount? @relation("ResearchRecommendationCreatedBy", fields: [createdBy], references: [id])

  @@index([conclusionId])
  @@map("research_recommendation")
  @@schema("research")
}

model AnalysisPlan {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId String       @map("experiment_id") @db.Uuid
  experiment   Experiment   @relation(fields: [experimentId], references: [id])
  planText     String       @map("plan_text")
  createdAt    DateTime     @default(now()) @map("created_at")
  createdBy    String?      @map("created_by") @db.Uuid
  creator      UserAccount? @relation("AnalysisPlanCreatedBy", fields: [createdBy], references: [id])

  runs AnalysisRun[]

  @@index([experimentId])
  @@map("analysis_plan")
  @@schema("research")
}

enum AnalysisRunStatus {
  pending
  running
  completed
  failed

  @@schema("research")
}

model AnalysisRun {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisPlanId String            @map("analysis_plan_id") @db.Uuid
  analysisPlan   AnalysisPlan      @relation(fields: [analysisPlanId], references: [id])
  status         AnalysisRunStatus @default(pending)
  startedAt      DateTime?         @map("started_at")
  endedAt        DateTime?         @map("ended_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  createdBy      String?           @map("created_by") @db.Uuid
  creator        UserAccount?      @relation("AnalysisRunCreatedBy", fields: [createdBy], references: [id])

  results AnalysisResult[]

  @@index([analysisPlanId])
  @@map("analysis_run")
  @@schema("research")
}

model AnalysisResult {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisRunId String       @map("analysis_run_id") @db.Uuid
  analysisRun   AnalysisRun  @relation(fields: [analysisRunId], references: [id])
  resultSummary String       @map("result_summary")
  resultData    Json?        @map("result_data")
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  creator       UserAccount? @relation("AnalysisResultCreatedBy", fields: [createdBy], references: [id])

  @@index([analysisRunId])
  @@map("analysis_result")
  @@schema("research")
}

enum PublicationStatus {
  draft
  submitted
  published
  retracted

  @@schema("research")
}

model Publication {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId String?           @map("experiment_id") @db.Uuid
  experiment   Experiment?       @relation(fields: [experimentId], references: [id])
  title        String
  status       PublicationStatus @default(draft)
  publishedAt  DateTime?         @map("published_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  createdBy    String?           @map("created_by") @db.Uuid
  creator      UserAccount?      @relation("PublicationCreatedBy", fields: [createdBy], references: [id])

  @@index([experimentId])
  @@map("publication")
  @@schema("research")
}

model Deviation {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treatmentBatchId  String?          @map("treatment_batch_id") @db.Uuid
  treatmentBatch    TreatmentBatch?  @relation(fields: [treatmentBatchId], references: [id])
  processingStageId String?          @map("processing_stage_id") @db.Uuid
  processingStage   ProcessingStage? @relation(fields: [processingStageId], references: [id])
  // P0 (41_P0_MASS_BALANCE.md §4) — a third nullable parent, the same
  // ADR-020 decision 8 pattern every other attachment point here follows.
  // A transformation that does not reconcile within its organization's
  // tolerance raises one of these rather than being rejected: operators
  // estimate weights, and a field tool that refuses real data stops being
  // used. Deliberately reuses Deviation/CorrectiveAction/Approval rather
  // than inventing a parallel "balance exception" concept.
  lotTransformationId String?            @map("lot_transformation_id") @db.Uuid
  lotTransformation   LotTransformation? @relation(fields: [lotTransformationId], references: [id])
  description       String
  occurredAt        DateTime         @map("occurred_at")
  severity          String?
  createdAt         DateTime         @default(now()) @map("created_at")
  createdBy         String?          @map("created_by") @db.Uuid
  creator           UserAccount?     @relation("DeviationCreatedBy", fields: [createdBy], references: [id])

  correctiveActions CorrectiveAction[]

  @@index([treatmentBatchId])
  @@index([processingStageId])
  @@index([lotTransformationId])
  @@map("deviation")
  @@schema("research")
}

model CorrectiveAction {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviationId String       @map("deviation_id") @db.Uuid
  deviation   Deviation    @relation(fields: [deviationId], references: [id])
  actionText  String       @map("action_text")
  takenAt     DateTime?    @map("taken_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   String?      @map("created_by") @db.Uuid
  creator     UserAccount? @relation("CorrectiveActionCreatedBy", fields: [createdBy], references: [id])

  @@index([deviationId])
  @@map("corrective_action")
  @@schema("research")
}

enum ApprovalDecision {
  approved
  rejected

  @@schema("research")
}

// ADR-020 decision 8 would normally call for a specific nullable FK per
// possible target, but Approval's whole purpose is to approve *any*
// research object generically (a ProtocolVersion today, a Publication or
// other object later) — a deliberate, narrow exception here, matching the
// AI Recommendation model's own existing relatedEntityType/relatedEntityId
// precedent (Slice 7, "ai" schema) rather than inventing a new pattern.
model Approval {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType            String           @map("entity_type")
  entityId              String           @map("entity_id") @db.Uuid
  approverUserAccountId String           @map("approver_user_account_id") @db.Uuid
  approver              UserAccount      @relation("ApprovalApprover", fields: [approverUserAccountId], references: [id])
  decision              ApprovalDecision
  decidedAt             DateTime         @map("decided_at")
  notes                 String?
  createdAt             DateTime         @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("approval")
  @@schema("research")
}

enum ResearchComplianceStatus {
  pending_review
  approved
  rejected
  recategorized

  @@schema("research")
}

enum LanguageFlagStatus {
  clear
  flagged
  resolved

  @@schema("research")
}

// RESEARCH_ACTIVITY_CRITERIA.md — the substance test distinguishing real
// research from commercial activity using research language. §6: "que el
// modelo soporte ese gate ... Construilo; no lo apliques." This table plus
// canReviewResearchActivity's independence check (lib/research/
// researchActivity.ts) are that support; nothing in this ticket blocks on
// complianceStatus, and no CryoBloom/gastro-tourism review is executed here
// — that's RESEARCH_ACTIVITY_CRITERIA.md §9's own human review, out of
// scope for RO1.
model ResearchActivity {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  description                String?
  researchProgramId          String?                  @map("research_program_id") @db.Uuid
  researchProgram            ResearchProgram?         @relation(fields: [researchProgramId], references: [id])
  isPaid                     Boolean                  @map("is_paid")
  // The five-part substance test's structured answer — falsifiable
  // question, method, evidence plan, consent language, program/project
  // linkage (RESEARCH_ACTIVITY_CRITERIA.md's own five parts) — kept as Json
  // rather than five more columns since its shape is the criteria doc's own
  // evolving checklist, not a stable relational structure yet.
  researchQuestionStructured Json?                    @map("research_question_structured")
  complianceStatus           ResearchComplianceStatus @default(pending_review) @map("compliance_status")
  publicListingCopy          String?                  @map("public_listing_copy")
  consentFormCopy            String?                  @map("consent_form_copy")
  languageFlagStatus         LanguageFlagStatus?      @map("language_flag_status")
  // The independence rule's data: who proposed it can never be who reviews
  // it. Enforced in code (canReviewResearchActivity), not only by
  // convention — RESEARCH_ACTIVITY_CRITERIA.md §4's "no auto-revisión,"
  // same structural mechanism RBAC.md §7 already uses for blind-judge
  // restrictions.
  proposedByUserAccountId    String?                  @map("proposed_by_user_account_id") @db.Uuid
  proposedBy                 UserAccount?             @relation("ResearchActivityProposedBy", fields: [proposedByUserAccountId], references: [id])
  reviewedByUserAccountId    String?                  @map("reviewed_by_user_account_id") @db.Uuid
  reviewedBy                 UserAccount?             @relation("ResearchActivityReviewedBy", fields: [reviewedByUserAccountId], references: [id])
  reviewedAt                 DateTime?                @map("reviewed_at")
  reviewNotes                String?                  @map("review_notes")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  createdBy                  String?                  @map("created_by") @db.Uuid
  creator                    UserAccount?             @relation("ResearchActivityCreatedBy", fields: [createdBy], references: [id])

  @@index([researchProgramId])
  @@index([proposedByUserAccountId])
  @@map("research_activity")
  @@schema("research")
}
